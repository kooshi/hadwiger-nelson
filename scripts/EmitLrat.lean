import Proofs
import Std.Tactic.BVDecide.LRAT.Parser

/-!
# Certificate rendering — LRAT on disk into Lean source

The last step of the untrusted pipeline. CaDiCaL wrote `.lrat` files; this reads them with **core's
own parser** (`LRAT.loadLRATProof`, the same one `bv_decide` uses) and writes them back out as Lean
`Array IntAction` literals.

Run it from the repository root, after `./tools/solve.sh`:

```
lake env lean scripts/EmitLrat.lean
```

It writes `Proofs/HadwigerNelson/Instances/SpindleLrat.lean` and says so.

## Why the round trip through Lean's parser

The certificates could have been transcribed by a Python script reading the LRAT text directly. They
are not, and the reason is the project's standing rule that nothing outside Lean authors data Lean
will consume: parsing here means the `Array IntAction` written to the file is *by construction* the
one `loadLRATProof` produces, so a disagreement between our reading of the LRAT format and core's is
impossible rather than merely unlikely.

It costs nothing in trust either way — a mis-parsed certificate fails `LRAT.check` and the build goes
red — but it removes a whole class of confusing failure.

## The rendering, and why not `repr`

`Action` derives `Repr`, and its output does re-elaborate. It spells every constructor in full
(`Std.Tactic.BVDecide.LRAT.Action.addRup 43 #[-4] #[41, 8]`), which is ~40 bytes of namespace per
action. The renderer below emits `.addRup 43 #[-4] #[41, 8]` instead, resolved by the expected type
`Array LRAT.IntAction` on the array literal. At spindle scale the difference is cosmetic; at de Grey
scale, where a single cube's certificate can run to hundreds of megabytes, it is the difference
between a file Lean can load and one it cannot.

The match on `Action` is total and unabbreviated: if a future toolchain adds a constructor, this
file goes red rather than silently dropping actions.
-/

open Std.Sat Std.Tactic.BVDecide HadwigerNelson

namespace EmitLrat

/-- Where `tools/solve.sh` left the certificates. -/
def satDir : System.FilePath := "build" / "sat"

/-- The generated module. Committed, because it is part of the proof. -/
def outPath : System.FilePath :=
  "Proofs" / "HadwigerNelson" / "Instances" / "SpindleLrat.lean"

private def renderNats (xs : Array Nat) : String :=
  "#[" ++ ", ".intercalate (xs.toList.map toString) ++ "]"

private def renderInts (xs : Array Int) : String :=
  "#[" ++ ", ".intercalate (xs.toList.map toString) ++ "]"

private def renderRatHints (xs : Array (Nat × Array Nat)) : String :=
  "#[" ++ ", ".intercalate (xs.toList.map fun (i, hs) => s!"({i}, {renderNats hs})") ++ "]"

/-- One LRAT action as Lean source, in dot notation. Total by design — see the module docstring. -/
def renderAction : LRAT.IntAction → String
  | .addEmpty id rup => s!".addEmpty {id} {renderNats rup}"
  | .addRup id c rup => s!".addRup {id} {renderInts c} {renderNats rup}"
  | .addRat id c pivot rup rat =>
      s!".addRat {id} {renderInts c} ({pivot.1}, {pivot.2}) {renderNats rup} {renderRatHints rat}"
  | .del ids => s!".del {renderNats ids}"

/-- A certificate as a Lean `def`, one action per line. -/
def renderCert (name : String) (doc : String) (π : Array LRAT.IntAction) : String :=
  s!"/-- {doc} -/\ndef {name} : Array LRAT.IntAction :=\n  #[" ++
    ",\n    ".intercalate (π.toList.map renderAction) ++ "]\n"

/-- Load one certificate, failing loudly if `tools/solve.sh` has not been run. -/
def load (name : String) : IO (Array LRAT.IntAction) := do
  let path := satDir / (name ++ ".lrat")
  unless ← path.pathExists do
    throw <| IO.userError s!"missing {path} — run ./tools/solve.sh first"
  LRAT.loadLRATProof path

def header : String :=
  "import Std.Tactic.BVDecide.LRAT.Actions\n\n" ++
  "/-!\n" ++
  "# Moser spindle — LRAT certificates (generated)\n\n" ++
  "**Generated by `scripts/EmitLrat.lean`; do not edit.** Regenerate with\n" ++
  "`./tools/solve.sh && lake env lean scripts/EmitLrat.lean`.\n\n" ++
  "These are *untrusted data*. CaDiCaL proposed them; nothing here is believed until\n" ++
  "`Std.Tactic.BVDecide.LRAT.check` re-derives the refutation from the formula in\n" ++
  "`Instances/SpindleBound.lean`. A stale or corrupted certificate makes that check fail and the\n" ++
  "build go red — it cannot make a false theorem true. That is why this file is committed without\n" ++
  "being reviewed by hand.\n\n" ++
  "The cube certificates are indexed by position in `moserSpindleCubes`, which is the list\n" ++
  "`not_colorable_of_cubes` quantifies over. `scripts/Dimacs.lean` and this script both walk that\n" ++
  "one list, so the index means the same thing in all three places.\n" ++
  "-/\n\n" ++
  "namespace HadwigerNelson\n\n" ++
  "open Std.Tactic.BVDecide\n\n"

def emit : IO Unit := do
  let mono ← load "spindle"
  let cubes ← (List.range moserSpindleCubes.length).mapM fun i => load s!"spindle-cube-{i}"
  let parts := #[header,
    renderCert "spindleCert"
      "Route B: the monolithic refutation of `coloringCNF 3 7 moserSpindleEdges`." mono]
  let parts := (cubes.zipIdx.foldl (init := parts) fun acc (π, i) =>
    acc.push <| "\n" ++ renderCert s!"spindleCubeCert{i}"
      s!"Route C, cube {i} of {moserSpindleCubes.length}: refutes the encoding together with the \
         cube `{moserSpindleCubes[i]!}`." π)
  let parts := parts.push <|
    "\n/-- The nine cube certificates in `moserSpindleCubes` order — the argument `badCubes` wants\n\
     when a cube's check fails and you need to know *which*. The proofs cite the individual names\n\
     above, so this list is a diagnostic convenience and nothing depends on it. -/\n\
     def spindleCubeCerts : List (Array LRAT.IntAction) :=\n  [" ++
    ",\n   ".intercalate ((List.range cubes.length).map fun i => s!"spindleCubeCert{i}") ++ "]\n"
  let parts := parts.push "\nend HadwigerNelson\n"
  IO.FS.writeFile outPath (String.join parts.toList)
  IO.println s!"wrote {outPath}"
  IO.println s!"  spindleCert          {mono.size} actions"
  for (π, i) in cubes.zipIdx do
    IO.println s!"  spindleCubeCert{i}      {π.size} actions   {moserSpindleCubes[i]!}"

end EmitLrat

#eval EmitLrat.emit
