_url":"https://zbmath.org/1506511"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["shaebani.saeed"],"name":"Shaebani, Saeed"}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"2016-05-04T17:42:24Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":null,"reviewer_id":null,"name":null,"sign":null},"text":"Summary: A fall \\(k\\)-coloring of a graph \\(G\\) is a proper \\(k\\)-coloring of \\(G\\) such that each vertex of \\(G\\) sees all \\(k\\) colors on its closed neighborhood. We denote \\(\\mathrm{Fall}(G)\\) the set of all positive integers \\(k\\) for which \\(G\\) has a fall \\(k\\)-coloring. In this paper, we study fall colorings of lexicographic product of graphs and categorical product of graphs. Also, we show that for each graph \\(G\\), \\(\\mathrm{Fall}(M(G))=\\emptyset \\) where \\(M(G)\\) is the Mycielskian of the graph \\(G\\). Finally, we prove that for each bipartite graph \\(G\\), \\(\\mathrm{Fall}(G^c)\\subseteq \\{\\chi (G^c)\\}\\) and it is polynomial time to decide whether \\(\\mathrm{Fall}(G^c)=\\{\\chi (G^c)\\}\\) or not.","contribution_type":"summary"}],"id":6577912,"identifier":"1349.05125","keywords":[],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[{"identifier":"0909.2769","type":"arxiv","url":"https://arxiv.org/abs/0909.2769"}],"msc":[{"code":"05C15","scheme":"msc2020","text":"Coloring of graphs and hypergraphs"},{"code":"05C76","scheme":"msc2020","text":"Graph operations (line graphs, products, etc.)"}],"references":[],"source":{"book":[],"pages":"199-212","series":[{"acronym":null,"issn":[{"number":"0381-7032","type":"print"},{"number":"2817-5204","type":"electronic"}],"issue":null,"issue_id":355255,"parallel_title":null,"part":null,"publisher":"Combinatorial Press, Winnipeg, MB","series_id":340,"short_title":"Ars Comb.","title":"Ars Combinatoria","volume":"12