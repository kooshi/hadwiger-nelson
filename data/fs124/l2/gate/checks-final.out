field notation resolution order:
  HadwigerNelson.Plane.IsTriodCut, HadwigerNelson.Plane.IsTriod
@HadwigerNelson.Plane.shadow_open : ∀ {k : ℕ} {U : Set ℂ} {c : ℂ → Fin k},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {W : Set ℂ},
        IsOpen W →
          W ⊆ U →
            ∀ {i : Fin k},
              (∀ᵐ (z : ℂ), z ∈ W → c z = i) →
                IsOpen (U ∩ HadwigerNelson.Plane.unitShadow W) ∧
                  ∀ᵐ (z : ℂ), z ∈ U ∩ HadwigerNelson.Plane.unitShadow W → c z ≠ i
@HadwigerNelson.Plane.piece_type : ∀ {k : ℕ} {U : Set ℂ} {c : ℂ → Fin k},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {P : Set ℂ},
        IsOpen P →
          IsConnected P →
            P ⊆ U →
              ∀ {i : Fin k},
                (∀ᵐ (z : ℂ), z ∈ P → c z = i) →
                  ∀ {x w : ℂ},
                    x ∈ closure P →
                      w ∈ U →
                        ((∃ y ∈ P, Dist.dist y w < (1 : ℝ)) →
                            ∃ η > (0 : ℝ), ∀ᵐ (z : ℂ), z ∈ Metric.ball w η → (1 : ℝ) < Dist.dist z x → c z ≠ i) ∧
                          ((∃ y ∈ P, (1 : ℝ) < Dist.dist y w) →
                            ∃ η > (0 : ℝ), ∀ᵐ (z : ℂ), z ∈ Metric.ball w η → Dist.dist z x < (1 : ℝ) → c z ≠ i)
@HadwigerNelson.Plane.centre_half : ∀ {k : ℕ} {U : Set ℂ} {c : ℂ → Fin k},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {q z : ℂ},
        q ∈ U →
          Dist.dist q z = (1 : ℝ) →
            ∀ {ρ : ℝ},
              (0 : ℝ) < ρ →
                Metric.ball z ρ ⊆ U →
                  ∀ (a : Fin k),
                    ((∀ᵐ (w : ℂ), w ∈ Metric.ball z ρ → Dist.dist w q < (1 : ℝ) → c w = a) →
                        ∃ η > (0 : ℝ), ∀ᵐ (p : ℂ), p ∈ Metric.ball q η → (1 : ℝ) < Dist.dist p z → c p ≠ a) ∧
                      ((∀ᵐ (w : ℂ), w ∈ Metric.ball z ρ → (1 : ℝ) < Dist.dist w q → c w = a) →
                        ∃ η > (0 : ℝ), ∀ᵐ (p : ℂ), p ∈ Metric.ball q η → Dist.dist p z < (1 : ℝ) → c p ≠ a)
@HadwigerNelson.Plane.tight_centre : ∀ {k : ℕ} {U : Set ℂ} {c : ℂ → Fin k},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {q z : ℂ},
        q ∈ U →
          ∀ {a b : Fin k},
            HadwigerNelson.Plane.IsTight U c q z a b →
              ∃ η > (0 : ℝ),
                (∀ᵐ (w : ℂ), w ∈ Metric.ball q η → (1 : ℝ) < Dist.dist w z → c w ≠ a) ∧
                  ∀ᵐ (w : ℂ), w ∈ Metric.ball q η → Dist.dist w z < (1 : ℝ) → c w ≠ b
@HadwigerNelson.Plane.tight_straddle : ∀ {k : ℕ} {U : Set ℂ} {c : ℂ → Fin k},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {q z : ℂ} {a b : Fin k},
        HadwigerNelson.Plane.IsTight U c q z a b →
          ∀ {p : ℂ},
            p ∈ U →
              Dist.dist p z = (1 : ℝ) →
                p ≠ q → p ≠ (2 : ℂ) * z - q → ∃ η > (0 : ℝ), ∀ᵐ (w : ℂ), w ∈ Metric.ball p η → c w ≠ a ∧ c w ≠ b
@HadwigerNelson.Plane.closePair_forced_pieces : ∀ {U : Set ℂ} {c : ℂ → Fin (6 : ℕ)},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {x y w : ℂ} (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            (∃ (i : Fin (3 : ℕ)) (j : Fin (3 : ℕ)),
                HadwigerNelson.Plane.InnerAt (C.left.piece i) w ∧
                  HadwigerNelson.Plane.OuterAt (C.left.piece j) w ∧ C.left.edge i j ⊆ Metric.sphere w (1 : ℝ)) ∨
              ∃ (i : Fin (3 : ℕ)) (j : Fin (3 : ℕ)),
                HadwigerNelson.Plane.InnerAt (C.right.piece i) w ∧
                  HadwigerNelson.Plane.OuterAt (C.right.piece j) w ∧ C.right.edge i j ⊆ Metric.sphere w (1 : ℝ)
@HadwigerNelson.Plane.closePair_lone : ∀ {U : Set ℂ} {c : ℂ → Fin (6 : ℕ)},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {x y w : ℂ} (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            ¬C.right.SeparatesAt w →
              ∃ (σ : Equiv.Perm (Fin (3 : ℕ))),
                C.left.OneOfEach w σ ∧
                  (∃ (τ : HadwigerNelson.Plane.CircleSide),
                      ∃ η > (0 : ℝ),
                        (∀ᵐ (z : ℂ),
                            z ∈ Metric.ball w η →
                              z ∈ τ.region y → Dist.dist z x < (1 : ℝ) → c z = C.left.label (σ (0 : Fin (3 : ℕ)))) ∧
                          ∀ᵐ (z : ℂ),
                            z ∈ Metric.ball w η →
                              z ∈ τ.region y → (1 : ℝ) < Dist.dist z x → c z = C.left.label (σ (1 : Fin (3 : ℕ)))) ∧
                    ∃ w' ∈ Metric.sphere x (1 : ℝ),
                      w' ≠ w ∧
                        ∃ η' > (0 : ℝ),
                          C.left.piece (σ (0 : Fin (3 : ℕ))) ∩ Metric.ball x η' ⊆
                              Metric.closedBall w (1 : ℝ) ∩ Metric.closedBall w' (1 : ℝ) ∧
                            Disjoint (C.left.piece (σ (1 : Fin (3 : ℕ))) ∩ Metric.ball x η')
                                (Metric.ball w (1 : ℝ) ∪ Metric.ball w' (1 : ℝ)) ∧
                              closure (C.left.piece (σ (0 : Fin (3 : ℕ)))) ∩
                                    closure (C.left.piece (σ (1 : Fin (3 : ℕ)))) ∩
                                  Metric.ball x η' =
                                {x}
@HadwigerNelson.Plane.closePair_both_separate : ∀ {U : Set ℂ} {c : ℂ → Fin (6 : ℕ)},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {x y w : ℂ} (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            C.left.IsFull → C.right.IsFull → C.left.SeparatesAt w ∧ C.right.SeparatesAt w
@HadwigerNelson.Plane.closePair_both_saved : ∀ {U : Set ℂ} {c : ℂ → Fin (6 : ℕ)},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {x y w : ℂ} (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            C.left.HasArcEdges → C.right.HasArcEdges → C.left.Saves w ∧ C.right.Saves w
@HadwigerNelson.Plane.closePair_four : ∀ {U : Set ℂ} {c : ℂ → Fin (6 : ℕ)},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {x y w : ℂ} (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            C.left.IsFull →
              C.right.IsFull →
                ∀ {σ τ : Equiv.Perm (Fin (3 : ℕ))},
                  C.left.OneOfEach w σ →
                    C.right.OneOfEach w τ →
                      HadwigerNelson.Plane.presentAt U c w =
                          {C.left.label (σ (0 : Fin (3 : ℕ))), C.left.label (σ (1 : Fin (3 : ℕ))),
                            C.right.label (τ (0 : Fin (3 : ℕ))), C.right.label (τ (1 : Fin (3 : ℕ)))} ∧
                        (HadwigerNelson.Plane.presentAt U c w).ncard = (4 : ℕ)
@HadwigerNelson.Plane.closePair_both_saved_of_isSector : ∀ {U : Set ℂ} {c : ℂ → Fin (6 : ℕ)},
  IsOpen U →
    HadwigerNelson.Plane.IsWeakColouringOn U c →
      ∀ {x y w : ℂ} (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            C.left.IsSector → C.right.IsSector → C.left.Saves w ∧ C.right.Saves w
@HadwigerNelson.Plane.ThreePiece.IsSector.hasArcEdges : ∀ {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ}
  {D : HadwigerNelson.Plane.ThreePiece U c x}, D.IsSector → D.HasArcEdges
@HadwigerNelson.Plane.ThreePiece.IsSector.isFull : ∀ {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ}
  {D : HadwigerNelson.Plane.ThreePiece U c x}, D.IsSector → D.IsFull
@HadwigerNelson.Plane.IsTriodCut.exists_opposite : ∀ {x : ℂ} {r : ℝ} {J : Fin (3 : ℕ) → C(↑unitInterval, ℂ)}
  {P : Fin (3 : ℕ) → Set ℂ},
  HadwigerNelson.Plane.IsTriodCut x r J P →
    ∃ (opp : Equiv.Perm (Fin (3 : ℕ))),
      (∀ (m i : Fin (3 : ℕ)), i ≠ opp m → Set.range ⇑(J m) ⊆ closure (P i)) ∧
        ∀ (m : Fin (3 : ℕ)), closure (P (opp m)) ∩ Set.range ⇑(J m) = {x}
@HadwigerNelson.Plane.IsTriodCut.exists_arc : ∀ {x : ℂ} {r : ℝ} {J : Fin (3 : ℕ) → C(↑unitInterval, ℂ)}
  {P : Fin (3 : ℕ) → Set ℂ},
  HadwigerNelson.Plane.IsTriodCut x r J P →
    ∀ {N : Set ℂ},
      N ∈ 𝓝 x →
        ∀ {i j : Fin (3 : ℕ)},
          i ≠ j →
            ∃ (γ : C(↑unitInterval, ℂ)),
              Function.Injective ⇑γ ∧ γ (0 : ↑unitInterval) = x ∧ Set.range ⇑γ ⊆ closure (P i) ∩ closure (P j) ∩ N
HadwigerNelson.Plane.exists_closePair_not_separatesAt : ∃ (U : Set ℂ) (c : ℂ → Fin (6 : ℕ)) (x : ℂ) (y : ℂ) (w : ℂ) (C :
  HadwigerNelson.Plane.ClosePair U c x y),
  IsOpen U ∧
    HadwigerNelson.Plane.IsWeakColouringOn U c ∧
      w ∈ U ∧ HadwigerNelson.Plane.IsCommonUnitPoint x y w ∧ ¬C.right.SeparatesAt w
HadwigerNelson.Plane.exists_closePair_full : ∃ (U : Set ℂ) (c : ℂ → Fin (6 : ℕ)) (x : ℂ) (y : ℂ) (w : ℂ) (C :
  HadwigerNelson.Plane.ClosePair U c x y),
  IsOpen U ∧
    HadwigerNelson.Plane.IsWeakColouringOn U c ∧
      w ∈ U ∧
        HadwigerNelson.Plane.IsCommonUnitPoint x y w ∧
          C.left.HasArcEdges ∧
            C.right.HasArcEdges ∧
              (∃ (σ : Equiv.Perm (Fin (3 : ℕ))), C.left.OneOfEach w σ) ∧
                ∃ (τ : Equiv.Perm (Fin (3 : ℕ))), C.right.OneOfEach w τ
HadwigerNelson.Plane.exists_closePair_sector : ∃ (U : Set ℂ) (c : ℂ → Fin (6 : ℕ)) (x : ℂ) (y : ℂ) (w : ℂ) (C :
  HadwigerNelson.Plane.ClosePair U c x y),
  IsOpen U ∧
    HadwigerNelson.Plane.IsWeakColouringOn U c ∧
      w ∈ U ∧ HadwigerNelson.Plane.IsCommonUnitPoint x y w ∧ C.left.IsSector ∧ C.right.IsSector
HadwigerNelson.Plane.exists_closePair_seven_not_separatesAt : ∃ (U : Set ℂ) (c : ℂ → Fin (7 : ℕ)) (x : ℂ) (y : ℂ) (w :
  ℂ) (C : HadwigerNelson.Plane.ClosePair U c x y),
  IsOpen U ∧
    HadwigerNelson.Plane.IsWeakColouringOn U c ∧
      w ∈ U ∧ HadwigerNelson.Plane.IsCommonUnitPoint x y w ∧ ¬C.left.SeparatesAt w ∧ ¬C.right.SeparatesAt w
HadwigerNelson.Plane.sectorPoint_isSector : HadwigerNelson.Plane.sectorPoint.IsSector
@HadwigerNelson.Plane.ClosePair.separatesAt_or : ∀ {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x y w : ℂ},
  IsOpen U →
    HadwigerNelson.Plane.AeProperOn U c →
      ∀ (C : HadwigerNelson.Plane.ClosePair U c x y),
        w ∈ U →
          HadwigerNelson.Plane.IsCommonUnitPoint x y w →
            (∀ (ℓ : α), (∃ (i : Fin (3 : ℕ)), C.left.label i = ℓ) ∨ ∃ (j : Fin (3 : ℕ)), C.right.label j = ℓ) →
              C.left.SeparatesAt w ∨ C.right.SeparatesAt w
@HadwigerNelson.Plane.ClosePair.exists_label_eq : ∀ {U : Set ℂ} {x y : ℂ} {c : ℂ → Fin (6 : ℕ)}
  (C : HadwigerNelson.Plane.ClosePair U c x y) (ℓ : Fin (6 : ℕ)),
  (∃ (i : Fin (3 : ℕ)), C.left.label i = ℓ) ∨ ∃ (j : Fin (3 : ℕ)), C.right.label j = ℓ
HadwigerNelson.Plane.isWeakColouringOn_tightModel : HadwigerNelson.Plane.IsWeakColouringOn
  HadwigerNelson.Plane.tightModelDom HadwigerNelson.Plane.tightModel
HadwigerNelson.Plane.isTight_tightModel : HadwigerNelson.Plane.IsTight HadwigerNelson.Plane.tightModelDom
  HadwigerNelson.Plane.tightModel (0 : ℂ) (1 : ℂ) (0 : Fin (3 : ℕ)) (1 : Fin (3 : ℕ))
