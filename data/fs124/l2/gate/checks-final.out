HadwigerNelson.Plane.CircleSide.outside : HadwigerNelson.Plane.CircleSide
def HadwigerNelson.Plane.CircleSide.region : HadwigerNelson.Plane.CircleSide → ℂ → Set ℂ :=
fun (σ : HadwigerNelson.Plane.CircleSide) (w : ℂ) =>
  match σ with
  | HadwigerNelson.Plane.CircleSide.inside => Metric.ball w (1 : ℝ)
  | HadwigerNelson.Plane.CircleSide.outside => (Metric.closedBall w (1 : ℝ))ᶜ
def HadwigerNelson.Plane.InnerAt : Set ℂ → ℂ → Prop :=
fun (P : Set ℂ) (w : ℂ) => P ⊆ Metric.closedBall w (1 : ℝ)
def HadwigerNelson.Plane.OuterAt : Set ℂ → ℂ → Prop :=
fun (P : Set ℂ) (w : ℂ) => Disjoint P (Metric.ball w (1 : ℝ))
def HadwigerNelson.Plane.CrossingAt : Set ℂ → ℂ → Prop :=
fun (P : Set ℂ) (w : ℂ) => ¬HadwigerNelson.Plane.InnerAt P w ∧ ¬HadwigerNelson.Plane.OuterAt P w
