    (dist_lt : Dist.dist x y < (2 : ℝ)) (label_ne : ∀ (i j : Fin (3 : ℕ)), left.label i ≠ right.label j) :
    HadwigerNelson.Plane.ClosePair U c x y
def HadwigerNelson.Plane.IsCommonUnitPoint : ℂ → ℂ → ℂ → Prop :=
fun (x y w : ℂ) => Dist.dist w x = (1 : ℝ) ∧ Dist.dist w y = (1 : ℝ)
def HadwigerNelson.Plane.presentAt.{u_1} : {α : Type u_1} → Set ℂ → (ℂ → α) → ℂ → Set α :=
fun {α : Type u_1} (U : Set ℂ) (c : ℂ → α) (w : ℂ) => {i : α | w ∈ HadwigerNelson.Plane.essSupport (U ∩ c ⁻¹' {i})}
