  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → Fin (3 : ℕ) → Fin (3 : ℕ) → Set ℂ :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) (i j : Fin (3 : ℕ)) =>
  closure (D.piece i) ∩ closure (D.piece j) ∩ D.nbhd
def HadwigerNelson.Plane.ThreePiece.SeparatesAt.{u_1} : {α : Type u_1} →
  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → ℂ → Prop :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) (w : ℂ) =>
  ∃ (i : Fin (3 : ℕ)) (j : Fin (3 : ℕ)),
    HadwigerNelson.Plane.InnerAt (D.piece i) w ∧ HadwigerNelson.Plane.OuterAt (D.piece j) w
def HadwigerNelson.Plane.ThreePiece.OneOfEach.{u_1} : {α : Type u_1} →
  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → ℂ → Equiv.Perm (Fin (3 : ℕ)) → Prop :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) (w : ℂ)
    (σ : Equiv.Perm (Fin (3 : ℕ))) =>
  HadwigerNelson.Plane.InnerAt (D.piece (σ (0 : Fin (3 : ℕ)))) w ∧
    HadwigerNelson.Plane.OuterAt (D.piece (σ (1 : Fin (3 : ℕ)))) w ∧
      HadwigerNelson.Plane.CrossingAt (D.piece (σ (2 : Fin (3 : ℕ)))) w
def HadwigerNelson.Plane.ThreePiece.IsFull.{u_1} : {α : Type u_1} →
  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → Prop :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) =>
  ∀ (i j : Fin (3 : ℕ)), i ≠ j → x ∈ closure (D.edge i j \ {x})
def HadwigerNelson.Plane.HasUnitArcFrom : Set ℂ → ℂ → ℂ → Prop :=
fun (E : Set ℂ) (w x : ℂ) =>
  ∃ (s : ℝ),
    (s = (1 : ℝ) ∨ s = (-1 : ℝ)) ∧
      ∃ δ > (0 : ℝ), ∀ t ∈ Set.Icc (0 : ℝ) δ, w + (x - w) * HadwigerNelson.Plane.e (s * t) ∈ E
def HadwigerNelson.Plane.ThreePiece.Saves.{u_1} : {α : Type u_1} →
  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → ℂ → Prop :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) (w : ℂ) =>
  ∃ (i : Fin (3 : ℕ)) (j : Fin (3 : ℕ)), i ≠ j ∧ HadwigerNelson.Plane.HasUnitArcFrom (D.edge i j) w x
def HadwigerNelson.Plane.ThreePiece.HasArcEdges.{u_1} : {α : Type u_1} →
  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → Prop :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) =>
  ∀ (i j : Fin (3 : ℕ)),
    i ≠ j → ∃ (γ : C(↑unitInterval, ℂ)), Function.Injective ⇑γ ∧ γ (0 : ↑unitInterval) = x ∧ Set.range ⇑γ ⊆ D.edge i j
def HadwigerNelson.Plane.ThreePiece.IsSector.{u_1} : {α : Type u_1} →
  {U : Set ℂ} → {c : ℂ → α} → {x : ℂ} → HadwigerNelson.Plane.ThreePiece U c x → Prop :=
fun {α : Type u_1} {U : Set ℂ} {c : ℂ → α} {x : ℂ} (D : HadwigerNelson.Plane.ThreePiece U c x) =>
  ∃ r > (0 : ℝ),
    ∃ (J : Fin (3 : ℕ) → C(↑unitInterval, ℂ)),
      (∀ (m : Fin (3 : ℕ)), Function.Injective ⇑(J m)) ∧
        (∀ (m : Fin (3 : ℕ)), (J m) (0 : ↑unitInterval) = x) ∧
          (∀ (m : Fin (3 : ℕ)), Dist.dist ((J m) (1 : ↑unitInterval)) x = r) ∧
            (∀ (m : Fin (3 : ℕ)) (t : ↑unitInterval), t ≠ (1 : ↑unitInterval) → Dist.dist ((J m) t) x < r) ∧
              (∀ (m m' : Fin (3 : ℕ)) (s t : ↑unitInterval), m ≠ m' → (J m) s = (J m') t → (J m) s = x) ∧
                (∀ (i : Fin (3 : ℕ)),
                    ∃ z ∈ D.piece i,
                      D.piece i = connectedComponentIn (Metric.ball x r \ ⋃ (m : Fin (3 : ℕ)), Set.range ⇑(J m)) z) ∧
                  ⋃ (i : Fin (3 : ℕ)), D.piece i = Metric.ball x r \ ⋃ (m : Fin (3 : ℕ)), Set.range ⇑(J m)
