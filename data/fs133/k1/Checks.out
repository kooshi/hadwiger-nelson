@inner_map_polarization : ∀ {V : Type u_1} [inst : SeminormedAddCommGroup V] [inst_1 : InnerProductSpace ℂ V]
  (T : V →ₗ[ℂ] V) (x y : V),
  inner ℂ (T y) x =
    (inner ℂ (T (x + y)) (x + y) - inner ℂ (T (x - y)) (x - y) +
          Complex.I * inner ℂ (T (x + Complex.I • y)) (x + Complex.I • y) -
        Complex.I * inner ℂ (T (x - Complex.I • y)) (x - Complex.I • y)) /
      4
