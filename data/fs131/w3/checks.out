      z ∈ ball x ρ₀ →
        z ≠ x →
          ∀ {a : Arc},
            a ∈ F.arcs →
              z ∈ a.carrier →
                ∃ δ > 0, ball z δ ⊆ ball x ρ₀ ∧ ∀ y ∈ ball z δ, ∀ a' ∈ F.arcs, y ∈ a'.carrier → y ∈ Arc.curve x a
