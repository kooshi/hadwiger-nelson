CONCL (∃ X X', F.IsChangePoint p ψ X X') ↔ κ ψ HadwigerNelson.Plane.Side.ccw ≠ κ ψ HadwigerNelson.Plane.Side.cw
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.exists_third_change
SIG HadwigerNelson.Plane.ArcMap.exists_third_change {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} {κ : ℝ → HadwigerNelson.Plane.Side → Fin k} (hF : F.Valid) (hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))) {X X' : Fin k} (hr : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), κ θ s = X ∨ κ θ s = X') {ψ₁ ψ₂ : ℝ} (h₁ : κ ψ₁ HadwigerNelson.Plane.Side.ccw ≠ κ ψ₁ HadwigerNelson.Plane.Side.cw) (h₂ : κ ψ₂ HadwigerNelson.Plane.Side.ccw ≠ κ ψ₂ HadwigerNelson.Plane.Side.cw) (h12 : ψ₁ < ψ₂) (hlt : ψ₂ < ψ₁ + Real.pi / 3) : ∃ ψ₃ ∈ Set.Ioo ψ₁ (ψ₁ + Real.pi / 3), ψ₃ ≠ ψ₂ ∧ κ ψ₃ HadwigerNelson.Plane.Side.ccw ≠ κ ψ₃ HadwigerNelson.Plane.Side.cw
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER implicit data p : ℂ
BINDER implicit data κ : ℝ → HadwigerNelson.Plane.Side → Fin k
BINDER explicit prop hF : F.Valid
BINDER explicit prop hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))
BINDER implicit data X : Fin k
BINDER implicit data X' : Fin k
BINDER explicit prop hr : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), κ θ s = X ∨ κ θ s = X'
BINDER implicit data ψ₁ : ℝ
BINDER implicit data ψ₂ : ℝ
BINDER explicit prop h₁ : κ ψ₁ HadwigerNelson.Plane.Side.ccw ≠ κ ψ₁ HadwigerNelson.Plane.Side.cw
BINDER explicit prop h₂ : κ ψ₂ HadwigerNelson.Plane.Side.ccw ≠ κ ψ₂ HadwigerNelson.Plane.Side.cw
BINDER explicit prop h12 : ψ₁ < ψ₂
BINDER explicit prop hlt : ψ₂ < ψ₁ + Real.pi / 3
CONCL ∃ ψ₃ ∈ Set.Ioo ψ₁ (ψ₁ + Real.pi / 3), ψ₃ ≠ ψ₂ ∧ κ ψ₃ HadwigerNelson.Plane.Side.ccw ≠ κ ψ₃ HadwigerNelson.Plane.Side.cw
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.germCol_change_int
SIG HadwigerNelson.Plane.ArcMap.germCol_change_int {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} {κ : ℝ → HadwigerNelson.Plane.Side → Fin k} (hF : F.Valid) (hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))) {X X' : Fin k} (hr : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), κ θ s = X ∨ κ θ s = X') (θ : ℝ) (n : ℤ) : κ (θ + ↑n * (Real.pi / 3)) HadwigerNelson.Plane.Side.ccw ≠ κ (θ + ↑n * (Real.pi / 3)) HadwigerNelson.Plane.Side.cw ↔ κ θ HadwigerNelson.Plane.Side.ccw ≠ κ θ HadwigerNelson.Plane.Side.cw
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER implicit data p : ℂ
BINDER implicit data κ : ℝ → HadwigerNelson.Plane.Side → Fin k
BINDER explicit prop hF : F.Valid
BINDER explicit prop hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))
BINDER implicit data X : Fin k
BINDER implicit data X' : Fin k
BINDER explicit prop hr : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), κ θ s = X ∨ κ θ s = X'
BINDER explicit data θ : ℝ
BINDER explicit data n : ℤ
CONCL κ (θ + ↑n * (Real.pi / 3)) HadwigerNelson.Plane.Side.ccw ≠ κ (θ + ↑n * (Real.pi / 3)) HadwigerNelson.Plane.Side.cw ↔ κ θ HadwigerNelson.Plane.Side.ccw ≠ κ θ HadwigerNelson.Plane.Side.cw
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.germCol_change_rotate
SIG HadwigerNelson.Plane.ArcMap.germCol_change_rotate {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} {κ : ℝ → HadwigerNelson.Plane.Side → Fin k} (hF : F.Valid) (hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))) {X X' : Fin k} (hr : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), κ θ s = X ∨ κ θ s = X') (θ : ℝ) : κ (θ + Real.pi / 3) HadwigerNelson.Plane.Side.ccw ≠ κ (θ + Real.pi / 3) HadwigerNelson.Plane.Side.cw ↔ κ θ HadwigerNelson.Plane.Side.ccw ≠ κ θ HadwigerNelson.Plane.Side.cw
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER implicit data p : ℂ
BINDER implicit data κ : ℝ → HadwigerNelson.Plane.Side → Fin k
BINDER explicit prop hF : F.Valid
BINDER explicit prop hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))
BINDER implicit data X : Fin k
BINDER implicit data X' : Fin k
BINDER explicit prop hr : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), κ θ s = X ∨ κ θ s = X'
BINDER explicit data θ : ℝ
CONCL κ (θ + Real.pi / 3) HadwigerNelson.Plane.Side.ccw ≠ κ (θ + Real.pi / 3) HadwigerNelson.Plane.Side.cw ↔ κ θ HadwigerNelson.Plane.Side.ccw ≠ κ θ HadwigerNelson.Plane.Side.cw
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.germCol_const
SIG HadwigerNelson.Plane.ArcMap.germCol_const {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} {κ : ℝ → HadwigerNelson.Plane.Side → Fin k} (hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))) {a b : ℝ} (hab : a < b) (hno : ∀ θ ∈ Set.Ioo a b, κ θ HadwigerNelson.Plane.Side.ccw = κ θ HadwigerNelson.Plane.Side.cw) : κ a HadwigerNelson.Plane.Side.ccw = κ b HadwigerNelson.Plane.Side.cw
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER implicit data p : ℂ
BINDER implicit data κ : ℝ → HadwigerNelson.Plane.Side → Fin k
BINDER explicit prop hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))
BINDER implicit data a : ℝ
BINDER implicit data b : ℝ
BINDER explicit prop hab : a < b
BINDER explicit prop hno : ∀ θ ∈ Set.Ioo a b, κ θ HadwigerNelson.Plane.Side.ccw = κ θ HadwigerNelson.Plane.Side.cw
CONCL κ a HadwigerNelson.Plane.Side.ccw = κ b HadwigerNelson.Plane.Side.cw
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.germCol_eq
SIG HadwigerNelson.Plane.ArcMap.germCol_eq {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} {κ : ℝ → HadwigerNelson.Plane.Side → Fin k} (hκ : ∀ (θ : ℝ) (s : HadwigerNelson.Plane.Side), HadwigerNelson.Plane.GermIn p θ s (F.region (κ θ s))) {θ : ℝ} {s : HadwigerNelson.Plane.Side} {c : Fin k} (h : HadwigerNelson.Plane.GermIn p θ s (F.region c)) : κ θ s = c
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER implicit data p : ℂ
BINDER implicit data κ : ℝ → HadwigerNelson.Plane.Side → Fin k
