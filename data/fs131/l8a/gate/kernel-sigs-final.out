@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.OuterAdj HadwigerNelson.Plane.ArcMap.Valid.dist_le_one_of_near_germ_closure
SIG HadwigerNelson.Plane.ArcMap.Valid.dist_le_one_of_near_germ_closure {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} (hF : F.Valid) {p : ℂ} {φ : ℝ} {s : HadwigerNelson.Plane.Side} {c : Fin k} (hg : HadwigerNelson.Plane.GermIn p φ s (closure (F.region c))) {y : ℂ} (hnear : ∃ δ₀ > 0, ∀ t ∈ Set.Ioo 0 δ₀, dist y (HadwigerNelson.Plane.ringPt p (φ + s.sign * t)) < 1) : ∃ ε > 0, ∀ z ∈ closure (F.region c), dist z y < ε → dist z (HadwigerNelson.Plane.ringPt p φ) ≤ 1
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER explicit prop hF : F.Valid
BINDER implicit data p : ℂ
BINDER implicit data φ : ℝ
BINDER implicit data s : HadwigerNelson.Plane.Side
BINDER implicit data c : Fin k
BINDER explicit prop hg : HadwigerNelson.Plane.GermIn p φ s (closure (F.region c))
BINDER implicit data y : ℂ
BINDER explicit prop hnear : ∃ δ₀ > 0, ∀ t ∈ Set.Ioo 0 δ₀, dist y (HadwigerNelson.Plane.ringPt p (φ + s.sign * t)) < 1
CONCL ∃ ε > 0, ∀ z ∈ closure (F.region c), dist z y < ε → dist z (HadwigerNelson.Plane.ringPt p φ) ≤ 1
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.OuterAdj HadwigerNelson.Plane.ArcMap.exists_ball_subset_closure_of_sole_outer
SIG HadwigerNelson.Plane.ArcMap.exists_ball_subset_closure_of_sole_outer {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} (hF : F.Valid) {p y y' v : ℂ} (hyd : y ∈ F.dom) {c X X' : Fin k} (hcompl : (F.coloursAt p)ᶜ = {X, X'}) (hO : F.outerTileColours p y = {c}) (hX : ∃ ε > 0, ∀ z ∈ closure (F.region X), dist z y < ε → dist z y' ≤ 1) (hX' : ∃ ε > 0, ∀ z ∈ closure (F.region X'), dist z y < ε → dist z v ≤ 1) : ∃ ρ > 0, Metric.ball y ρ ⊆ F.dom ∧ ((Metric.ball y ρ \ Metric.closedBall p 1) \ Metric.closedBall v 1) \ Metric.closedBall y' 1 ⊆ closure (F.region c)
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER explicit prop hF : F.Valid
BINDER implicit data p : ℂ
BINDER implicit data y : ℂ
BINDER implicit data y' : ℂ
BINDER implicit data v : ℂ
BINDER explicit prop hyd : y ∈ F.dom
BINDER implicit data c : Fin k
BINDER implicit data X : Fin k
BINDER implicit data X' : Fin k
BINDER explicit prop hcompl : (F.coloursAt p)ᶜ = {X, X'}
BINDER explicit prop hO : F.outerTileColours p y = {c}
BINDER explicit prop hX : ∃ ε > 0, ∀ z ∈ closure (F.region X), dist z y < ε → dist z y' ≤ 1
BINDER explicit prop hX' : ∃ ε > 0, ∀ z ∈ closure (F.region X'), dist z y < ε → dist z v ≤ 1
CONCL ∃ ρ > 0, Metric.ball y ρ ⊆ F.dom ∧ ((Metric.ball y ρ \ Metric.closedBall p 1) \ Metric.closedBall v 1) \ Metric.closedBall y' 1 ⊆ closure (F.region c)
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.OuterAdj HadwigerNelson.Plane.ArcMap.not_germOnQ_of_germIn_region
SIG HadwigerNelson.Plane.ArcMap.not_germOnQ_of_germIn_region {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} {θ : ℝ} {s : HadwigerNelson.Plane.Side} {c : Fin k} (h : HadwigerNelson.Plane.GermIn p θ s (F.region c)) : ¬F.GermOnQ p θ s
BINDER implicit data k : ℕ
