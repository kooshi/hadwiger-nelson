CONCL ∃ r₀ G, F.IsSectorChart G x r₀ ∧ (∀ (i j : Fin n), i ≠ j → ∀ s ∈ Set.Ioo 0 r₀, HadwigerNelson.Plane.e (G.dir i s) ≠ HadwigerNelson.Plane.e (G.dir j s)) ∧ ∃ τ, Function.Injective τ ∧ (∀ (T : Set ℂ), F.TileAt x T ↔ ∃ i, τ i = T) ∧ (∀ (i : Fin n), τ i ∩ Metric.ball x r₀ = G.sector x r₀ i) ∧ ∀ (i : Fin n), HadwigerNelson.Plane.coneAt (τ i) x = HadwigerNelson.Plane.angleIcc (G.β i) (G.nextβ i)
