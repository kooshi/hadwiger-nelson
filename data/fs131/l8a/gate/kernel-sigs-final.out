CONCL ∃ α ∈ F.arcs, ∃ B, α.InitialPiece x (G.β j) B ∧ B ⊆ insert x (HadwigerNelson.Plane.branchPt x (G.β j) (G.κ j) '' Set.Ioo 0 r₀)
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.StarChart HadwigerNelson.Plane.ArcMap.IsSectorChart.tileAt_equiv
SIG HadwigerNelson.Plane.ArcMap.IsSectorChart.tileAt_equiv {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {n : ℕ} {G : HadwigerNelson.Plane.BranchGerms n} {x : ℂ} {r₀ : ℝ} (hC : F.IsSectorChart G x r₀) (hn : 0 < n) (hS : F.SimpleOn {x}) : ∃ τ, Function.Injective τ ∧ (∀ (T : Set ℂ), F.TileAt x T ↔ ∃ i, τ i = T) ∧ (∀ (i : Fin n), τ i ∩ Metric.ball x r₀ = G.sector x r₀ i) ∧ ∀ (i : Fin n), HadwigerNelson.Plane.coneAt (τ i) x = HadwigerNelson.Plane.angleIcc (G.β i) (G.nextβ i)
