CONCL ¬F.GermOnQ p θ s
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.OuterAdj HadwigerNelson.Plane.ArcMap.not_sole_outer_of_adjacent_changePoints
SIG HadwigerNelson.Plane.ArcMap.not_sole_outer_of_adjacent_changePoints {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} (hF : F.Valid) (hN : F.NonSiamese) {p : ℂ} (hp : F.Covers p 1) (h4 : 4 ≤ (F.coloursAt p).ncard) (hk : k ≤ (F.coloursAt p).ncard + 2) {ψ : ℝ} {X X' Y Y' : Fin k} (hy : F.IsChangePoint p ψ X X') (hy' : F.IsChangePoint p (ψ + Real.pi / 3) Y Y') (hv : ¬F.GermOnQ p (ψ - Real.pi / 3) HadwigerNelson.Plane.Side.ccw) (hu : ¬F.GermOnQ p (ψ + 2 * Real.pi / 3) HadwigerNelson.Plane.Side.cw) (c : Fin k) : ¬(F.outerTileColours p (HadwigerNelson.Plane.ringPt p ψ) = {c} ∧ F.outerTileColours p (HadwigerNelson.Plane.ringPt p (ψ + Real.pi / 3)) = {c})
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER explicit prop hF : F.Valid
BINDER explicit prop hN : F.NonSiamese
BINDER implicit data p : ℂ
BINDER explicit prop hp : F.Covers p 1
BINDER explicit prop h4 : 4 ≤ (F.coloursAt p).ncard
BINDER explicit prop hk : k ≤ (F.coloursAt p).ncard + 2
BINDER implicit data ψ : ℝ
BINDER implicit data X : Fin k
BINDER implicit data X' : Fin k
BINDER implicit data Y : Fin k
BINDER implicit data Y' : Fin k
BINDER explicit prop hy : F.IsChangePoint p ψ X X'
BINDER explicit prop hy' : F.IsChangePoint p (ψ + Real.pi / 3) Y Y'
BINDER explicit prop hv : ¬F.GermOnQ p (ψ - Real.pi / 3) HadwigerNelson.Plane.Side.ccw
BINDER explicit prop hu : ¬F.GermOnQ p (ψ + 2 * Real.pi / 3) HadwigerNelson.Plane.Side.cw
BINDER explicit data c : Fin k
CONCL ¬(F.outerTileColours p (HadwigerNelson.Plane.ringPt p ψ) = {c} ∧ F.outerTileColours p (HadwigerNelson.Plane.ringPt p (ψ + Real.pi / 3)) = {c})
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.OuterAdj HadwigerNelson.Plane.norm_e_add_e_sub_e_sq
SIG HadwigerNelson.Plane.norm_e_add_e_sub_e_sq (a b c : ℝ) : ‖HadwigerNelson.Plane.e a + HadwigerNelson.Plane.e b - HadwigerNelson.Plane.e c‖ ^ 2 = 3 + 2 * Real.cos (a - b) - 2 * Real.cos (a - c) - 2 * Real.cos (b - c)
BINDER explicit data a : ℝ
BINDER explicit data b : ℝ
BINDER explicit data c : ℝ
CONCL ‖HadwigerNelson.Plane.e a + HadwigerNelson.Plane.e b - HadwigerNelson.Plane.e c‖ ^ 2 = 3 + 2 * Real.cos (a - b) - 2 * Real.cos (a - c) - 2 * Real.cos (b - c)
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.OuterAdj HadwigerNelson.Plane.one_lt_norm_e_add_e_sub_e
SIG HadwigerNelson.Plane.one_lt_norm_e_add_e_sub_e {a b c t : ℝ} (ht0 : 0 < t) (htπ : t < Real.pi) (hab : Real.cos (a - b) = Real.cos (2 * Real.pi / 3 - t)) (hac : Real.cos (a - c) = Real.cos (2 * Real.pi / 3)) (hbc : Real.cos (b - c) = Real.cos t) : 1 < ‖HadwigerNelson.Plane.e a + HadwigerNelson.Plane.e b - HadwigerNelson.Plane.e c‖
BINDER implicit data a : ℝ
BINDER implicit data b : ℝ
BINDER implicit data c : ℝ
BINDER implicit data t : ℝ
BINDER explicit prop ht0 : 0 < t
BINDER explicit prop htπ : t < Real.pi
BINDER explicit prop hab : Real.cos (a - b) = Real.cos (2 * Real.pi / 3 - t)
BINDER explicit prop hac : Real.cos (a - c) = Real.cos (2 * Real.pi / 3)
BINDER explicit prop hbc : Real.cos (b - c) = Real.cos t
CONCL 1 < ‖HadwigerNelson.Plane.e a + HadwigerNelson.Plane.e b - HadwigerNelson.Plane.e c‖
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.GammaFreeRing.exists_absent_pair
SIG HadwigerNelson.Plane.ArcMap.GammaFreeRing.exists_absent_pair {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} (hΓ : F.GammaFreeRing p) (hF : F.Valid) (hp : F.Covers p 1) (h4 : 4 ≤ (F.coloursAt p).ncard) (hk : k ≤ (F.coloursAt p).ncard + 2) : ∃ X X', X ≠ X' ∧ (F.coloursAt p)ᶜ = {X, X'}
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER implicit data p : ℂ
BINDER explicit prop hΓ : F.GammaFreeRing p
BINDER explicit prop hF : F.Valid
BINDER explicit prop hp : F.Covers p 1
BINDER explicit prop h4 : 4 ≤ (F.coloursAt p).ncard
BINDER explicit prop hk : k ≤ (F.coloursAt p).ncard + 2
CONCL ∃ X X', X ≠ X' ∧ (F.coloursAt p)ᶜ = {X, X'}
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.RingColour HadwigerNelson.Plane.ArcMap.GammaFreeRing.exists_germIn
SIG HadwigerNelson.Plane.ArcMap.GammaFreeRing.exists_germIn {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} {p : ℂ} (hΓ : F.GammaFreeRing p) (hp : F.Covers p 1) (θ : ℝ) (s : HadwigerNelson.Plane.Side) : ∃ c, HadwigerNelson.Plane.GermIn p θ s (F.region c)
