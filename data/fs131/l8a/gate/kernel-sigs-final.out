SIG HadwigerNelson.Plane.ArcMap.ringArc_star {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} (hF : F.Valid) (hN : F.NonSiamese) {p : ℂ} (hpd : p ∈ F.dom) (hS : F.SimpleOn {p}) (h4 : (F.coloursAt p).ncard = 4) {u v : ℝ} {c c' : Fin k} (hA : F.IsRingArc p u v c c') (hc : c ∈ F.coloursAt p) (hc' : c' ∈ F.coloursAt p) : ∃ t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄, F.IsStar4 p t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄ ∧ F.TileOf c t₁ ∧ F.TileOf c' t₃ ∧ v - Real.pi / 2 ≤ e₁ ∧ e₂ ≤ u + Real.pi / 2 ∧ v + Real.pi / 2 ≤ e₃ ∧ e₄ ≤ u + 3 * Real.pi / 2
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER explicit prop hF : F.Valid
BINDER explicit prop hN : F.NonSiamese
BINDER implicit data p : ℂ
BINDER explicit prop hpd : p ∈ F.dom
BINDER explicit prop hS : F.SimpleOn {p}
BINDER explicit prop h4 : (F.coloursAt p).ncard = 4
BINDER implicit data u : ℝ
BINDER implicit data v : ℝ
BINDER implicit data c : Fin k
BINDER implicit data c' : Fin k
BINDER explicit prop hA : F.IsRingArc p u v c c'
BINDER explicit prop hc : c ∈ F.coloursAt p
BINDER explicit prop hc' : c' ∈ F.coloursAt p
CONCL ∃ t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄, F.IsStar4 p t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄ ∧ F.TileOf c t₁ ∧ F.TileOf c' t₃ ∧ v - Real.pi / 2 ≤ e₁ ∧ e₂ ≤ u + Real.pi / 2 ∧ v + Real.pi / 2 ≤ e₃ ∧ e₄ ≤ u + 3 * Real.pi / 2
