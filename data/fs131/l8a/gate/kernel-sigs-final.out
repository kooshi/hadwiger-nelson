CONCL (HadwigerNelson.Plane.V6Count.shapes.all fun s0 => HadwigerNelson.Plane.V6Count.shapes.all fun s1 => HadwigerNelson.Plane.V6Count.shapes.all fun s2 => HadwigerNelson.Plane.V6Count.shapes.all fun s3 => HadwigerNelson.Plane.V6Count.stmtB (HadwigerNelson.Plane.V6Count.rel s0 s1 s2 s3)) = true
@@ THM Proofs.HadwigerNelson.Plane.RingCalculus.HubCount HadwigerNelson.Plane.V6Count.twoDoubles
SIG HadwigerNelson.Plane.V6Count.twoDoubles (tip : Fin 4 → ZMod 6 → Prop) (hcons : ∀ (i : Fin 4) (a b : ZMod 6), tip i a → tip i b → b = a ∨ b = a + 1 ∨ b = a - 1) : HadwigerNelson.Plane.V6Count.TwoDoubles tip
BINDER explicit data tip : Fin 4 → ZMod 6 → Prop
BINDER explicit prop hcons : ∀ (i : Fin 4) (a b : ZMod 6), tip i a → tip i b → b = a ∨ b = a + 1 ∨ b = a - 1
