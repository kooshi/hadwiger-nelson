SIG HadwigerNelson.Plane.ArcMap.transferQC {k : ℕ} {F : HadwigerNelson.Plane.ArcMap k} (hF : F.Valid) (hN : F.NonSiamese) {p : ℂ} (hp : F.Covers p 1) {ψ : ℝ} (hS : F.SimpleOn {p, HadwigerNelson.Plane.ringPt p ψ, HadwigerNelson.Plane.ringPt p (ψ + Real.pi / 3), HadwigerNelson.Plane.ringPt p (ψ - Real.pi / 3)}) (h4 : (F.coloursAt p).ncard = 4) (hk : k ≤ (F.coloursAt p).ncard + 2) {kind : HadwigerNelson.Plane.ArcMap.SemiKind} (hy : F.IsSemiHub p ψ kind) : 4 ≤ (F.coloursAt (HadwigerNelson.Plane.ringPt p ψ)).ncard ∨ 4 ≤ (F.coloursAt (HadwigerNelson.Plane.ringPt p (ψ + Real.pi / 3))).ncard ∨ 4 ≤ (F.coloursAt (HadwigerNelson.Plane.ringPt p (ψ - Real.pi / 3))).ncard ∨ (F.coloursAt (HadwigerNelson.Plane.ringPt p ψ)).ncard = 3 ∧ F.IsFullSemiHub p ψ kind ∧ ∃ a a', F.GermOnQWith p (ψ + Real.pi / 3) kind.qSide a a' ∧ F.GermOnQWith p (ψ - Real.pi / 3) kind.qSide.flip a' a
BINDER implicit data k : ℕ
BINDER implicit data F : HadwigerNelson.Plane.ArcMap k
BINDER explicit prop hF : F.Valid
BINDER explicit prop hN : F.NonSiamese
BINDER implicit data p : ℂ
BINDER explicit prop hp : F.Covers p 1
BINDER implicit data ψ : ℝ
BINDER explicit prop hS : F.SimpleOn {p, HadwigerNelson.Plane.ringPt p ψ, HadwigerNelson.Plane.ringPt p (ψ + Real.pi / 3), HadwigerNelson.Plane.ringPt p (ψ - Real.pi / 3)}
BINDER explicit prop h4 : (F.coloursAt p).ncard = 4
BINDER explicit prop hk : k ≤ (F.coloursAt p).ncard + 2
BINDER implicit data kind : HadwigerNelson.Plane.ArcMap.SemiKind
BINDER explicit prop hy : F.IsSemiHub p ψ kind
CONCL 4 ≤ (F.coloursAt (HadwigerNelson.Plane.ringPt p ψ)).ncard ∨ 4 ≤ (F.coloursAt (HadwigerNelson.Plane.ringPt p (ψ + Real.pi / 3))).ncard ∨ 4 ≤ (F.coloursAt (HadwigerNelson.Plane.ringPt p (ψ - Real.pi / 3))).ncard ∨ (F.coloursAt (HadwigerNelson.Plane.ringPt p ψ)).ncard = 3 ∧ F.IsFullSemiHub p ψ kind ∧ ∃ a a', F.GermOnQWith p (ψ + Real.pi / 3) kind.qSide a a' ∧ F.GermOnQWith p (ψ - Real.pi / 3) kind.qSide.flip a' a
