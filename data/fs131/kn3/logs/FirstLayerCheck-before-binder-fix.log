@positive_entropy_rigidity : ∀ {X : Type u_1} [inst : AddCommGroup X] [inst_1 : TopologicalSpace X]
  [inst_2 : MeasurableSpace X],
  IsSolenoid X →
    ∀ {d : ℕ},
      2 ≤ d →
        ∀ (α : ZdAction d X),
          α.NoVirtuallyCyclicFactors →
            ∀ (μ : MeasureTheory.Measure X),
              MeasureTheory.IsProbabilityMeasure μ →
                α.IsErgodicOn ⊤ μ →
                  ∃ Λ J ν G,
                    Λ.FiniteIndex ∧
                      0 < J ∧
                        μ = (↑J)⁻¹ • ∑ j, ν j ∧
                          (∀ (i j : Fin J), i ≠ j → (ν i).MutuallySingular (ν j)) ∧
                            ∀ (j : Fin J),
                              MeasureTheory.IsProbabilityMeasure (ν j) ∧
                                α.IsErgodicOn Λ (ν j) ∧
                                  (IsClosed ↑(G j) ∧
                                      α.InvariantOn Λ (G j) ∧
                                        ∀ g ∈ G j,
                                          ∀ (B : Set X), MeasurableSet B → (ν j) ((fun x => x + g) ⁻¹' B) = (ν j) B) ∧
                                    (∀ (n : Fin d → ℤ),
                                        ∃ k,
                                          MeasureTheory.Measure.map (⇑(α.toFun n)) (ν j) = ν k ∧
                                            AddSubgroup.map (α.toFun n) (G j) = G k) ∧
                                      ∀ n ∈ Λ,
                                        ∀ (h : G j ≤ AddSubgroup.comap (α.toFun n) (G j)),
                                          ksEntropy (MeasureTheory.Measure.map (⇑(QuotientAddGroup.mk' (G j))) (ν j))
                                              ⇑(QuotientAddGroup.map (G j) (G j) (α.toFun n) h) =
                                            0
@haar_or_zero_entropy : ∀ {X : Type u_1} [inst : AddCommGroup X] [inst_1 : TopologicalSpace X]
  [inst_2 : MeasurableSpace X] [BorelSpace X],
  IsSolenoid X →
    ∀ {d : ℕ} (α : ZdAction d X),
      α.IsTotallyIrreducible →
        ¬α.IsVirtuallyCyclic →
          ∀ (μ : MeasureTheory.Measure X),
            MeasureTheory.IsProbabilityMeasure μ →
              α.IsErgodicOn ⊤ μ → μ.IsAddHaarMeasure ∨ ∀ (n : Fin d → ℤ), ksEntropy μ ⇑(α.toFun n) = 0
