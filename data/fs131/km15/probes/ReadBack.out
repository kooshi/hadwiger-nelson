def HadwigerNelson.SpectralChain.levelTarget : {F : Subfield ℝ} →
  (P : StablePrime F) → (m : ℕ) → SimpleGraph (𝓞 ↥(fieldI F) ⧸ P.P ^ m) :=
fun {F} P m => SimpleGraph.fromRel fun x y => (x - y) * (Ideal.quotientMap (P.P ^ m) (conjO F) ⋯) (x - y) = 1
