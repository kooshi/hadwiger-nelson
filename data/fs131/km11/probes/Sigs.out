APlus theorem HadwigerNelson.Rigidity.integral_condLaw_mul_eq_zero_of_adj :
  ∀ {F : Subfield ℝ} [inst : NumberField ↥F] (μ : HadwigerNelson.SpectralChain.InvariantColouring F),
  HadwigerNelson.Rigidity.EqualAtUnits μ →
    ∀ {x y : ↥(HadwigerNelson.SpectralChain.unitRing F)},
      ↑y - ↑x ∈ HadwigerNelson.SpectralChain.unitVectors F →
        ∀ (j : Fin 4),
          ∫ (c : ↥(HadwigerNelson.SpectralChain.unitRing F) → Fin 4),
              HadwigerNelson.SpectralInputs.condLaw (HadwigerNelson.Rigidity.colourFactor μ) μ.μ (fun c => c) x j c *
                HadwigerNelson.SpectralInputs.condLaw (HadwigerNelson.Rigidity.colourFactor μ) μ.μ (fun c => c) y j
                  c ∂μ.μ =
            0
