def HadwigerNelson.Rigidity.EntropySplit : Subfield ℝ → Prop :=
fun F =>
  ∀ (τ : MeasureTheory.Measure (SpectralChain.Dual F)),
    MeasureTheory.IsFiniteMeasure τ →
      SpectralChain.RotInv F τ →
        ∃ a b m ρ,
          SpectralInputs.IsHaarFourier m ∧
            MeasureTheory.IsProbabilityMeasure ρ ∧
              SpectralChain.RotInv F ρ ∧
                (∀ (u : ↑(SpectralChain.unitVectors F)), ksEntropy ρ (SpectralChain.rot u) = 0) ∧ τ = a • m + b • ρ
mrPlus_of_split_of_carried : ∀ (F : Subfield ℝ), EntropySplit F → ZeroEntropyCarried F → MRPlus F
min_localBound_five_le_chromaticNumber_of_closed : ∀ (F : Subfield ℝ) [inst : NumberField ↥F],
  SpectralChain.BochnerHerglotz ↥(SpectralChain.unitRing F) →
    SpectralChain.InvariantMeasureOnClosed F →
      (chainInterface F).Count →
        (chainInterface F).APlusOfR88 →
          EntropySplit F →
            (NoRamifiedStableDyadic F → ZeroEntropyCarried F) →
              (5 ≤ SpectralChain.localBound F → SpectralChain.TCA F) →
                (SpectralChain.localBound F ≤ 4 →
                    SpectralChain.localBound F ≤ (SimpleGraph.induce (planeOver F) (unitDistance ℂ)).chromaticNumber) →
                  min (SpectralChain.localBound F) 5 ≤
                    (SimpleGraph.induce (planeOver F) (unitDistance ℂ)).chromaticNumber
entropySplit : ∀ (F : Subfield ℝ) [NumberField ↥F], EntropySplit F
