        -(4 / 3) *
          ∑ j,
            ∫ (c : ↥(HadwigerNelson.SpectralChain.unitRing F) → Fin 4),
              HadwigerNelson.SpectralInputs.condLaw (HadwigerNelson.Rigidity.colourFactor μ) μ.μ (fun c => c) 0 j c *
                HadwigerNelson.SpectralInputs.condLaw (HadwigerNelson.Rigidity.colourFactor μ) μ.μ (fun c => c)
                  (HadwigerNelson.SpectralChain.uvRing u) j c ∂μ.μ
