@HadwigerNelson.SpectralInputs.si4 : ∀ {Ω : Type u_1} {V : Type u_2} [Countable V] (𝒜 : MeasurableSpace Ω)
  [m0 : MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ],
  𝒜 ≤ m0 →
    ∀ (c : Ω → V → Fin 4),
      (∀ (x : V), Measurable fun ω => c ω x) →
        ∀ (adj : V → V → Prop),
          (∀ (x y : V),
              adj x y →
                ∀ (j : Fin 4),
                  ∫ (ω : Ω),
                      μ[{ω' | c ω' x = j}.indicator fun x => 1 | 𝒜] ω *
                        μ[{ω' | c ω' y = j}.indicator fun x => 1 | 𝒜] ω ∂μ =
                    0) →
            ∀ (f : Finset (Fin 4) → Fin 4),
              (∀ (s : Finset (Fin 4)), s.Nonempty → f s ∈ s) →
                (∀ (x : V), Measurable fun ω => f (HadwigerNelson.SpectralInputs.condSupport 𝒜 μ c ω x)) ∧
                  (∀ᵐ (ω : Ω) ∂μ,
                      ∀ (x y : V),
                        adj x y →
                          f (HadwigerNelson.SpectralInputs.condSupport 𝒜 μ c ω x) ≠
                            f (HadwigerNelson.SpectralInputs.condSupport 𝒜 μ c ω y)) ∧
                    ∀ᵐ (ω : Ω) ∂μ, ∀ (x : V), c ω x ∈ HadwigerNelson.SpectralInputs.condSupport 𝒜 μ c ω x
@HadwigerNelson.SpectralInputs.si4_equivariant : ∀ {Ω : Type u_1} {V : Type u_2} [Countable V] (𝒜 : MeasurableSpace Ω)
  [m0 : MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ],
  𝒜 ≤ m0 →
    ∀ (c : Ω → V → Fin 4),
      (∀ (x : V), Measurable fun ω => c ω x) →
        ∀ {S : Ω → Ω},
          MeasurePreserving S μ μ →
            MeasurableSpace.comap S 𝒜 = 𝒜 →
              ∀ (π : V → V),
                (∀ (ω : Ω) (x : V), c (S ω) x = c ω (π x)) →
                  ∀ᵐ (ω : Ω) ∂μ,
                    ∀ (x : V),
                      HadwigerNelson.SpectralInputs.condSupport 𝒜 μ c (S ω) x =
                        HadwigerNelson.SpectralInputs.condSupport 𝒜 μ c ω (π x)
@HadwigerNelson.SpectralInputs.spectral_carried_iff : ∀ {R : Type u_1} [inst : AddCommGroup R] {Ω : Type u_2}
  [inst_1 : MeasurableSpace Ω] {μ : Measure Ω} (t : TopologicalSpace R),
  IsTopologicalAddGroup R →
    (nhds 0).IsCountablyGenerated →
      HadwigerNelson.SpectralInputs.BochnerOn t →
        ∀ (T : R → Ω → Ω) (hT : ∀ (y : R), MeasurePreserving (T y) μ μ),
          (∀ (x y : R), T (x + y) = T x ∘ T y) →
            ∀ {f : ↥(Lp ℝ 2 μ)} {σ : Measure (AddChar R Circle)},
              HadwigerNelson.SpectralInputs.IsSpectralMeasureOf T hT f σ →
                (σ (HadwigerNelson.SpectralInputs.contChars t)ᶜ = 0 ↔
                  f ∈ HadwigerNelson.SpectralInputs.contVec T hT (nhds 0))
@HadwigerNelson.StandingFive.circle_sum_le_weil : ∀ {F : Type u_1} [inst : Field F] [inst_1 : Fintype F]
  [inst_2 : DecidableEq F],
  ringChar F ≠ 2 →
    ∀ (ψ : AddChar F ℂ),
      ψ ≠ 1 →
        ∀ (a : F) (b : F × F),
          b ≠ 0 →
            a ≠ 0 ∨ b.1 ^ 2 + b.2 ^ 2 ≠ 0 →
              ‖∑ s with s.1 ^ 2 + s.2 ^ 2 = a, ψ (b.1 * s.1 + b.2 * s.2)‖ ≤ 2 * √↑(Fintype.card F)
@HadwigerNelson.StandingFive.normOne_charSum_ge : ∀ {k : Type} [inst : Field k] [inst_1 : Fintype k]
  [inst_2 : DecidableEq k] {Q : ℕ},
  Q % 4 = 3 →
    Fintype.card k = Q ^ 2 →
      (∀ (F : Type) [inst : Field F] [inst_3 : Fintype F] [inst_4 : DecidableEq F],
          Fintype.card F = Q → HadwigerNelson.StandingFive.KloostermanBound F) →
        ∀ (ψ : AddChar k ℂ), ψ ≠ 1 → -(2 * √↑Q) ≤ (∑ u with u ^ (Q + 1) = 1, ψ u).re
