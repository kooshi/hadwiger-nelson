HadwigerNelson.Rigidity.Counting.tendsto_haarK_bad : ∀ (F : Subfield ℝ) [inst : NumberField ↥F]
  {Y : Set (HadwigerNelson.Rigidity.Counting.K F)},
  MeasurableSet Y →
    ∀ {κ : ENNReal},
      0 < κ →
        Filter.Tendsto
          (fun k =>
            (HadwigerNelson.Rigidity.Counting.haarK F)
              {x |
                x ∈ Y ∧
                  (HadwigerNelson.Rigidity.Counting.haarK F)
                      (Y ∩
                        ⇑(HadwigerNelson.Rigidity.Counting.proj F k) ⁻¹'
                          {(HadwigerNelson.Rigidity.Counting.proj F k) x}) ≤
                    (1 - κ) *
                      (HadwigerNelson.Rigidity.Counting.haarK F)
                        (⇑(HadwigerNelson.Rigidity.Counting.proj F k) ⁻¹'
                          {(HadwigerNelson.Rigidity.Counting.proj F k) x})})
          Filter.atTop (nhds 0)
HadwigerNelson.Rigidity.Counting.haarK_proj_preimage : ∀ (F : Subfield ℝ) [inst : NumberField ↥F] (k : ℕ)
  {a : HadwigerNelson.Rigidity.Counting.Lev F k},
  a ∈ Set.range ⇑(HadwigerNelson.Rigidity.Counting.proj F k) →
    (HadwigerNelson.Rigidity.Counting.haarK F) (⇑(HadwigerNelson.Rigidity.Counting.proj F k) ⁻¹' {a}) =
      (↑(Nat.card ↑(Set.range ⇑(HadwigerNelson.Rigidity.Counting.proj F k))))⁻¹
