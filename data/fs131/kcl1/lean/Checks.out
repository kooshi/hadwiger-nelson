@HadwigerNelson.Rigidity.isSpectralMeasureOf_condExpL2 : ∀ {R : Type u_1} [inst : AddCommGroup R] {Ω : Type u_2}
  [inst_1 : MeasurableSpace Ω] {μ : Measure Ω} [Countable R] (t : TopologicalSpace R),
  IsTopologicalAddGroup R →
    (nhds 0).IsCountablyGenerated →
      HadwigerNelson.SpectralInputs.BochnerOn t →
        MeasurableSet (HadwigerNelson.SpectralInputs.contChars t) →
          ∀ [inst_3 : IsProbabilityMeasure μ] (T : R → Ω → Ω) (hT : ∀ (y : R), MeasurePreserving (T y) μ μ),
            (∀ (x y : R), T (x + y) = T x ∘ T y) →
              ∀ {f : ↥(Lp ℝ 2 μ)} {σ : Measure (AddChar R Circle)},
                HadwigerNelson.SpectralInputs.IsSpectralMeasureOf T hT f σ →
                  HadwigerNelson.SpectralInputs.IsSpectralMeasureOf T hT (↑((condExpL2 ℝ ℝ ⋯) f))
                      (σ.restrict (HadwigerNelson.SpectralInputs.contChars t)) ∧
                    HadwigerNelson.SpectralInputs.IsSpectralMeasureOf T hT (f - ↑((condExpL2 ℝ ℝ ⋯) f))
                      (σ.restrict (HadwigerNelson.SpectralInputs.contChars t)ᶜ)
