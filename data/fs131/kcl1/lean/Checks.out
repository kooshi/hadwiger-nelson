  {u : ↥(HadwigerNelson.SpectralChain.unitRing F)},
  u ∈ HadwigerNelson.Rigidity.Counting.unitVectorsR F →
    ((HadwigerNelson.Rigidity.Counting.Delta F) (Complex.exp (↑θ * Complex.I)),
        (HadwigerNelson.Rigidity.Counting.ιK F) u) ∈
      closure (⇑(HadwigerNelson.Rigidity.Counting.ιG F) '' HadwigerNelson.Rigidity.Counting.unitVectorsR F)
@HadwigerNelson.Rigidity.Counting.exists_extension : ∀ {F : Subfield ℝ} [inst : NumberField ↥F]
  (μ : HadwigerNelson.SpectralChain.InvariantColouring F) {σ : Measure (HadwigerNelson.SpectralChain.Dual F)},
  HadwigerNelson.SpectralChain.IsTraceSpectral F μ.μ σ →
    σ (HadwigerNelson.Rigidity.TA F)ᶜ = 0 →
      ∃ f,
        Measurable (Function.uncurry f) ∧
          ∀ (g t : HadwigerNelson.Rigidity.Counting.G F),
            t ∈ closure (⇑(HadwigerNelson.Rigidity.Counting.ιG F) '' HadwigerNelson.Rigidity.Counting.unitVectorsR F) →
              μ.μ {c | f c g = f c (g + t)} = 0
