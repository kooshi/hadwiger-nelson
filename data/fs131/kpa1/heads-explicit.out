def HadwigerNelson.PadicPlane.borelChromaticNumber.{u_1} : {X : Type u_1} →
  [TopologicalSpace X] → SimpleGraph X → ENat :=
fun {X} [inst : TopologicalSpace X] G =>
  ⨅ k,
    ⨅ (_ :
      ∃ c,
        ∀ (i : Fin k),
          @MeasurableSet X (@borel X inst)
            (@Set.preimage X (Fin k)
              (@DFunLike.coe (@SimpleGraph.Coloring X G (Fin k)) X (fun x => Fin k)
                (@RelHom.instFunLike X (Fin k) (@SimpleGraph.Adj X G)
                  (@SimpleGraph.Adj (Fin k) (SimpleGraph.completeGraph (Fin k))))
                c)
              (@singleton (Fin k) (Set (Fin k)) (@Set.instSingletonSet (Fin k)) i))),
      @Nat.cast ENat ENat.instNatCast k
