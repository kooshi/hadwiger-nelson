@IsClosed.Icc_subset_of_forall_mem_nhdsWithin : ∀ {α : Type u_1} [inst : TopologicalSpace α]
  [inst_1 : ConditionallyCompleteLinearOrder α] [OrderTopology α] [DenselyOrdered α] {a b : α} {s : Set α},
  IsClosed (s ∩ Set.Icc a b) → a ∈ s → (∀ x ∈ s ∩ Set.Ico a b, s ∈ nhdsWithin x (Set.Ioi x)) → Set.Icc a b ⊆ s
@lebesgue_number_lemma_of_metric : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {s : Set α} {ι : Sort u_2}
  {c : ι → Set α}, IsCompact s → (∀ (i : ι), IsOpen (c i)) → s ⊆ ⋃ i, c i → ∃ δ > 0, ∀ x ∈ s, ∃ i, Metric.ball x δ ⊆ c i
@Real.mul_le_sin : ∀ {x : ℝ}, 0 ≤ x → x ≤ Real.pi / 2 → 2 / Real.pi * x ≤ Real.sin x
@Metric.thickening_mono : ∀ {α : Type u_1} [inst : PseudoEMetricSpace α] {δ₁ δ₂ : ℝ},
  δ₁ ≤ δ₂ → ∀ (E : Set α), Metric.thickening δ₁ E ⊆ Metric.thickening δ₂ E
