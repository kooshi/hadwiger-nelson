### HadwigerNelson.Plane.IsSelection
Proofs/HadwigerNelson/Plane/Cover.lean-52-def IsAeCover (C : Fin k → Set ℂ) : Prop := IsAdmissible C ∧ ∀ᵐ x ∂volume, ∃ j, x ∈ C j
Proofs/HadwigerNelson/Plane/Cover.lean-53-
Proofs/HadwigerNelson/Plane/Cover.lean-54-/-- A **maximal admissible cover**: an admissible cover that no admissible cover above it (in `AeLE`) strictly exceeds. -/
Proofs/HadwigerNelson/Plane/Cover.lean-55-def IsMaximalCover (C : Fin k → Set ℂ) : Prop :=
Proofs/HadwigerNelson/Plane/Cover.lean-56-  IsAeCover C ∧ ∀ D : Fin k → Set ℂ, IsAeCover D → AeLE C D → AeLE D C
Proofs/HadwigerNelson/Plane/Cover.lean-57-
Proofs/HadwigerNelson/Plane/Cover.lean-58-/-- A **selection** from a family: a measurable colouring with `x ∈ C (f x)` for almost every `x`. -/
Proofs/HadwigerNelson/Plane/Cover.lean:59:def IsSelection (C : Fin k → Set ℂ) (f : ℂ → Fin k) : Prop := Measurable f ∧ ∀ᵐ x ∂volume, x ∈ C (f x)
Proofs/HadwigerNelson/Plane/Cover.lean-60-
Proofs/HadwigerNelson/Plane/Cover.lean-61-/-- The classes of a colouring, as a family. -/
Proofs/HadwigerNelson/Plane/Cover.lean-62-def AeColouring.cls (c : AeColouring k) (j : Fin k) : Set ℂ := c.col ⁻¹' {j}
