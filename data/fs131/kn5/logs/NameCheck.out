  (∀ z ∈ A, (starRingEnd ℂ) z ∈ A) →
    ∀ {G : Type u_1} [inst : CommRing G] [Nontrivial G] [inst_2 : Fintype G] (ψ : ↥A →+* G) {S : Set ℂ},
      (∀ z ∈ S, ∀ w ∈ S, dist z w = 1 → z - w ∈ A) → (SimpleGraph.induce S (unitDistance ℂ)).Colorable (Fintype.card G)
