@IsUnit.of_mul_eq_one : ∀ {M : Type u_1} [inst : Monoid M] [IsDedekindFiniteMonoid M] {a : M} (b : M),
  a * b = 1 → IsUnit a
@Ideal.Quotient.eq : ∀ {R : Type u_1} [inst : Ring R] {I : Ideal R} {x y : R} [inst_1 : I.IsTwoSided],
  (Ideal.Quotient.mk I) x = (Ideal.Quotient.mk I) y ↔ x - y ∈ I
@Ideal.Quotient.eq_zero_iff_mem : ∀ {R : Type u_1} [inst : Ring R] {I : Ideal R} {a : R} [inst_1 : I.IsTwoSided],
  (Ideal.Quotient.mk I) a = 0 ↔ a ∈ I
@IsLocalization.ringHom_ext : ∀ {R : Type u_1} [inst : CommSemiring R] (M : Submonoid R) {S : Type u_2}
  [inst_1 : CommSemiring S] [inst_2 : Algebra R S] [IsLocalization M S] {P : Type u_3} [inst_4 : Semiring P]
  ⦃j k : S →+* P⦄, j.comp (algebraMap R S) = k.comp (algebraMap R S) → j = k
@ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal : ∀ {K : Type u_1} [inst : Field K] {A : ValuationSubring K}
  {a : K}, a ∈ A.nonunits ↔ ∃ (ha : a ∈ A), ⟨a, ha⟩ ∈ IsLocalRing.maximalIdeal ↥A
@IsLocalization.AtPrime.to_map_mem_maximal_iff : ∀ {R : Type u_1} [inst : CommSemiring R] (S : Type u_2)
  [inst_1 : CommSemiring S] [inst_2 : Algebra R S] (I : Ideal R) [hI : I.IsPrime] [inst_3 : IsLocalization.AtPrime S I]
  (x : R) (h : optParam (IsLocalRing S) ⋯), (algebraMap R S) x ∈ IsLocalRing.maximalIdeal S ↔ x ∈ I
@HeightOneSpectrum.valuationSubringAtPrime_eq_valuationSubring : ∀ {R : Type u_1} [inst : CommRing R]
  [inst_1 : IsDedekindDomain R] {K : Type u_2} [inst_2 : Field K] [inst_3 : Algebra R K] [inst_4 : IsFractionRing R K]
  (v : HeightOneSpectrum R),
  HeightOneSpectrum.valuationSubringAtPrime K v = (HeightOneSpectrum.valuation K v).valuationSubring
@Submodule.exists_mem_ne_zero_of_ne_bot : ∀ {R : Type u_1} {M : Type u_2} [inst : Semiring R] [inst_1 : AddCommMonoid M]
  [inst_2 : Module R M] {p : Submodule R M}, p ≠ ⊥ → ∃ b ∈ p, b ≠ 0
@Subring.equivMapOfInjective : {R : Type u_1} →
  {S : Type u_2} →
    [inst : NonAssocRing R] →
      [inst_1 : NonAssocRing S] → (s : Subring R) → (f : R →+* S) → Function.Injective ⇑f → ↥s ≃+* ↥(Subring.map f s)
