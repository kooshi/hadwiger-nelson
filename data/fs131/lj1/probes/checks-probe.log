@HadwigerNelson.ThreeFourColours.chromaticNumber_planeOver_sqrt_table : ∀ {m : ℕ},
  Squarefree m →
    (m % 4 ≠ 3 →
        (SimpleGraph.induce (HadwigerNelson.planeOver (HadwigerNelson.SquareClass.fieldOfRadicands {m}))
              (HadwigerNelson.unitDistance ℂ)).chromaticNumber =
          2) ∧
      (m % 12 = 3 ∨ m % 12 = 7 →
          (SimpleGraph.induce (HadwigerNelson.planeOver (HadwigerNelson.SquareClass.fieldOfRadicands {m}))
                (HadwigerNelson.unitDistance ℂ)).chromaticNumber =
            3) ∧
        (m % 12 = 11 →
            4 ≤
              (SimpleGraph.induce (HadwigerNelson.planeOver (HadwigerNelson.SquareClass.fieldOfRadicands {m}))
                  (HadwigerNelson.unitDistance ℂ)).chromaticNumber) ∧
          (m % 12 = 11 →
            m % 168 ≠ 47 ∧ m % 168 ≠ 143 ∧ m % 168 ≠ 167 →
              (SimpleGraph.induce (HadwigerNelson.planeOver (HadwigerNelson.SquareClass.fieldOfRadicands {m}))
                    (HadwigerNelson.unitDistance ℂ)).chromaticNumber =
                4)
HadwigerNelson.ThreeFourColours.chromaticNumber_planeOver_eq_three_iff : ∀ (F : Subfield ℝ) [NumberField ↥F],
  ¬(SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).Colorable 2 →
    ((SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber = 3 ↔
      ∃ 𝔭, 𝔭.IsMaximal ∧ Nat.card (𝓞 ↥F ⧸ 𝔭) = 3)
HadwigerNelson.ThreeFourColours.colorable_three_planeOver_iff : ∀ (F : Subfield ℝ) [NumberField ↥F],
  (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).Colorable 3 ↔
    (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).Colorable 2 ∨
      ∃ 𝔭, 𝔭.IsMaximal ∧ Nat.card (𝓞 ↥F ⧸ 𝔭) = 3
@HadwigerNelson.TorsionExtraction.four_le_chromaticNumber_planeOver_of_inv_three_mem : ∀ {F : Subfield ℝ},
  3⁻¹ ∈ HadwigerNelson.SpectralChain.unitRing F →
    ¬(SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).Colorable 2 →
      4 ≤ (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber
@HadwigerNelson.TorsionExtraction.chromaticNumber_planeOver_ne_three_of_inv_three_mem : ∀ {F : Subfield ℝ},
  3⁻¹ ∈ HadwigerNelson.SpectralChain.unitRing F →
    (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber ≠ 3
@HadwigerNelson.TorsionExtraction.four_le_chromaticNumber_planeOver_of_sqrt_mem : ∀ {F : Subfield ℝ} {d : ℕ},
  d % 12 = 11 →
    √↑d ∈ F → 4 ≤ (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber
HadwigerNelson.ThreeFourColours.localBound_le_chromaticNumber_of_le_four : ∀ (F : Subfield ℝ) [NumberField ↥F],
  HadwigerNelson.SpectralChain.localBound F ≤ 4 →
    HadwigerNelson.SpectralChain.localBound F ≤
      (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber
HadwigerNelson.ThreeFourColours.chromaticNumber_planeOver_eq_localBound_of_le_four : ∀ (F : Subfield ℝ)
  [NumberField ↥F],
  HadwigerNelson.SpectralChain.localBound F ≤ 4 →
    (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber =
      HadwigerNelson.SpectralChain.localBound F
HadwigerNelson.ThreeFourColours.chromaticNumber_planeOver_le_three_iff : ∀ (F : Subfield ℝ) [NumberField ↥F],
  (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber ≤ 3 ↔
    HadwigerNelson.SpectralChain.localBound F ≤ 3
HadwigerNelson.ThreeFourColours.localBound_le_chromaticNumber_or_four_le : ∀ (F : Subfield ℝ) [NumberField ↥F],
  HadwigerNelson.SpectralChain.localBound F ≤
      (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber ∨
    4 ≤ (SimpleGraph.induce (HadwigerNelson.planeOver F) (HadwigerNelson.unitDistance ℂ)).chromaticNumber
