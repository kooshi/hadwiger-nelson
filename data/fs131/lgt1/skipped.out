HadwigerNelson.Rigidity.NoRamifiedStableDyadic (Proofs.HadwigerNelson.Rigidity.ChainAtTA) : Subfield ℝ → Prop
  := fun F =>
  ∀ (P : HadwigerNelson.SpectralChain.StablePrime F),
    HadwigerNelson.Rigidity.IsDyadic P → ¬HadwigerNelson.Rigidity.IsRamified P
HadwigerNelson.Rigidity.ZdAction.NoVirtuallyCyclicFactors (Proofs.HadwigerNelson.Rigidity.Solenoid) : {d : ℕ} →
  {X : Type u_1} → [inst : AddCommGroup X] → [inst_1 : TopologicalSpace X] → HadwigerNelson.Rigidity.ZdAction d X → Prop
  := fun {d} {X} [AddCommGroup X] [TopologicalSpace X] α =>
  ∀ (Y : AddSubgroup X), IsClosed ↑Y → α.InvariantOn ⊤ Y → Y ≠ ⊤ → ¬α.IsVirtuallyCyclicMod Y
