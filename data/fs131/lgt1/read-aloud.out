def HadwigerNelson.planeOver : Subfield ℝ → Set ℂ :=
fun F => {z | z.re ∈ F ∧ z.im ∈ F}
def HadwigerNelson.unitDistance.{u_4} : (V : Type u_4) → [MetricSpace V] → SimpleGraph V :=
fun V [MetricSpace V] => { Adj := fun x y => Dist.dist x y = 1, symm := ⋯, loopless := ⋯ }
def HadwigerNelson.SpectralChain.localBound : Subfield ℝ → ℕ∞ :=
fun F => ⨅ P, (HadwigerNelson.SpectralChain.levelTarget P 1).chromaticNumber
structure HadwigerNelson.SpectralChain.StablePrime (F : Subfield ℝ) : Type
number of parameters: 1
fields:
  HadwigerNelson.SpectralChain.StablePrime.P : Ideal
      (NumberField.RingOfIntegers ↥(HadwigerNelson.SpectralChain.fieldI F))
  HadwigerNelson.SpectralChain.StablePrime.isMaximal : self.P.IsMaximal
  HadwigerNelson.SpectralChain.StablePrime.comap_conj : Ideal.comap (HadwigerNelson.SpectralChain.conjO F) self.P =
      self.P
constructor:
  HadwigerNelson.SpectralChain.StablePrime.mk {F : Subfield ℝ}
    (P : Ideal (NumberField.RingOfIntegers ↥(HadwigerNelson.SpectralChain.fieldI F))) (isMaximal : P.IsMaximal)
    (comap_conj : Ideal.comap (HadwigerNelson.SpectralChain.conjO F) P = P) : HadwigerNelson.SpectralChain.StablePrime F
@[reducible] def HadwigerNelson.SpectralChain.fieldI : Subfield ℝ → Subfield ℂ :=
fun F => HadwigerNelson.UnitRing.planeOverSubfield F
def HadwigerNelson.UnitRing.planeOverSubfield : Subfield ℝ → Subfield ℂ :=
fun F =>
  let __src := HadwigerNelson.Chain.planeOverSubring F;
  { toSubring := __src, inv_mem' := ⋯ }
def HadwigerNelson.SpectralChain.levelTarget : {F : Subfield ℝ} →
  (P : HadwigerNelson.SpectralChain.StablePrime F) →
    (m : ℕ) → SimpleGraph (NumberField.RingOfIntegers ↥(HadwigerNelson.SpectralChain.fieldI F) ⧸ P.P ^ m) :=
fun {F} P m =>
  SimpleGraph.fromRel fun x y =>
    (x - y) * (Ideal.quotientMap (P.P ^ m) (HadwigerNelson.SpectralChain.conjO F) ⋯) (x - y) = 1
def HadwigerNelson.SquareClass.fieldOfRadicands : Set ℕ → Subfield ℝ :=
fun D => Subfield.closure ((fun d => √↑d) '' D)
@[reducible] def HadwigerNelson.SqrtFortySeven.F47 : Subfield ℝ :=
HadwigerNelson.SquareClass.fieldOfRadicands {47}
def SimpleGraph.chromaticNumber.{u} : {V : Type u} → SimpleGraph V → ℕ∞ :=
fun {V} G => ⨅ n ∈ setOf G.Colorable, ↑n
@[reducible] def SimpleGraph.induce.{u_1} : {V : Type u_1} → (s : Set V) → SimpleGraph V → SimpleGraph ↑s :=
fun {V} s G => SimpleGraph.comap (⇑(Function.Embedding.subtype fun x => x ∈ s)) G
