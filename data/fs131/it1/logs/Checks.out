@colorable_of_residue : ∀ {V : Type u_1} {M : Type u_2} {G : Type u_3} [inst : AddCommGroup M] [inst_1 : AddCommGroup G]
  {A : AddSubgroup M} [inst_2 : Fintype G] (Γ : SimpleGraph V) (f : V → M) (ψ : ↥A →+ G),
  (∀ ⦃v w : V⦄, Γ.Adj v w → f v - f w ∈ A) →
    (∀ ⦃v w : V⦄, Γ.Adj v w → cosetResidue ψ (f v - f w) ≠ 0) → Γ.Colorable (Fintype.card G)
@cosetResidue_apply_of_mem : ∀ {M : Type u_1} {G : Type u_2} [inst : AddCommGroup M] [inst_1 : AddCommGroup G]
