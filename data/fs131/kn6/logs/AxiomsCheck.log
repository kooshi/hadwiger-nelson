noRamifiedStableDyadic_of_three_le_localBound : ∀ (F : Subfield ℝ),
  3 ≤ SpectralChain.localBound F → NoRamifiedStableDyadic F
@colorable_two_levelTarget_one_of_isRamified : ∀ {F : Subfield ℝ} {P : SpectralChain.StablePrime F},
  IsRamified P → (SpectralChain.levelTarget P 1).Colorable 2
@tendsto_blockEntropy_div : ∀ {X : Type u_1} {m : MeasurableSpace X} (μ : MeasureTheory.Measure X)
  [MeasureTheory.IsProbabilityMeasure μ] {T : X → X},
  MeasureTheory.MeasurePreserving T μ μ →
    ∀ {k : ℕ} {P : X → Fin k},
      Measurable P →
        Filter.Tendsto (fun n => ENNReal.ofReal (blockEntropy μ T P (n + 1) / (↑n + 1))) Filter.atTop
          (nhds (partitionEntropy μ T P))
@ksEntropyOn_le_ksEntropy : ∀ {X : Type u_1} {m 𝒜 : MeasurableSpace X},
