@integral_finset_sum_measure : ∀ {α : Type u_1} {G : Type u_2} [inst : NormedAddCommGroup G] [inst_1 : NormedSpace ℝ G]
  {ι : Type u_3} {m : MeasurableSpace α} {f : α → G} {μ : ι → Measure α} {s : Finset ι},
