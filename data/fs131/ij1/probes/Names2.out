isCompact_setOf_finiteMeasure_le_of_compactSpace : ∀ (E : Type u_1) [inst : MeasurableSpace E]
  [inst_1 : TopologicalSpace E] [T2Space E] [inst_3 : BorelSpace E] [CompactSpace E] (C : NNReal),
  IsCompact {μ | μ.mass ≤ C}
@FiniteMeasure.tendsto_iff_forall_integral_tendsto : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  [inst_1 : TopologicalSpace Ω] [inst_2 : OpensMeasurableSpace Ω] {γ : Type u_2} {F : Filter γ}
  {μs : γ → FiniteMeasure Ω} {μ : FiniteMeasure Ω},
  Filter.Tendsto μs F (nhds μ) ↔
    ∀ (f : BoundedContinuousFunction Ω ℝ),
      Filter.Tendsto (fun i => ∫ (x : Ω), f x ∂↑(μs i)) F (nhds (∫ (x : Ω), f x ∂↑μ))
@IsCompact.exists_clusterPt : ∀ {X : Type u_1} [inst : TopologicalSpace X] {s : Set X},
  IsCompact s → ∀ {f : Filter X} [f.NeBot], f ≤ Filter.principal s → ∃ x ∈ s, ClusterPt x f
