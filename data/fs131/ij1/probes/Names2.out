exists_surjective_nat : ∀ (α : Sort u_1) [Nonempty α] [Countable α], ∃ f, Function.Surjective f
@Fintype.card_piFinset : ∀ {ι : Type u_1} {α : ι → Type u_2} [inst : DecidableEq ι] [inst_1 : Fintype ι]
  (s : (i : ι) → Finset (α i)), (Fintype.piFinset s).card = ∏ i, (s i).card
@Finset.card_eq_sum_card_fiberwise : ∀ {ι : Type u_1} {M : Type u_2} [inst : DecidableEq M] {f : ι → M} {s : Finset ι}
  {t : Finset M}, Set.MapsTo f ↑s ↑t → s.card = ∑ b ∈ t, {a ∈ s | f a = b}.card
@Finset.mul_prod_erase : ∀ {ι : Type u_1} {M : Type u_2} [inst : CommMonoid M] [inst_1 : DecidableEq ι] (s : Finset ι)
  (f : ι → M) {a : ι}, a ∈ s → f a * ∏ x ∈ s.erase a, f x = ∏ x ∈ s, f x
@Finsupp.onFinset : {α : Type u_1} →
  {M : Type u_2} → [inst : Zero M] → (s : Finset α) → (f : α → M) → (∀ (a : α), f a ≠ 0 → a ∈ s) → α →₀ M
@Finsupp.support_onFinset : ∀ {α : Type u_1} {M : Type u_2} [inst : Zero M] [inst_1 : DecidableEq M] {s : Finset α}
  {f : α → M} (hf : ∀ (a : α), f a ≠ 0 → a ∈ s), (Finsupp.onFinset s f hf).support = {a ∈ s | f a ≠ 0}
@tendsto_natCast_div_add_atTop : ∀ {𝕜 : Type u_1} [inst : DivisionSemiring 𝕜] [inst_1 : TopologicalSpace 𝕜]
  [inst_2 : CharZero 𝕜] [ContinuousSMul ℚ≥0 𝕜] [IsTopologicalSemiring 𝕜] [ContinuousInv₀ 𝕜] (x : 𝕜),
  Filter.Tendsto (fun n => ↑n / (↑n + x)) Filter.atTop (nhds 1)
@tendsto_of_tendsto_of_tendsto_of_le_of_le' : ∀ {α : Type u_1} {β : Type u_2} [ts : TopologicalSpace α]
  [inst : Preorder α] [OrderTopology α] {f g h : β → α} {b : Filter β} {a : α},
  Filter.Tendsto g b (nhds a) →
    Filter.Tendsto h b (nhds a) →
      (∀ᶠ (b : β) in b, g b ≤ f b) → (∀ᶠ (b : β) in b, f b ≤ h b) → Filter.Tendsto f b (nhds a)
