  (P : HadwigerNelson.SpectralChain.StablePrime F),
  2 ∉ P.P →
    ∀ {Q : ℕ},
      Nat.card (𝓞 ↥(HadwigerNelson.SpectralChain.fieldI F) ⧸ P.P) = Q ^ 2 →
        Q = 11 ∨ Q = 19 → ∃ c < 1 / 4, HadwigerNelson.Rigidity.RatioAtMost P c
