def HadwigerNelson.Rigidity.RatioAtMost : {F : Subfield ℝ} → HadwigerNelson.SpectralChain.StablePrime F → ℝ → Prop :=
fun {F} P c =>
  ∀ (m : ℕ),
    1 ≤ m →
      ∀ (s : Finset (𝓞 ↥(HadwigerNelson.SpectralChain.fieldI F) ⧸ P.P ^ m)),
        (HadwigerNelson.SpectralChain.levelTarget P m).IsIndepSet ↑s →
          ↑s.card ≤ c * ↑(Nat.card (𝓞 ↥(HadwigerNelson.SpectralChain.fieldI F) ⧸ P.P ^ m))
def HadwigerNelson.SpectralChain.levelTarget : {F : Subfield ℝ} →
  (P : HadwigerNelson.SpectralChain.StablePrime F) →
    (m : ℕ) → SimpleGraph (𝓞 ↥(HadwigerNelson.SpectralChain.fieldI F) ⧸ P.P ^ m) :=
fun {F} P m =>
  SimpleGraph.fromRel fun x y =>
    (x - y) * (Ideal.quotientMap (P.P ^ m) (HadwigerNelson.SpectralChain.conjO F) ⋯) (x - y) = 1
