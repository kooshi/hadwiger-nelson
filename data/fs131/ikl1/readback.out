def HadwigerNelson.FibreCertSound.qform : (p : ℕ) → [NeZero p] → (HadwigerNelson.FibreCertSound.V p → ℝ) → ℝ :=
fun p [NeZero p] φ => 2 * ∑ x, φ x * (1 - φ x) - ∑ x, ∑ s ∈ HadwigerNelson.FibreCertSound.unitCircle p, φ x * φ (x + s)
def HadwigerNelson.FibreCertSound.unitCircle : (p : ℕ) → [NeZero p] → Finset (HadwigerNelson.FibreCertSound.V p) :=
fun p [NeZero p] => {x | x.1 ^ 2 + x.2 ^ 2 = 1}
@[reducible] def HadwigerNelson.FibreCertSound.V : ℕ → Type :=
fun p => ZMod p × ZMod p
@HadwigerNelson.Rigidity.ratioAtMost_of_five_le_chromaticNumber : ∀ {F : Subfield ℝ} [NumberField ↥F]
