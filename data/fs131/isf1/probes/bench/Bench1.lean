/-- A: structural recursion, notation. -/
def outA (bit : Nat) : List Nat → List Nat
  | [] => []
  | t :: l => bif t &&& bit == 0 then t :: outA bit l else outA bit l

/-- B: structural recursion, direct calls. -/
def outB (bit : Nat) : List Nat → List Nat
  | [] => []
  | t :: l => bif Nat.beq (Nat.land t bit) 0 then t :: outB bit l else outB bit l

/-- C: `List.rec`, direct calls. -/
noncomputable def outC (bit : Nat) (L : List Nat) : List Nat :=
  List.rec [] (fun t _ r => bif Nat.beq (Nat.land t bit) 0 then t :: r else r) L

/-- the length, by `List.rec` -/
noncomputable def lenC (L : List Nat) : Nat := List.rec 0 (fun _ _ r => Nat.succ r) L

theorem lenOnly : Nat.beq (lenC rL) 3000 = true := by decide +kernel
theorem benchA : Nat.beq (lenC (outA 1 (outA 2 (outA 4 (outA 8 (outA 16 rL)))))) 0 = false := by decide +kernel
theorem benchB : Nat.beq (lenC (outB 1 (outB 2 (outB 4 (outB 8 (outB 16 rL)))))) 0 = false := by decide +kernel
theorem benchC : Nat.beq (lenC (outC 1 (outC 2 (outC 4 (outC 8 (outC 16 rL)))))) 0 = false := by decide +kernel

theorem mergeBench : Nat.beq (lenC (mergeR FUEL (outB 1 rL) (outB 2 rL))) 0 = false := by decide +kernel
theorem stepInBench : Nat.beq (lenC (stepIn 1 6 rL)) 0 = false := by decide +kernel
theorem stepOutBench : Nat.beq (lenC (stepOut 1 rL)) 0 = false := by decide +kernel

end HadwigerNelson.G27.Bench
