    ∀ {p : HadwigerNelson.Rigidity.WPlace F} {C : ℝ},
      0 < C →
        D.IsGap C →
          ∀ {ε : ℝ},
            0 < ε →
              16 * ε ≤ 1 →
                ∀ {δ₀ : ℝ},
                  0 < δ₀ →
                    ∀ {xw : HadwigerNelson.Rigidity.SAdeleRing F},
                      (∀ (δ : ℝ),
                          0 < δ →
                            δ ≤ δ₀ →
                              δ ^ HadwigerNelson.Rigidity.heavyExponent F ≤
                                μ.real (⇑D.π '' (fun x => xw + x) '' HadwigerNelson.Rigidity.thinBox p (2 * ε) δ)) →
                        ∃ t, xw - (HadwigerNelson.Rigidity.toSAdele F) t ∈ HadwigerNelson.Rigidity.hyperplane p
