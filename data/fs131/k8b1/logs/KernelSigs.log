@HadwigerNelson.Rigidity.TateModel.thinBox_heavy : ∀ {F : Subfield ℝ} [inst : NumberField ↥F]
  (D : HadwigerNelson.Rigidity.TateModel F) (μ : MeasureTheory.Measure (HadwigerNelson.SpectralChain.Dual F))
  [MeasureTheory.IsProbabilityMeasure μ],
  HadwigerNelson.SpectralChain.RotInv F μ →
    ∀ {u : ↑(HadwigerNelson.SpectralChain.unitVectors F)},
      HadwigerNelson.Rigidity.ksEntropy μ (HadwigerNelson.SpectralChain.rot u) = 0 →
        ∀ {p : HadwigerNelson.Rigidity.WPlace F},
          1 < p.absAt (HadwigerNelson.Rigidity.unitL u) →
            ∀ {C : ℝ},
              D.IsGap C →
                ∀ {ε : ℝ},
                  0 < ε →
                    (∏ v, (2 * ε * (1 + v (HadwigerNelson.Rigidity.unitL u))) ^ v.mult) *
                          HadwigerNelson.Rigidity.splitHeight (HadwigerNelson.Rigidity.unitL u) <
                        C →
                      ∀ {β η : ℝ},
                        0 < β →
                          0 < η →
                            ∃ δ₀,
                              0 < δ₀ ∧
                                ∃ X',
                                  MeasurableSet X' ∧
                                    1 - η < μ.real X' ∧
                                      ∀ x ∈ X',
                                        ∀ (xw : HadwigerNelson.Rigidity.SAdeleRing F),
                                          D.π xw = x →
                                            ∀ (δ : ℝ),
                                              0 < δ →
                                                δ ≤ δ₀ →
                                                  δ ^ β ≤
                                                    μ.real
                                                      (⇑D.π ''
                                                        (fun x => xw + x) ''
                                                          HadwigerNelson.Rigidity.thinBox p (2 * ε) δ)
@HadwigerNelson.Rigidity.TateModel.exists_point_of_heavy : ∀ {F : Subfield ℝ} [inst : NumberField ↥F]
  (D : HadwigerNelson.Rigidity.TateModel F) (μ : MeasureTheory.Measure (HadwigerNelson.SpectralChain.Dual F))
  [MeasureTheory.IsProbabilityMeasure μ],
