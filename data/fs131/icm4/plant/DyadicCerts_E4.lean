import Proofs.HadwigerNelson.Arith.BinaryField

/-!
# The dyadic certificates: `U_Q` four-colourable at `Q ∈ {4, 8, 16, 32}`, and `λ_min(U₆₄) ≥ −15` (FS131-ICM4)

**Read aloud, against the informal claims.** `U_Q = Cay(𝔽_{Q²}, μ_{Q+1})`, the level-one target at an inert prime above 2
of norm `Q`. X26B-T1 (`plans/FS100-X26B-derivation.md` § 2.3, [tools exact]): "`U_Q` 4-colourable by an `𝔽₂`-linear
colouring at every `Q ≤ 32`", and "`U₆₄` … `λ_min` −15". Here, for **every** field `k` of `Q²` elements:

* `colorable_four_two_pow` — at `Q = 2^f`, `2 ≤ f ≤ 5`, the graph `x ~ y ⟺ (x − y)^(Q+1) = 1` on `k` is four-colourable;
* `charSum_64_ge` — at `Q = 64`, every non-trivial additive character of `k` sums to real part at least `−15` over
  `μ₆₅ = {u : u⁶⁵ = 1}`.

**No outside theorem.** Each is `Arith/BinaryField`'s bridge read at one certificate, each certificate a `decide +kernel`
on `Nat`:

* a primitive polynomial per degree (`prim4` … `prim12`: the register's orbit of `1` returns first after `2ⁿ − 1`
  steps): `x⁴ + x + 1`, `x⁶ + x + 1`, `x⁸ + x⁴ + x³ + x² + 1`, `x¹⁰ + x³ + 1`, `x¹² + x⁶ + x⁴ + x + 1`;
* at `Q = 4, 8, 16, 32` two exponents `(e₁, e₂)` (`colour4` … `colour32`): every `u ∈ μ_{Q+1}` has `L₀(g^{e₁}u) = 1` or
  `L₀(g^{e₂}u) = 1`, so `x ↦ (L₀(g^{e₁}x), L₀(g^{e₂}x))` colours `U_Q` properly with four colours. Its classes are the
  cosets of the codimension-2 subspace `{x : L₀(g^{e₁}x) = L₀(g^{e₂}x) = 0}`; at 32 the pair is `(e, e + 341)`, an
  `𝔽₄`-hyperplane (G54's eleven);
* at `Q = 64` one pass of the register over its 4,095 states, the coordinate-0 bit counted into 63 classes
  (`counts64_ok`): every class has at most 40 ones, so every sum is at least `65 − 2·40 = −15`.

The literals are generated by `tools/fs131_icm4_certs.py`, which recomputes them in exact integer arithmetic and checks
them against X26B-T1's counts: 10, 36 and 68 codimension-2 subspaces avoiding `μ_{Q+1}` at `Q = 4, 8, 16` and 11
`𝔽₄`-hyperplanes at 32 (`data/fs131/icm4/certs.out`), and `max c_r = 40` at 64. **Nothing in `tools/` is trusted**: the
kernel checks each certificate here.

**Inhabitants.** `GaloisField 2 (2f)` is a field of `(2^f)²` elements (the Spec's last examples run both theorems there).
-/

namespace HadwigerNelson.DyadicCerts

open Finset BinaryField

-- BEGIN CERTIFICATE (generated: tools/fs131_icm4_certs.py)
/-- `x⁴ + x + 1`, primitive over `𝔽₂`. -/
def P4 : ℕ := 19
/-- `x⁶ + x + 1`, primitive over `𝔽₂`. -/
def P6 : ℕ := 67
/-- `x⁸ + x⁴ + x³ + x² + 1`, primitive over `𝔽₂`. -/
def P8 : ℕ := 285
/-- `x¹⁰ + x³ + 1`, primitive over `𝔽₂`. -/
def P10 : ℕ := 1033
/-- `x¹² + x⁶ + x⁴ + x + 1`, primitive over `𝔽₂`. -/
def P12 : ℕ := 4179
/-- The two exponents of the four-colouring at `Q = 4`. -/
def E4 : ℕ × ℕ := (0, 0)
/-- The two exponents of the four-colouring at `Q = 8`. -/
def E8 : ℕ × ℕ := (2, 16)
/-- The two exponents of the four-colouring at `Q = 16`. -/
def E16 : ℕ × ℕ := (0, 28)
/-- The two exponents of the four-colouring at `Q = 32` (an `𝔽₄`-hyperplane: `344 = 3 + 1023/3`). -/
def E32 : ℕ × ℕ := (3, 344)
/-- The largest class count of the bit-0 sequence at `Q = 64`. -/
def B64 : ℕ := 40
-- END CERTIFICATE

/-! ### The primitive polynomials -/

/-- `x⁴ + x + 1` is primitive. -/
theorem prim4 : IsPrimitiveCode 4 P4 := isPrimitiveCode_of_check (by decide +kernel)
/-- `x⁶ + x + 1` is primitive. -/
theorem prim6 : IsPrimitiveCode 6 P6 := isPrimitiveCode_of_check (by decide +kernel)
/-- `x⁸ + x⁴ + x³ + x² + 1` is primitive. -/
theorem prim8 : IsPrimitiveCode 8 P8 := isPrimitiveCode_of_check (by decide +kernel)
/-- `x¹⁰ + x³ + 1` is primitive. -/
theorem prim10 : IsPrimitiveCode 10 P10 := isPrimitiveCode_of_check (by decide +kernel)
/-- `x¹² + x⁶ + x⁴ + x + 1` is primitive. -/
theorem prim12 : IsPrimitiveCode 12 P12 := isPrimitiveCode_of_check (by decide +kernel)

/-! ### The four-colourings at `Q = 4, 8, 16, 32` -/

/-- The colouring certificate at `Q = 4`. -/
theorem colour4 : colourCheck 4 P4 (2 ^ 2) E4.1 E4.2 = true := by decide +kernel
/-- The colouring certificate at `Q = 8`. -/
theorem colour8 : colourCheck 6 P6 (2 ^ 3) E8.1 E8.2 = true := by decide +kernel
/-- The colouring certificate at `Q = 16`. -/
theorem colour16 : colourCheck 8 P8 (2 ^ 4) E16.1 E16.2 = true := by decide +kernel
/-- The colouring certificate at `Q = 32`. -/
theorem colour32 : colourCheck 10 P10 (2 ^ 5) E32.1 E32.2 = true := by decide +kernel

/-- **`U_Q` is four-colourable at `Q = 2^f`, `2 ≤ f ≤ 5`** (X26B-T1): in every field of `Q²` elements the graph
`x ~ y ⟺ (x − y)^(Q+1) = 1` has a proper colouring by the two functionals of the certificate. -/
theorem colorable_four_two_pow {f : ℕ} (hf2 : 2 ≤ f) (hf5 : f ≤ 5) (k : Type*) [Field k] [Fintype k]
    (hk : Fintype.card k = (2 ^ f) ^ 2) :
    (SimpleGraph.fromRel fun x y : k => (x - y) ^ (2 ^ f + 1) = 1).Colorable 4 := by
  obtain rfl | rfl | rfl | rfl : f = 2 ∨ f = 3 ∨ f = 4 ∨ f = 5 := by omega
  · exact colorable_four_of_check prim4 (by norm_num) colour4 k hk
  · exact colorable_four_of_check prim6 (by norm_num) colour8 k hk
  · exact colorable_four_of_check prim8 (by norm_num) colour16 k hk
  · exact colorable_four_of_check prim10 (by norm_num) colour32 k hk

/-! ### The spectrum at `Q = 64` -/

/-- One pass of the register at degree 12 over its `63·65 = 4095` states, counting bit 0 into 63 classes. -/
def counts64 : ℕ × ℕ := pass 12 P12 63 (63 * 65) 1 0 0

/-- Every class counter of `counts64` is at most `bound`. -/
def countsOk64 (bound : ℕ) : Bool := (List.range 63).all fun r => (counts64.2 >>> (8 * r)) &&& 255 ≤ bound

/-- **The certified class counts**: every class has at most 40 ones. -/
theorem counts64_ok : countsOk64 B64 = true := by decide +kernel

/-- Every class `r < 63` of the bit-0 sequence at degree 12 has at most 40 ones among the indices `63j + r`, `j ≤ 64`
(`counts64_ok`, read through `pass_class`). -/
theorem class64_le (r : ℕ) (hr : r < 63) : ∑ j ∈ range 65, (step 12 P12)^[63 * j + r] 1 % 2 ≤ 40 := by
  have h := counts64_ok
  rw [countsOk64, List.all_eq_true] at h
  have h1 := h r (List.mem_range.mpr hr)
  rw [decide_eq_true_eq, Nat.shiftRight_eq_div_pow, show (255 : ℕ) = 2 ^ 8 - 1 from rfl,
    Nat.and_two_pow_sub_one_eq_mod, show (2 : ℕ) ^ 8 = 256 from rfl, counts64] at h1
  rw [← pass_class 63 1 65 (by norm_num) r hr]
  exact h1

/-- **`λ_min(U₆₄) ≥ −15`** (X26B-T1: `λ_min(U₆₄) = −15`): every non-trivial additive character of a field of `64²`
elements sums to real part at least `−15` over `μ₆₅`. -/
theorem charSum_64_ge {k : Type*} [Field k] [Fintype k] [DecidableEq k] (hcard : Fintype.card k = 64 ^ 2)
    (ψ : AddChar k ℂ) (hψ : ψ ≠ 1) :
    -(15 : ℝ) ≤ (∑ u ∈ univ.filter (fun u : k => u ^ (64 + 1) = 1), ψ u).re := by
  have h := charSum_ge_of_classes prim12 (Q := 64) (B := 40) (by norm_num) (fun r hr => class64_le r hr) hcard ψ hψ
  have e : ((64 : ℕ) : ℝ) + 1 - 2 * ((40 : ℕ) : ℝ) = -15 := by norm_num
  linarith

/-! ## Spec -/

-- the controls, one per certificate: each fails on a corrupted entry. A colouring by one functional twice (`e₂ := e₁`)
-- is a two-colouring by a hyperplane, which no `U_Q` with `Q ≥ 4` has (`χ(U_Q) = 4`, G56); one below the bound, some
-- class has exactly 40 ones (`λ_min(U₆₄) = −15` is attained).
example : colourCheck 4 P4 (2 ^ 2) E4.1 E4.1 = false := by decide +kernel
example : colourCheck 6 P6 (2 ^ 3) E8.1 E8.1 = false := by decide +kernel
example : colourCheck 8 P8 (2 ^ 4) E16.1 E16.1 = false := by decide +kernel
example : colourCheck 10 P10 (2 ^ 5) E32.1 E32.1 = false := by decide +kernel
example : countsOk64 39 = false := by decide +kernel
-- a non-primitive polynomial of degree 12 is refused: `x¹² + 1 = (x³ + 1)⁴`.
example : primCheck 12 4097 = false := by decide +kernel
-- the models the module docstring names: `GaloisField 2 (2f)` is a field of `(2^f)²` elements, so neither theorem
-- quantifies over an empty domain.
example [Fintype (GaloisField 2 4)] :
    (SimpleGraph.fromRel fun x y : GaloisField 2 4 => (x - y) ^ (2 ^ 2 + 1) = 1).Colorable 4 :=
  colorable_four_two_pow (f := 2) le_rfl (by norm_num) _
    (by rw [← Nat.card_eq_fintype_card, GaloisField.card 2 4 (by norm_num)]; norm_num)
example [Fintype (GaloisField 2 10)] :
    (SimpleGraph.fromRel fun x y : GaloisField 2 10 => (x - y) ^ (2 ^ 5 + 1) = 1).Colorable 4 :=
  colorable_four_two_pow (f := 5) (by norm_num) le_rfl _
    (by rw [← Nat.card_eq_fintype_card, GaloisField.card 2 10 (by norm_num)]; norm_num)
example [Fintype (GaloisField 2 12)] [DecidableEq (GaloisField 2 12)] (ψ : AddChar (GaloisField 2 12) ℂ) (hψ : ψ ≠ 1) :
    -(15 : ℝ) ≤ (∑ u ∈ univ.filter (fun u : GaloisField 2 12 => u ^ (64 + 1) = 1), ψ u).re :=
  charSum_64_ge (by rw [← Nat.card_eq_fintype_card, GaloisField.card 2 12 (by norm_num)]; norm_num) ψ hψ

end HadwigerNelson.DyadicCerts
