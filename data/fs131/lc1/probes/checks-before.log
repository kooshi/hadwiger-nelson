def HadwigerNelson.Plane.chiLebesgue : ℕ∞ :=
⨅ k, ⨅ (_ : ∃ f, NullMeasurable f volume ∧ ∀ (x y : ℂ), dist x y = 1 → f x ≠ f y), ↑k
def HadwigerNelson.HasDensityOneAt.{u_2} : {X : Type u_2} →
  [PseudoMetricSpace X] → [inst : MeasurableSpace X] → Measure X → Set X → X → Prop :=
fun {X} [PseudoMetricSpace X] [MeasurableSpace X] μ s x =>
  Tendsto (fun r => μ (s ∩ closedBall x r) / μ (closedBall x r)) (𝓝[>] 0) (𝓝 1)
def HadwigerNelson.Plane.AeColouring.core : {k : ℕ} → AeColouring k → Fin k → Set ℂ :=
fun {k} a j => a.col ⁻¹' {j} ∩ densitySet (a.col ⁻¹' {j})
def HadwigerNelson.Plane.chiM : ℕ∞ :=
⨅ k, ⨅ (_ : ∃ f, Measurable f ∧ ∀ (x y : ℂ), dist x y = 1 → f x ≠ f y), ↑k
def HadwigerNelson.Plane.chiM0 : ℕ∞ :=
⨅ k, ⨅ (_ : Nonempty (AeColouring k)), ↑k
structure HadwigerNelson.Plane.AeColouring (k : ℕ) : Type
number of parameters: 1
fields:
  HadwigerNelson.Plane.AeColouring.col : ℂ → Fin k
  HadwigerNelson.Plane.AeColouring.measurable : Measurable self.col
  HadwigerNelson.Plane.AeColouring.unitPairsNull : ∀ (j : Fin k), UnitPairsNull (self.col ⁻¹' {j})
constructor:
  HadwigerNelson.Plane.AeColouring.mk {k : ℕ} (col : ℂ → Fin k) (measurable : Measurable col)
    (unitPairsNull : ∀ (j : Fin k), UnitPairsNull (col ⁻¹' {j})) : AeColouring k
def HadwigerNelson.Plane.UnitPairsNull : Set ℂ → Prop :=
fun A => (volume.prod arcLength) (unitPairSet A) = 0
