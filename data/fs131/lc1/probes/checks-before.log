        ∀ {S : Set E},
          μ Sᶜ = 0 →
            (∀ x ∈ S, ∀ y ∈ S, R x y → c x ≠ c y) → ∃ f, NullMeasurable f μ ∧ f =ᵐ[μ] c ∧ ∀ (x y : E), R x y → f x ≠ f y
