@Subring.closure_induction : ∀ {R : Type u_1} [inst : NonAssocRing R] {s : Set R}
  {p : (x : R) → x ∈ Subring.closure s → Prop},
  (∀ (x : R) (hx : x ∈ s), p x ⋯) →
    p 0 ⋯ →
      p 1 ⋯ →
        (∀ (x y : R) (hx : x ∈ Subring.closure s) (hy : y ∈ Subring.closure s), p x hx → p y hy → p (x + y) ⋯) →
          (∀ (x : R) (hx : x ∈ Subring.closure s), p x hx → p (-x) ⋯) →
            (∀ (x y : R) (hx : x ∈ Subring.closure s) (hy : y ∈ Subring.closure s), p x hx → p y hy → p (x * y) ⋯) →
