  {ι : Type u_2} {l : Filter ι} [l.IsCountablyGenerated] {F : ι → α → ENNReal} {f : α → ENNReal} (bound : α → ENNReal),
  (∀ᶠ (n : ι) in l, Measurable (F n)) →
