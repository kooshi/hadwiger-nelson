def HadwigerNelson.SpectralChain.Interface.Count : {F : Subfield ℝ} → Interface F → Prop :=
fun {F} I => TCA F → I.R88TCA
def HadwigerNelson.SpectralChain.Interface.R88TCA : {F : Subfield ℝ} → Interface F → Prop :=
fun {F} I => ∀ (μ : InvariantColouring F) (σ : Measure (Dual F)), IsTraceSpectral F μ.μ σ → σ I.TAᶜ ≠ 0
def HadwigerNelson.SpectralChain.TCA : Subfield ℝ → Prop :=
fun F =>
  ∀ (P : StablePrime F),
    ∃ c < 1 / 4,
      ∀ (m : ℕ),
        1 ≤ m →
          ∀ (s : Finset (NumberField.RingOfIntegers ↥(fieldI F) ⧸ P.P ^ m)),
            (levelTarget P m).IsIndepSet ↑s →
              ↑s.card ≤ c * ↑(Nat.card (NumberField.RingOfIntegers ↥(fieldI F) ⧸ P.P ^ m))
def HadwigerNelson.SpectralChain.IsTraceSpectral : (F : Subfield ℝ) →
  Measure (↥(unitRing F) → Fin 4) → Measure (Dual F) → Prop :=
fun F μ σ => IsFiniteMeasure σ ∧ ∀ (y : ↥(unitRing F)), ∫ (χ : Dual F), ↑(χ y) ∂σ = ↑(corr F μ y)
structure HadwigerNelson.SpectralChain.InvariantColouring (F : Subfield ℝ) : Type
number of parameters: 1
fields:
  HadwigerNelson.SpectralChain.InvariantColouring.μ : Measure (↥(unitRing F) → Fin 4)
  HadwigerNelson.SpectralChain.InvariantColouring.isProb : IsProbabilityMeasure self.μ
  HadwigerNelson.SpectralChain.InvariantColouring.carried : self.μ (X4 F)ᶜ = 0
  HadwigerNelson.SpectralChain.InvariantColouring.shift_inv : ∀ (y : ↥(unitRing F)),
      Measure.map (fun c x => c (x + y)) self.μ = self.μ
  HadwigerNelson.SpectralChain.InvariantColouring.rot_inv : ∀ (u : ↑(unitVectors F)),
      Measure.map (fun c x => c (uvRing u * x)) self.μ = self.μ
constructor:
  HadwigerNelson.SpectralChain.InvariantColouring.mk {F : Subfield ℝ} (μ : Measure (↥(unitRing F) → Fin 4))
    (isProb : IsProbabilityMeasure μ) (carried : μ (X4 F)ᶜ = 0)
    (shift_inv : ∀ (y : ↥(unitRing F)), Measure.map (fun c x => c (x + y)) μ = μ)
    (rot_inv : ∀ (u : ↑(unitVectors F)), Measure.map (fun c x => c (uvRing u * x)) μ = μ) : InvariantColouring F
