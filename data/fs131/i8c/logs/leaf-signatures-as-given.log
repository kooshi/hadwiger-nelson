@qcol_inner_tile : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ} {θ₁ θ₂ : ℝ} {c c' : Fin k},
        F.IsRingArc p θ₁ θ₂ c c' → ∀ {T : Set ℂ}, F.TileOf c T → p ∈ closure T → ringArc p θ₁ θ₂ ⊆ closure T
@GermOnQWith.exists_isRingArc_ccw : ∀ {k : ℕ} {F : ArcMap k} {p : ℂ} {θ : ℝ} {a a' : Fin k},
  F.GermOnQWith p θ Side.ccw a a' → ∃ ℓ > 0, F.IsRingArc p θ (θ + ℓ) a a'
@GermOnQWith.exists_isRingArc_cw : ∀ {k : ℕ} {F : ArcMap k} {p : ℂ} {θ : ℝ} {a a' : Fin k},
  F.GermOnQWith p θ Side.cw a a' → ∃ ℓ > 0, F.IsRingArc p (θ - ℓ) θ a a'
@qcol_not_one_arc : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          ∀ {ψ : ℝ} (s : Side) {θ₁ θ₂ : ℝ},
            F.IsQArc p θ₁ θ₂ →
              GermIn p (ψ + Real.pi / 3) s (ringArc p θ₁ θ₂) →
                GermIn p (ψ - Real.pi / 3) s.flip (ringArc p θ₁ θ₂) → False
@germPair_inner_ne : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          ∀ {ψ : ℝ} (s : Side) {a a' b b' : Fin k},
            F.GermOnQWith p (ψ + Real.pi / 3) s a a' → F.GermOnQWith p (ψ - Real.pi / 3) s.flip b b' → a ≠ b
@germPair_dicho : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          F.SimpleOn {p} →
            (F.coloursAt p).ncard = 4 →
              ∀ {ψ : ℝ} (s : Side) {a a' b b' : Fin k},
                F.GermOnQWith p (ψ + Real.pi / 3) s a a' →
                  F.GermOnQWith p (ψ - Real.pi / 3) s.flip b b' → a = b' ∧ a' = b ∨ Disjoint {a, a'} {b, b'}
@ringTile_uMinus : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        F.Covers p 1 →
          4 ≤ (F.coloursAt p).ncard →
            k ≤ (F.coloursAt p).ncard + 2 →
              ∀ {ψ : ℝ} {X X' : Fin k},
                F.IsChangePoint p ψ X X' →
                  ¬F.GermOnQ p (ψ + Real.pi / 3) Side.cw →
                    ∀ {R : Set ℂ},
                      F.TileOf X R →
                        ringPt p ψ ∈ closure R →
                          ringPt p (ψ + Real.pi / 3) ∈ closure R ∧ R ⊆ Metric.closedBall (ringPt p (ψ + Real.pi / 3)) 1
@ringTile_vMinus : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        F.Covers p 1 →
          4 ≤ (F.coloursAt p).ncard →
            k ≤ (F.coloursAt p).ncard + 2 →
              ∀ {ψ : ℝ} {X X' : Fin k},
                F.IsChangePoint p ψ X X' →
                  ¬F.GermOnQ p (ψ - Real.pi / 3) Side.cw →
                    ∀ {R : Set ℂ},
                      F.TileOf X R → ringPt p ψ ∈ closure R → Disjoint R (Metric.ball (ringPt p (ψ - Real.pi / 3)) 1)
@ringTile_vPlus : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
