                      F.TileOf X' R' →
                        ringPt p ψ ∈ closure R' →
                          ringPt p (ψ - Real.pi / 3) ∈ closure R' ∧
                            R' ⊆ Metric.closedBall (ringPt p (ψ - Real.pi / 3)) 1
@ringTile_uPlus : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        F.Covers p 1 →
          4 ≤ (F.coloursAt p).ncard →
            k ≤ (F.coloursAt p).ncard + 2 →
