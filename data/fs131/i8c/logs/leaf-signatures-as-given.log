                F.IsChangePoint p ψ X X' →
                  ¬F.GermOnQ p (ψ + Real.pi / 3) Side.ccw →
                    ∀ {R' : Set ℂ},
                      F.TileOf X' R' →
                        ringPt p ψ ∈ closure R' → Disjoint R' (Metric.ball (ringPt p (ψ + Real.pi / 3)) 1)
@isRingArc_of_edge : ∀ {k : ℕ} {F : ArcMap k} {y w : ℂ},
  y ∈ F.dom →
    ∀ {T₁ T₂ : Set ℂ} {c₁ c₂ : Fin k},
      F.TileOf c₁ T₁ →
        F.TileOf c₂ T₂ →
          T₁ ≠ T₂ →
            T₁ ⊆ Metric.closedBall w 1 →
              Disjoint T₂ (Metric.ball w 1) →
                ∀ {α : Arc},
                  α ∈ F.arcs →
                    ∀ {δ : ℝ} {B : Set ℂ},
                      α.InitialPiece y δ B →
                        B ⊆ closure T₁ ∩ closure T₂ → ∃ θ₁ θ₂, F.IsRingArc w θ₁ θ₂ c₁ c₂ ∧ y ∈ ringArc w θ₁ θ₂
@four_le_of_bothKind : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese → ∀ {w : ℂ}, w ∈ F.dom → F.SimpleOn {w} → ∀ {θ₁ θ₂ : ℝ}, F.BothKind w θ₁ θ₂ → 4 ≤ (F.coloursAt w).ncard
@exists_isStar4 : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          F.SimpleOn {p} → (F.coloursAt p).ncard = 4 → ∃ t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄, F.IsStar4 p t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄
@ringArc_star : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          F.SimpleOn {p} →
            (F.coloursAt p).ncard = 4 →
              ∀ {u v : ℝ} {c c' : Fin k},
                F.IsRingArc p u v c c' →
                  c ∈ F.coloursAt p →
                    c' ∈ F.coloursAt p →
                      ∃ t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄,
                        F.IsStar4 p t₁ t₂ t₃ t₄ e₁ e₂ e₃ e₄ ∧
                          F.TileOf c t₁ ∧
                            F.TileOf c' t₃ ∧
                              v - Real.pi / 2 ≤ e₁ ∧
                                e₂ ≤ u + Real.pi / 2 ∧ v + Real.pi / 2 ≤ e₃ ∧ e₄ ≤ u + 3 * Real.pi / 2
@fullSemiHub_star_crossed : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          F.SimpleOn {p} →
            (F.coloursAt p).ncard = 4 →
              ∀ {ψ ℓ m : ℝ} {a a' b b' : Fin k},
                F.IsRingArc p (ψ + Real.pi / 3) (ψ + Real.pi / 3 + ℓ) a a' →
                  F.IsRingArc p (ψ - Real.pi / 3 - m) (ψ - Real.pi / 3) b b' →
                    a ∈ F.coloursAt p →
                      a' ∈ F.coloursAt p →
                        b ∈ F.coloursAt p →
                          b' ∈ F.coloursAt p →
                            Disjoint {a, a'} {b, b'} →
                              ℓ + m ≤ Real.pi / 3 ∧
                                ∃ ta tb' ta' tb e₁ e₂ e₃ e₄,
                                  F.TileOf a ta ∧
                                    F.TileOf b' tb' ∧
                                      F.TileOf a' ta' ∧
                                        F.TileOf b tb ∧
                                          F.IsStar4 p ta tb' ta' tb e₁ e₂ e₃ e₄ ∧
                                            e₁ ∈ Set.Icc (ψ + ℓ - Real.pi / 6) (ψ + Real.pi / 6 - m) ∧
                                              e₂ ∈ Set.Icc (ψ + Real.pi / 6) (ψ + 5 * Real.pi / 6) ∧
                                                e₃ ∈ Set.Icc (ψ + 5 * Real.pi / 6 + ℓ) (ψ + 7 * Real.pi / 6 - m) ∧
                                                  e₄ ∈ Set.Icc (ψ + 7 * Real.pi / 6) (ψ + 11 * Real.pi / 6)
@fullSemiHub_star_parallel : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          F.SimpleOn {p} →
            (F.coloursAt p).ncard = 4 →
              ∀ {ψ ℓ m : ℝ} {a a' : Fin k},
                F.IsRingArc p (ψ + Real.pi / 3) (ψ + Real.pi / 3 + ℓ) a a' →
                  F.IsRingArc p (ψ - Real.pi / 3 - m) (ψ - Real.pi / 3) a' a →
                    a ∈ F.coloursAt p →
                      a' ∈ F.coloursAt p →
                        ∃ ta tback ta' tfront e₁ e₂ e₃ e₄,
                          F.TileOf a ta ∧
                            F.TileOf a' ta' ∧
                              F.IsStar4 p ta tback ta' tfront e₁ e₂ e₃ e₄ ∧
                                ψ + Real.pi / 6 ≤ e₁ ∧
                                  e₂ ≤ ψ + 5 * Real.pi / 6 ∧ ψ + 7 * Real.pi / 6 ≤ e₃ ∧ e₄ ≤ ψ + 11 * Real.pi / 6
@fullSemiHub_star_parallel_T : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        p ∈ F.dom →
          F.SimpleOn {p} →
            (F.coloursAt p).ncard = 4 →
              ∀ {ψ ℓ m : ℝ} {a a' : Fin k},
                F.IsRingArc p (ψ + Real.pi / 3 - ℓ) (ψ + Real.pi / 3) a a' →
                  F.IsRingArc p (ψ - Real.pi / 3) (ψ - Real.pi / 3 + m) a' a →
                    a ∈ F.coloursAt p →
                      a' ∈ F.coloursAt p →
                        ∃ ta tback ta' tfront e₁ e₂ e₃ e₄,
                          F.TileOf a ta ∧
                            F.TileOf a' ta' ∧
                              F.IsStar4 p ta tback ta' tfront e₁ e₂ e₃ e₄ ∧
                                ψ + Real.pi / 6 + m ≤ e₁ ∧
                                  e₂ ≤ ψ + 5 * Real.pi / 6 - ℓ ∧
                                    ψ + 7 * Real.pi / 6 + m ≤ e₃ ∧ e₄ ≤ ψ + 11 * Real.pi / 6 - ℓ
