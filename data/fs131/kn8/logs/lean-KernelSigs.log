  IsHaarFourier m → ∀ (φ : G →+ G), Function.Injective ⇑φ → Measure.map (fun χ => χ.compAddMonoidHom φ) m = m
@IsHaarFourier.map_mul_right_eq : ∀ {G : Type u_1} [inst : AddCommGroup G] [Countable G]
  {m : Measure (AddChar G Circle)}, IsHaarFourier m → ∀ (a : AddChar G Circle), Measure.map (fun χ => χ * a) m = m
@dualHaar_fourier_zero : ∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : Countable G],
  ∫ (χ : AddChar G Circle), ↑(χ 0) ∂dualHaar G = 1
unitCircle : Subfield ℝ → Subgroup Circle
@mem_unitCircle : ∀ {F : Subfield ℝ} {z : Circle}, z ∈ unitCircle F ↔ ↑z ∈ fieldI F
@toUnitVector : {F : Subfield ℝ} → ↥(unitCircle F) → ↑(unitVectors F)
@coe_toUnitVector : ∀ {F : Subfield ℝ} (g : ↥(unitCircle F)), ↑(toUnitVector g) = ↑↑g
unitCircleEquiv : (F : Subfield ℝ) → ↥(unitCircle F) ≃ ↑(unitVectors F)
uvRing_toUnitVector_mul : ∀ (F : Subfield ℝ) (g h : ↥(unitCircle F)),
  uvRing (toUnitVector (g * h)) = uvRing (toUnitVector g) * uvRing (toUnitVector h)
uvRing_toUnitVector_one : ∀ (F : Subfield ℝ), uvRing (toUnitVector 1) = 1
mulAction_dual : (F : Subfield ℝ) → MulAction (↥(unitCircle F)) (Dual F)
@smul_def : ∀ {F : Subfield ℝ} (g : ↥(unitCircle F)) (χ : Dual F), g • χ = rot (toUnitVector g) χ
@measurableConstSMul_dual : ∀ {F : Subfield ℝ}, MeasurableConstSMul (↥(unitCircle F)) (Dual F)
@rotInv_iff : ∀ {F : Subfield ℝ} {τ : Measure (Dual F)},
  RotInv F τ ↔ ∀ (g : ↥(unitCircle F)), Measure.map (fun x => g • x) τ = τ
