@countable_unitCircle : ∀ {F : Subfield ℝ} [NumberField ↥F], Countable ↥(unitCircle F)
@IsHaarFourier.rotInv : ∀ {F : Subfield ℝ} [NumberField ↥F] {m : Measure (Dual F)}, IsHaarFourier m → RotInv F m
@zpowHom : {F : Subfield ℝ} → ↥(unitCircle F) → ↥(unitCircle F) → Multiplicative (Fin 2 → ℤ) →* ↥(unitCircle F)
AdmissiblePair : Subfield ℝ → Type
@AdmissiblePair.subgroup : {F : Subfield ℝ} → AdmissiblePair F → Subgroup ↥(unitCircle F)
@AdmissiblePair.mem_subgroup : ∀ {F : Subfield ℝ} (p : AdmissiblePair F) {g : ↥(unitCircle F)},
  g ∈ p.subgroup ↔ ∃ n, (zpowHom p.u p.w) (Multiplicative.ofAdd n) = g
@AdmissiblePair.u_nonTorsion : ∀ {F : Subfield ℝ} (p : AdmissiblePair F) (k : ℕ), k ≠ 0 → ↑(toUnitVector p.u) ^ k ≠ 1
@AdmissiblePair.ofPow : {F : Subfield ℝ} →
  (u w : ↥(unitCircle F)) →
    Function.Injective ⇑(zpowHom u w) → (∀ (k : ℕ), 0 < k → Subfield.closure {↑↑w ^ k} = fieldI F) → AdmissiblePair F
@exists_admissiblePair : ∀ {F : Subfield ℝ} [NumberField ↥F], Nonempty (AdmissiblePair F)
PieceDual : (M : Type u_1) → [AddCommGroup M] → Type u_1
PieceDual.ofChar : (M : Type u_1) → [inst : AddCommGroup M] → AddChar M Circle ≃ PieceDual M
@PieceDual.dualMap : {M : Type u_1} → [inst : AddCommGroup M] → (M →+ M) → PieceDual M →+ PieceDual M
@PieceDual.dualMap_apply : ∀ {M : Type u_1} [inst : AddCommGroup M] (φ : M →+ M) (χ : PieceDual M) (x : M),
  ((PieceDual.ofChar M).symm ((PieceDual.dualMap φ) χ)) x = ((PieceDual.ofChar M).symm χ) (φ x)
@PieceDual.dualMap_id : ∀ {M : Type u_1} [inst : AddCommGroup M],
  PieceDual.dualMap (AddMonoidHom.id M) = AddMonoidHom.id (PieceDual M)
@PieceDual.dualMap_comp : ∀ {M : Type u_1} [inst : AddCommGroup M] (φ ψ : M →+ M),
  PieceDual.dualMap (φ.comp ψ) = (PieceDual.dualMap ψ).comp (PieceDual.dualMap φ)
@PieceDual.continuous_dualMap : ∀ {M : Type u_1} [inst : AddCommGroup M] (φ : M →+ M), Continuous ⇑(PieceDual.dualMap φ)
@toPiece : {F : Subfield ℝ} → (M : AddSubgroup ↥(unitRing F)) → Dual F → PieceDual ↥M
@measurable_toPiece : ∀ {F : Subfield ℝ} (M : AddSubgroup ↥(unitRing F)), Measurable (toPiece M)
@AdmissiblePair.mulR : {F : Subfield ℝ} → AdmissiblePair F → (Fin 2 → ℤ) → ↥(unitRing F) →+ ↥(unitRing F)
@IsPiece : {F : Subfield ℝ} → AdmissiblePair F → AddSubgroup ↥(unitRing F) → Prop
@IsPiece.mulR_mem : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : AddSubgroup ↥(unitRing F)},
  IsPiece p M → ∀ (n : Fin 2 → ℤ) {x : ↥(unitRing F)}, x ∈ M → (p.mulR n) x ∈ M
@pieceMul : {F : Subfield ℝ} →
  {p : AdmissiblePair F} → {M : AddSubgroup ↥(unitRing F)} → IsPiece p M → (Fin 2 → ℤ) → ↥M →+ ↥M
@pieceMul_zero : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : AddSubgroup ↥(unitRing F)} (hM : IsPiece p M),
  pieceMul hM 0 = AddMonoidHom.id ↥M
@pieceMul_add : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : AddSubgroup ↥(unitRing F)} (hM : IsPiece p M)
  (m n : Fin 2 → ℤ), pieceMul hM (m + n) = (pieceMul hM n).comp (pieceMul hM m)
@pieceAction : {F : Subfield ℝ} →
  {p : AdmissiblePair F} → {M : AddSubgroup ↥(unitRing F)} → IsPiece p M → ZdAction 2 (PieceDual ↥M)
@toPiece_rot : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : AddSubgroup ↥(unitRing F)} (hM : IsPiece p M)
  (n : Fin 2 → ℤ) (χ : Dual F),
  toPiece M (rot (toUnitVector ((zpowHom p.u p.w) (Multiplicative.ofAdd n))) χ) =
    ((pieceAction hM).toFun n) (toPiece M χ)
