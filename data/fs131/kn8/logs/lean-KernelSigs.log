  IsPiece p M → IsSolenoid (PieceDual ↥M)
@isTotallyIrreducible_pieceAction : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} [NumberField ↥F]
  {M : AddSubgroup ↥(unitRing F)} (hM : IsPiece p M), (pieceAction hM).IsTotallyIrreducible
@not_isVirtuallyCyclic_pieceAction : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : AddSubgroup ↥(unitRing F)}
  (hM : IsPiece p M), ¬(pieceAction hM).IsVirtuallyCyclic
@isPiece_closure_one : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} [NumberField ↥F],
  IsPiece p (AddSubgroup.closure {y | ∃ n, ∃ x ∈ {1}, y = (p.mulR n) x})
@exists_pieceChain : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} [NumberField ↥F],
  ∃ M, Monotone M ∧ ∃ (_ : ∀ (k : ℕ), IsPiece p (M k)), ∀ (r : ↥(unitRing F)), ∃ k, r ∈ M k
@isErgodicOn_map_toPiece : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : AddSubgroup ↥(unitRing F)} (hM : IsPiece p M)
  {ρ : Measure (Dual F)} [IsProbabilityMeasure ρ],
  ErgodicSMul (↥p.subgroup) (Dual F) ρ → (pieceAction hM).IsErgodicOn ⊤ (Measure.map (toPiece M) ρ)
@ksEntropy_rot_eq_iSup : ∀ {F : Subfield ℝ} {p : AdmissiblePair F} {M : ℕ → AddSubgroup ↥(unitRing F)},
  Monotone M →
    ∀ (hM : ∀ (k : ℕ), IsPiece p (M k)),
      (∀ (r : ↥(unitRing F)), ∃ k, r ∈ M k) →
        ∀ {ρ : Measure (Dual F)} [IsProbabilityMeasure ρ],
          ErgodicSMul (↥p.subgroup) (Dual F) ρ →
            ∀ (n : Fin 2 → ℤ),
              ksEntropy ρ (rot (toUnitVector ((zpowHom p.u p.w) (Multiplicative.ofAdd n)))) =
                ⨆ k, ksEntropy (Measure.map (toPiece (M k)) ρ) ⇑((pieceAction ⋯).toFun n)
@integral_eq_zero_of_isAddHaarMeasure : ∀ {F : Subfield ℝ} {M : AddSubgroup ↥(unitRing F)} {ρ : Measure (Dual F)}
  [IsProbabilityMeasure ρ],
  (Measure.map (toPiece M) ρ).IsAddHaarMeasure → ∀ {r : ↥(unitRing F)}, r ∈ M → r ≠ 0 → ∫ (χ : Dual F), ↑(χ r) ∂ρ = 0
@isHaarFourier_or_ksEntropy_eq_zero : ∀ {F : Subfield ℝ} [NumberField ↥F] (p : AdmissiblePair F) (ρ : Measure (Dual F))
  [IsProbabilityMeasure ρ],
  ErgodicSMul (↥p.subgroup) (Dual F) ρ → IsHaarFourier ρ ∨ ∀ g ∈ p.subgroup, ksEntropy ρ (rot (toUnitVector g)) = 0
invariantSigma : (H : Type u_1) →
  (Y : Type u_2) → [inst : Group H] → [MulAction H Y] → [MeasurableSpace Y] → MeasurableSpace Y
invariantSigma_le : ∀ (H : Type u_1) (Y : Type u_2) [inst : Group H] [inst_1 : MulAction H Y] [mY : MeasurableSpace Y],
  invariantSigma H Y ≤ mY
@condExpKernel_ergodicDecomposition : ∀ {H : Type u_1} {Y : Type u_2} [inst : Group H] [Countable H]
  [inst_2 : MulAction H Y] [inst_3 : MeasurableSpace Y] [inst_4 : StandardBorelSpace Y] [Nonempty Y] (μ : Measure Y)
  [inst_6 : IsProbabilityMeasure μ],
  (∀ (g : H), MeasurePreserving (fun y => g • y) μ μ) →
    ⇑(condExpKernel μ (invariantSigma H Y)) ∘ₘ μ.trim ⋯ = μ ∧
      ∀ᵐ (x : Y) ∂μ.trim ⋯, ErgodicSMul H Y ((condExpKernel μ (invariantSigma H Y)) x)
@rotInv_sub_maxMultiple : ∀ {F : Subfield ℝ} [NumberField ↥F] (τ : Measure (Dual F)) [IsFiniteMeasure τ],
  RotInv F τ → ∀ {m : Measure (Dual F)}, IsHaarFourier m → RotInv F (τ - maxMultiple τ m • m)
@haarSet : {F : Subfield ℝ} → (Dual F → Measure (Dual F)) → Set (Dual F)
@measure_haarSet_eq_zero : ∀ {F : Subfield ℝ} [inst : NumberField ↥F] (p : AdmissiblePair F) (ν : Measure (Dual F))
  [inst_1 : IsProbabilityMeasure ν],
  (∀ (g : ↥p.subgroup), MeasurePreserving (fun χ => g • χ) ν ν) →
    ∀ {m : Measure (Dual F)},
      IsHaarFourier m →
        (∀ (c : ℝ≥0∞), c ≠ 0 → ¬c • m ≤ ν) → ν (haarSet ⇑(condExpKernel ν (invariantSigma (↥p.subgroup) (Dual F)))) = 0
@ksEntropy_eq_zero_of_not_smul_le : ∀ {F : Subfield ℝ} [NumberField ↥F] (p : AdmissiblePair F) (ν : Measure (Dual F))
  [IsProbabilityMeasure ν],
  (∀ (g : ↥p.subgroup), MeasurePreserving (fun χ => g • χ) ν ν) →
    ∀ {m : Measure (Dual F)},
      IsHaarFourier m → (∀ (c : ℝ≥0∞), c ≠ 0 → ¬c • m ≤ ν) → ∀ g ∈ p.subgroup, ksEntropy ν (rot (toUnitVector g)) = 0
@entropySplit_of_admissiblePair : ∀ {F : Subfield ℝ} [NumberField ↥F] (p : AdmissiblePair F), EntropySplit F
@not_smul_dualHaar_le_dirac_one : ∀ {F : Subfield ℝ} [inst : NumberField ↥F] (c : ℝ≥0∞),
  c ≠ 0 → ¬c • dualHaar ↥(unitRing F) ≤ Measure.dirac 1
