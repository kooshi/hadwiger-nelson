                F.IsRingArc p (ψ + Real.pi / 3 - ℓ) (ψ + Real.pi / 3) a a' →
                  F.IsRingArc p (ψ - Real.pi / 3) (ψ - Real.pi / 3 + m) a' a →
                    a ∈ F.coloursAt p →
