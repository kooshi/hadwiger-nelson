@semiHub_places : ∀ {k : ℕ} {F : ArcMap k},
  F.Valid →
    F.NonSiamese →
      ∀ {p : ℂ},
        F.Covers p 1 →
          ∀ {ψ : ℝ},
            F.SimpleOn {p, ringPt p ψ, ringPt p (ψ + Real.pi / 3), ringPt p (ψ - Real.pi / 3)} →
              4 ≤ (F.coloursAt p).ncard →
                k ≤ (F.coloursAt p).ncard + 2 →
                  ∀ {kind : SemiKind},
                    F.IsSemiHub p ψ kind →
                      4 ≤ (F.coloursAt (ringPt p ψ)).ncard ∨
                        ((F.coloursAt (ringPt p ψ)).ncard = 3 ∧
                            ∃ w,
                              (w = ringPt p (ψ + Real.pi / 3) ∨ w = ringPt p (ψ - Real.pi / 3)) ∧
                                (∃ θ₁ θ₂, F.BothKind w θ₁ θ₂ ∧ ringPt p ψ ∈ ringArc w θ₁ θ₂) ∧
                                  4 ≤ (F.coloursAt w).ncard) ∨
                          (F.coloursAt (ringPt p ψ)).ncard = 3 ∧
                            F.IsFullSemiHub p ψ kind ∧
                              ∃ a a',
                                F.GermOnQWith p (ψ + Real.pi / 3) kind.qSide a a' ∧
                                  F.GermOnQWith p (ψ - Real.pi / 3) kind.qSide.flip a' a ∧
                                    ∃ c T,
                                      F.TileOf c T ∧
                                        p ∈ closure T ∧
                                          F.coloursAt (ringPt p ψ) = (F.coloursAt p)ᶜ ∪ {c} ∧
                                            (kind = SemiKind.O →
                                                angleIcc (ψ + 5 * Real.pi / 6) (ψ + 7 * Real.pi / 6) ⊆ coneAt T p) ∧
                                              (kind = SemiKind.T →
                                                angleIcc (ψ - Real.pi / 6) (ψ + Real.pi / 6) ⊆ coneAt T p)
