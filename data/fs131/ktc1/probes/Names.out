@ThreeColour.Winding.exists_box_point : ∀ {A : Type u_1} [inst : AddCommGroup A] {m : ℕ} {s : Fin m → A}
  (W : ThreeColour.Winding s),
  ∃ x,
    (∀ (j : Fin m), x j ∈ Set.Icc (1 / 3) (2 / 3)) ∧
      ∀ (r : ↥(ThreeColour.relMap s).ker), ∑ j, ↑(↑r j) * x j = ↑(W.toHom r)
@ThreeColour.wind_shift : ∀ {A : Type u_1} [inst : AddCommGroup A] {m : ℕ} (s : Fin m → A) {c : A → ZMod 3},
  ThreeColour.ProperAlong s c →
    ∀ {u v : Fin m → ℕ},
      ThreeColour.wsum s (ThreeColour.word u) = ThreeColour.wsum s (ThreeColour.word v) →
        ∀ (a : A) (l : List (Fin m)), ThreeColour.wind s c (a + ThreeColour.wsum s l) u v = ThreeColour.wind s c a u v
@ThreeColour.height_perm : ∀ {A : Type u_1} [inst : AddCommGroup A] {m : ℕ} (s : Fin m → A) {c : A → ZMod 3},
  ThreeColour.ProperAlong s c →
    ∀ {l l' : List (Fin m)}, l.Perm l' → ∀ (a : A), ThreeColour.height s c a l = ThreeColour.height s c a l'
