{"result": [{"biographic_references": [], "contributors": {"authors": [{"aliases": [], "checked": "0", "codes": ["ducz.akos"], "name": "\u00c1kos D\u00facz"}], "author_references": [], "editors": []}, "database": "arXiv", "datestamp": "0001-01-01T00:00:00Z", "document_type": {"code": null, "description": null}, "editorial_contributions": [{"language": null, "reviewer": {"author_code": null, "reviewer_id": null, "name": null, "sign": null}, "text": "Summary: In arXiv:2311.10069, Matolcsi et al. show that the fractional chromatic number of the plane is at least 4. Their proof uses a 27-vertex unit-distance graph in the Moser lattice, with geometric fractional chromatic number exactly 4. We show that this bound is tight for graphs in the Moser lattice by exhibiting geometric 4-colorings of the entire lattice. The same colorings also extend to the entire Moser ring.", "contribution_type": "summary"}], "id": 903071605, "identifier": "arXiv:2606.12325", "keywords": [], "language": {"languages": [], "addition": [null]}, "license": ["http://creativecommons.org/licenses/by/4.0/"], "links": [{"identifier": "2606.12325", "type": "arxiv", "url": "https://arxiv.org/abs/2606.12325"}], "msc": [{"code": "05C15", "scheme": "msc2020", "text": "Coloring of graphs and hypergraphs"}], "references": [], "source": {"book": [], "pages": null, "series": [], "source": "Preprint, arXiv:2606.12325 [math.CO] (2026)"}, "states": [["o", "has open version"], ["s", "item with single author"]], "title": {"addition": null, "original": null, "subtitle": null, "title": "A note on geometric colorings of the Moser lattice"}, "year": "2026", "zbmath_url": "https://zbmath.org/903071605"}], "status": {"execution": "successful request", "execution_bool": true, "internal_code": "ok", "last_id": null, "nr_total_results": 1, "nr_request_results": 1, "query_execution_time_in_seconds": 0.05643510818481445, "status_code": 200, "time_stamp": "2026-09-24T23:40:57Z"}}