structure HadwigerNelson.SixRing.FourCycleStraddle (c : ℂ → Fin 6) (p : ℂ) (a : Fin 4 → Fin 6) (K : Fin 4 → Set ℂ) :
  Prop
number of parameters: 4
fields:
  HadwigerNelson.SixRing.FourCycleStraddle.compact : ∀ (j : Fin 4), IsCompact (K j)
  HadwigerNelson.SixRing.FourCycleStraddle.centre_mem : ∀ (j : Fin 4), p ∈ K j
  HadwigerNelson.SixRing.FourCycleStraddle.other : ∀ (j : Fin 4), ∃ q ∈ K j, q ≠ p
  HadwigerNelson.SixRing.FourCycleStraddle.left : ∀ (j : Fin 4), Disjoint (spatialSupport c (a j)) (Straddle (K j))
  HadwigerNelson.SixRing.FourCycleStraddle.right : ∀ (j : Fin 4),
      Disjoint (spatialSupport c (a (j + 1))) (Straddle (K j))
constructor:
  HadwigerNelson.SixRing.FourCycleStraddle.mk {c : ℂ → Fin 6} {p : ℂ} {a : Fin 4 → Fin 6} {K : Fin 4 → Set ℂ}
    (compact : ∀ (j : Fin 4), IsCompact (K j)) (centre_mem : ∀ (j : Fin 4), p ∈ K j)
    (other : ∀ (j : Fin 4), ∃ q ∈ K j, q ≠ p) (left : ∀ (j : Fin 4), Disjoint (spatialSupport c (a j)) (Straddle (K j)))
    (right : ∀ (j : Fin 4), Disjoint (spatialSupport c (a (j + 1))) (Straddle (K j))) : FourCycleStraddle c p a K
structure HadwigerNelson.SixRing.OutsideOrbit {k : ℕ} (c : ℂ → Fin k) (hc : Measurable c) (p : ℂ) (X Y : Fin k)
  (ψ δ : ℝ) : Prop
number of parameters: 8
fields:
  HadwigerNelson.SixRing.OutsideOrbit.pos : 0 < δ
  HadwigerNelson.SixRing.OutsideOrbit.outside : ∀ (n : ℤ),
      ∀ᵐ (θ : ℝ), |θ - ψ - ↑n * (Real.pi / 3)| < δ → X ∈ palette c hc p ↑θ ∨ Y ∈ palette c hc p ↑θ
  HadwigerNelson.SixRing.OutsideOrbit.change : ∀ (η : ℝ),
      0 < η →
        0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ X ∈ palette c hc p ↑θ} ∧
          0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ Y ∈ palette c hc p ↑θ}
constructor:
  HadwigerNelson.SixRing.OutsideOrbit.mk {k : ℕ} {c : ℂ → Fin k} {hc : Measurable c} {p : ℂ} {X Y : Fin k} {ψ δ : ℝ}
    (pos : 0 < δ)
    (outside : ∀ (n : ℤ), ∀ᵐ (θ : ℝ), |θ - ψ - ↑n * (Real.pi / 3)| < δ → X ∈ palette c hc p ↑θ ∨ Y ∈ palette c hc p ↑θ)
    (change :
      ∀ (η : ℝ),
        0 < η →
          0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ X ∈ palette c hc p ↑θ} ∧
            0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ Y ∈ palette c hc p ↑θ}) :
    OutsideOrbit c hc p X Y ψ δ
def HadwigerNelson.Outside.OAI158.WeakColoring : (k : ℕ) → (ℂ → Fin k) → Prop :=
fun k c =>
  AEMeasurable c MeasureTheory.volume ∧
    ∀ᵐ (p : ℂ × Angles) ∂MeasureTheory.volume.prod angularMeasure, c p.1 ≠ c (p.1 + direction p.2)
def HadwigerNelson.Outside.OAI158.Straddle : Set ℂ → Set ℂ :=
fun K => {z | ∃ p ∈ K, ∃ q ∈ K, dist z p < 1 ∧ 1 < dist z q}
def HadwigerNelson.Outside.OAI158.spatialSupport : {k : ℕ} → (ℂ → Fin k) → Fin k → Set ℂ :=
fun {k} c i => (MeasureTheory.volume.restrict {z | c z = i}).support
def HadwigerNelson.SixRing.IsTip : {k : ℕ} → (ℂ → Fin k) → ℂ → ℂ → Fin k → Prop :=
fun {k} c p y i => y ∈ closure (spatialSupport c i ∩ Metric.ball p 1)
def HadwigerNelson.SixRing.hub : ℂ → ℝ → ℤ → ℂ :=
fun p ψ n => p + Plane.e (ψ + ↑n * (Real.pi / 3))
def HadwigerNelson.Outside.OAI158.sixty : ℝ :=
Real.pi / 3
@palette : {k : ℕ} → (c : ℂ → Fin k) → Measurable c → ℂ → Angles → Finset (Fin k)
angularMeasure : MeasureTheory.Measure Angles
proper_to_borel_weak_model : (∃ c, ProperColoring 7 c) ∧ ∃ d, Measurable d ∧ WeakColoring 7 d
shiftBounds_model : ShiftBounds (fun d d' => d * d' / 16) (1 / 2)
exists_shiftBounds : ∃ κ, 0 < κ ∧ κ ≤ 1 / 4 ∧ ShiftBounds SixRing.shift κ
@exists_weakColoring_iff_nonempty_aeColouring : ∀ {k : ℕ},
  (∃ d, Measurable d ∧ WeakColoring k d) ↔ Nonempty (Plane.AeColouring k)
