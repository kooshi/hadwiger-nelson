@no_outside_orbit_points : ∀ {c : ℂ → Fin 6} (hc : Measurable c),
  WeakColoring 6 c →
    ∀ {p : ℂ} {a : Fin 4 → Fin 6},
      Function.Injective a →
        ∀ {X Y : Fin 6},
          X ≠ Y →
            (∀ (j : Fin 4), a j ≠ X) →
              (∀ (j : Fin 4), a j ≠ Y) →
                ∀ {q : Fin 4 → ℂ},
                  (∀ (j : Fin 4), q j ≠ p) →
                    (∀ (j : Fin 4), Disjoint (spatialSupport c (a j)) (Straddle {p, q j})) →
                      (∀ (j : Fin 4), Disjoint (spatialSupport c (a (j + 1))) (Straddle {p, q j})) →
                        ∀ (ψ δ : ℝ),
                          0 < δ →
                            (∀ (k : ℤ),
                                ∀ᵐ (θ : ℝ),
                                  |θ - ψ - ↑k * (Real.pi / 3)| < δ → X ∈ palette c hc p ↑θ ∨ Y ∈ palette c hc p ↑θ) →
                              (∀ (η : ℝ),
                                  0 < η →
                                    0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ X ∈ palette c hc p ↑θ} ∧
                                      0 <
                                        MeasureTheory.volume
                                          {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ Y ∈ palette c hc p ↑θ}) →
                                False
@no_outside_orbit : ∀ {c : ℂ → Fin 6} (hc : Measurable c),
  WeakColoring 6 c →
    ∀ {p : ℂ} {a : Fin 4 → Fin 6},
      Function.Injective a →
        ∀ {X Y : Fin 6},
          X ≠ Y →
            (∀ (j : Fin 4), a j ≠ X) →
              (∀ (j : Fin 4), a j ≠ Y) →
                ∀ {K : Fin 4 → Set ℂ},
                  FourCycleStraddle c p a K →
                    ∀ (ψ δ : ℝ),
                      0 < δ →
                        (∀ (k : ℤ),
                            ∀ᵐ (θ : ℝ),
                              |θ - ψ - ↑k * (Real.pi / 3)| < δ → X ∈ palette c hc p ↑θ ∨ Y ∈ palette c hc p ↑θ) →
                          (∀ (η : ℝ),
                              0 < η →
                                0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ X ∈ palette c hc p ↑θ} ∧
                                  0 < MeasureTheory.volume {θ | θ ∈ Set.Ioo (ψ - η) (ψ + η) ∧ Y ∈ palette c hc p ↑θ}) →
                            False
@not_ae_outside : ∀ {c : ℂ → Fin 6} (hc : Measurable c),
  WeakColoring 6 c →
    ∀ {p : ℂ} {a : Fin 4 → Fin 6},
      Function.Injective a →
        ∀ {X Y : Fin 6},
          X ≠ Y →
            (∀ (j : Fin 4), a j ≠ X) →
              (∀ (j : Fin 4), a j ≠ Y) →
                ∀ {K : Fin 4 → Set ℂ},
                  FourCycleStraddle c p a K →
                    ¬∀ᵐ (t : Angles) ∂angularMeasure, X ∈ palette c hc p t ∨ Y ∈ palette c hc p t
@not_ae_outside_points : ∀ {c : ℂ → Fin 6} (hc : Measurable c),
  WeakColoring 6 c →
    ∀ {p : ℂ} {a : Fin 4 → Fin 6},
      Function.Injective a →
        ∀ {X Y : Fin 6},
          X ≠ Y →
            (∀ (j : Fin 4), a j ≠ X) →
              (∀ (j : Fin 4), a j ≠ Y) →
                ∀ {q : Fin 4 → ℂ},
                  (∀ (j : Fin 4), q j ≠ p) →
                    (∀ (j : Fin 4), Disjoint (spatialSupport c (a j)) (Straddle {p, q j})) →
                      (∀ (j : Fin 4), Disjoint (spatialSupport c (a (j + 1))) (Straddle {p, q j})) →
                        ¬∀ᵐ (t : Angles) ∂angularMeasure, X ∈ palette c hc p t ∨ Y ∈ palette c hc p t
@no_alternating_pairs : ∀ {c : ℂ → Fin 6} (hc : Measurable c),
  WeakColoring 6 c →
    ∀ (p : ℂ) {D D' : Finset (Fin 6)},
      D.card = 2 →
        D'.card = 2 →
          Disjoint D D' →
            ∀ (w : Angles → Bool),
              Measurable w →
                (∀ᵐ (t : Angles) ∂angularMeasure, (if w t = true then D' else D) ⊆ palette c hc p t) →
                  (∀ᵐ (t : Angles) ∂angularMeasure, w (t + ↑sixty) ≠ w t) → False
@no_alternating_groups : ∀ {k : ℕ} {c : ℂ → Fin k} (hc : Measurable c),
  WeakColoring k c →
    ∀ (p : ℂ) {J K : Finset (Fin k)},
      (Finset.univ \ (J ∪ K)).card ≤ 2 →
        ∀ (w : Angles → Bool),
          Measurable w →
            (∀ᵐ (t : Angles) ∂angularMeasure, (if w t = true then K else J) ⊆ palette c hc p t) →
              (∀ᵐ (t : Angles) ∂angularMeasure, w (t + ↑sixty) ≠ w t) → False
@adjacent_tip_false : ∀ {k : ℕ} {c : ℂ → Fin k} (hc : Measurable c),
  WeakColoring k c →
    ∀ {p : ℂ} {X Y : Fin k} {ψ δ : ℝ},
      OutsideOrbit c hc p X Y ψ δ →
        ∀ (n : ℤ) {b : Fin k},
          (∀ (i : Fin k), i ≠ b → i ≠ X → i ≠ Y → ¬IsTip c p (hub p ψ n) i) →
            (∀ (i : Fin k), i ≠ b → i ≠ X → i ≠ Y → ¬IsTip c p (hub p ψ (n + 1)) i) → False
@chart_step_false : ∀ {k : ℕ} {c : ℂ → Fin k},
  Measurable c →
    WeakColoring k c →
      ∀ (p : ℂ) {b X Y : Fin k} {S : Set ℝ},
        MeasurableSet S →
          ∀ {t κ : ℝ},
            0 < κ →
              (∀ (η : ℝ),
                  0 < η →
                    0 < MeasureTheory.volume (S ∩ Set.Ioo (t - η) (t + η)) ∧
                      0 < MeasureTheory.volume (Sᶜ ∩ Set.Ioo (t - η) (t + η))) →
                HubColours c p b X Y S t κ → HubColours c p b X Y {θ | θ - Real.pi / 3 ∉ S} (t + Real.pi / 3) κ → False
