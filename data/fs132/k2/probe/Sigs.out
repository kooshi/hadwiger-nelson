'HadwigerNelson.SixRing.exists_shiftBounds' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
'HadwigerNelson.SixRing.shiftBounds_model' depends on axioms: [propext, Classical.choice, Quot.sound]
