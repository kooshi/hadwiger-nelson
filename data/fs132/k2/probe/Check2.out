@LipschitzOnWith.hausdorffMeasure_image_le : ∀ {X : Type u_1} {Y : Type u_2} [inst : EMetricSpace X]
  [inst_1 : EMetricSpace Y] [inst_2 : MeasurableSpace X] [inst_3 : BorelSpace X] [inst_4 : MeasurableSpace Y]
  [inst_5 : BorelSpace Y] {K : NNReal} {f : X → Y} {s : Set X},
  LipschitzOnWith K f s → ∀ {d : ℝ}, 0 ≤ d → μH[d] (f '' s) ≤ ↑K ^ d * μH[d] s
@AntilipschitzWith.le_hausdorffMeasure_image : ∀ {X : Type u_1} {Y : Type u_2} [inst : EMetricSpace X]
  [inst_1 : EMetricSpace Y] [inst_2 : MeasurableSpace X] [inst_3 : BorelSpace X] [inst_4 : MeasurableSpace Y]
  [inst_5 : BorelSpace Y] {f : X → Y} {K : NNReal} {d : ℝ},
  AntilipschitzWith K f → 0 ≤ d → ∀ (s : Set X), μH[d] s ≤ ↑K ^ d * μH[d] (f '' s)
hausdorffMeasure_real : μH[1] = volume
@contDiffAt_arccos : ∀ {x : ℝ}, x ≠ -1 → x ≠ 1 → ∀ {n : WithTop ℕ∞}, ContDiffAt ℝ n arccos x
@hasStrictDerivAt_arccos : ∀ {x : ℝ}, x ≠ -1 → x ≠ 1 → HasStrictDerivAt arccos (-(1 / √(1 - x ^ 2))) x
@MeasurePreserving.quasiMeasurePreserving : ∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : MeasurableSpace β] {μa : Measure α} {μb : Measure β} {f : α → β},
  MeasurePreserving f μa μb → Measure.QuasiMeasurePreserving f μa μb
@AddCircle.measurable_mk' : ∀ {a : ℝ}, Measurable QuotientAddGroup.mk
volume_closedBall : ∀ (a r : ℝ), volume (Metric.closedBall a r) = ENNReal.ofReal (2 * r)
@Measure.exists_mem_of_measure_ne_zero_of_ae : ∀ {α : Type u_1} {m0 : MeasurableSpace α} {μ : Measure α} {s : Set α},
  μ s ≠ 0 → ∀ {p : α → Prop}, (∀ᵐ (x : α) ∂μ.restrict s, p x) → ∃ x ∈ s, p x
@Measure.QuasiMeasurePreserving.comp : ∀ {α : Type u_1} {β : Type u_2} {γ : Type u_3} {mα : MeasurableSpace α}
  {mβ : MeasurableSpace β} {mγ : MeasurableSpace γ} {μa : Measure α} {μb : Measure β} {μc : Measure γ} {g : β → γ}
  {f : α → β},
  Measure.QuasiMeasurePreserving g μb μc →
    Measure.QuasiMeasurePreserving f μa μb → Measure.QuasiMeasurePreserving (g ∘ f) μa μc
@Measure.prod_apply : ∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α] [inst_1 : MeasurableSpace β]
  {μ : Measure α} {ν : Measure β} [SFinite ν] {s : Set (α × β)},
  MeasurableSet s → (μ.prod ν) s = ∫⁻ (x : α), ν (Prod.mk x ⁻¹' s) ∂μ
@ContDiffAt.exists_lipschitzOnWith : ∀ {𝕂 : Type u_1} [inst : RCLike 𝕂] {E' : Type u_2} [inst_1 : NormedAddCommGroup E']
  [inst_2 : NormedSpace 𝕂 E'] {F' : Type u_3} [inst_3 : NormedAddCommGroup F'] [inst_4 : NormedSpace 𝕂 F'] {f : E' → F'}
  {x : E'}, ContDiffAt 𝕂 1 f x → ∃ K, ∃ t ∈ nhds x, LipschitzOnWith K f t
@ContDiffAt.hasStrictFDerivAt : ∀ {n : WithTop ℕ∞} {𝕂 : Type u_1} [inst : RCLike 𝕂] {E' : Type u_2}
  [inst_1 : NormedAddCommGroup E'] [inst_2 : NormedSpace 𝕂 E'] {F' : Type u_3} [inst_3 : NormedAddCommGroup F']
  [inst_4 : NormedSpace 𝕂 F'] {f : E' → F'} {x : E'}, ContDiffAt 𝕂 n f x → n ≠ 0 → HasStrictFDerivAt f (fderiv 𝕂 f x) x
@Convex.lipschitzOnWith_of_nnnorm_fderiv_le : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  {𝕜 : Type u_2} {G : Type u_3} [inst_2 : NontriviallyNormedField 𝕜] [IsRCLikeNormedField 𝕜] [inst_4 : NormedSpace 𝕜 E]
  [inst_5 : NormedAddCommGroup G] [inst_6 : NormedSpace 𝕜 G] {f : E → G} {s : Set E} {C : NNReal},
  (∀ x ∈ s, DifferentiableAt 𝕜 f x) → (∀ x ∈ s, ‖fderiv 𝕜 f x‖₊ ≤ C) → Convex ℝ s → LipschitzOnWith C f s
cos_pi_div_three : cos (π / 3) = 1 / 2
cos_add : ∀ (x y : ℝ), cos (x + y) = cos x * cos y - sin x * sin y
@inner_neg_right : ∀ {𝕜 : Type u_1} {E : Type u_2} [inst : RCLike 𝕜] [inst_1 : SeminormedAddCommGroup E]
  [inst_2 : InnerProductSpace 𝕜 E] (x y : E), inner 𝕜 x (-y) = -inner 𝕜 x y
@closure_minimal : ∀ {X : Type u_1} [inst : TopologicalSpace X] {s t : Set X}, s ⊆ t → IsClosed t → closure s ⊆ t
@Finset.card_image_of_injective : ∀ {α : Type u_1} {β : Type u_2} {f : α → β} [inst : DecidableEq β] (s : Finset α),
  Function.Injective f → (Finset.image f s).card = s.card
@Finset.card_le_card : ∀ {α : Type u_1} {s t : Finset α}, s ⊆ t → s.card ≤ t.card
HadwigerNelson.Plane.e_add_e_eq : ∀ (α θ : ℝ),
  HadwigerNelson.Plane.e α + HadwigerNelson.Plane.e θ = ↑(2 * cos ((θ - α) / 2)) * HadwigerNelson.Plane.e ((α + θ) / 2)
HadwigerNelson.Plane.norm_e_add_e_sq : ∀ (a b : ℝ),
  ‖HadwigerNelson.Plane.e a + HadwigerNelson.Plane.e b‖ ^ 2 = 2 + 2 * cos (a - b)
strictAntiOn_cos : StrictAntiOn cos (Set.Icc 0 π)
@Measure.ae_ae_of_ae_prod : ∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α] [inst_1 : MeasurableSpace β]
  {μ : Measure α} {ν : Measure β} [SFinite ν] {p : α × β → Prop},
  (∀ᵐ (z : α × β) ∂μ.prod ν, p z) → ∀ᵐ (x : α) ∂μ, ∀ᵐ (y : β) ∂ν, p (x, y)
@measure_inter_add_sdiff : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} {t : Set α} (s : Set α),
  MeasurableSet t → μ (s ∩ t) + μ (s \ t) = μ s
@Besicovitch.ae_tendsto_measure_inter_div : ∀ {β : Type u_1} [inst : MetricSpace β] [inst_1 : MeasurableSpace β]
  [BorelSpace β] [SecondCountableTopology β] [HasBesicovitchCovering β] (μ : Measure β) [IsLocallyFiniteMeasure μ]
  (s : Set β),
  ∀ᵐ (x : β) ∂μ.restrict s,
    Filter.Tendsto (fun r => μ (s ∩ Metric.closedBall x r) / μ (Metric.closedBall x r)) (nhdsWithin 0 (Set.Ioi 0))
      (nhds 1)
@HadwigerNelson.Plane.continuous_measure_inter_closedBall : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E] [inst_3 : MeasurableSpace E] [BorelSpace E] (μ : Measure E)
  [μ.IsAddHaarMeasure] (S : Set E) {ρ : ℝ}, 0 < ρ → Continuous fun c => μ (S ∩ Metric.closedBall c ρ)
@MeasurableSet.preimage : ∀ {α : Type u_1} {β : Type u_2} {f : α → β} {m : MeasurableSpace α} {mβ : MeasurableSpace β}
  {t : Set β}, MeasurableSet t → Measurable f → MeasurableSet (f ⁻¹' t)
@Measure.measurePreserving_sub_left : ∀ {G : Type u_1} [inst : MeasurableSpace G] [inst_1 : SubtractionMonoid G]
  [MeasurableAdd G] [MeasurableNeg G] (μ : Measure G) [μ.IsNegInvariant] [μ.IsAddLeftInvariant] (g : G),
  MeasurePreserving (fun t => g - t) μ μ
