# Lake build output — never tracked
/.lake/
**/.lake/
# Older Lake layouts
/build/
**/build/

# Local, machine-specific permissions (mirrors the source-repo convention)
.claude/settings.local.json

# Generated graph data and SAT artifacts — reproducible from tools/, never reviewed by hand
tools/*.json
*.cnf
*.lrat

# Resume state for long reductions — not evidence, and large (one file reached 29.6 MB and grows with
# the iteration count). The evidence artifact is the run's `--out` result file, which IS tracked; a
# checkpoint exists so a killed job restarts where it stopped. Small per-probe checkpoints committed
# before this rule stay tracked rather than being removed from history.
data/m62/ckpt/

# Python bytecode from tools/
__pycache__/

# The project's Python virtual environment (rebuild recipe: data/fs54/environment.md)
/.venv/

# FS-54 D4 solver checkpoints (tens of MB each; resume state, not evidence — the evidence is the run's --out record)
data/fs54/d4/ckpt/
data/fs62/q19/*.ckpt
data/fs62/q19/search.log
data/fs62/q19/cube/*.jsonl
data/fs62/q19/cube/cube78.log
data/fs62/q19/cube/*.pgid
data/fs62/q19/*.pgid
data/fs62/q19/sat78.log

# Local settings file (Kooshi, 2026-09-27). Never commit.
.env
