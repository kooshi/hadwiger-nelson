/-!
# `coreSpindle` — the weights, and the search plan that certifies them

Emitted by `tools/corespindle.py`, which is **not trusted**: `coreSpindle_noHeavy` is decided by kernel
reduction, so wrong weights or a wrong plan cannot pass. When it fails, `coreSpindle_findHeavy` in
`Instances/CoreSpindle/Diagnose.lean` names an independent set that beat the bound.
-/

namespace HadwigerNelson

/-- The 63 vertex weights, summing to 260. -/
def coreSpindleWeightList : List ℕ := [0, 2, 13, 13, 2, 0, 2, 10, 18, 10, 2, 2, 9, 9, 2, 0, 0, 0, 3, 1, 3, 1, 1, 0, 3, 8, 3, 5, 11, 7, 3, 5, 11, 0, 3, 8, 7, 3, 1, 3, 1, 1, 0, 0, 0, 4, 2, 2, 7, 5, 5, 3, 4, 5, 3, 4, 5, 7, 5, 5, 4, 2, 2]

/-- The weight of a vertex; `0` outside the table, which no consumer reaches. -/
def coreSpindleWeights (v : Fin 63) : ℕ := coreSpindleWeightList.getD v.val 0

/-- The order the search visits vertices in — heaviest first, which is worth a measured 27×.
