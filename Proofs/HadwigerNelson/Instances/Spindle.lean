/-- The 11 claimed unit-distance pairs. -/
def moserSpindleEdges : List (Fin 7 × Fin 7) :=
  [(0,1), (0,2), (0,4), (0,5), (1,2), (1,3), (2,3), (3,6), (4,5), (4,6), (5,6)]

/-- The certificate. -/
def moserSpindle : UDCert 7 where
  verts := moserSpindleVerts
  edges := moserSpindleEdges
  denom := 12

/-- Edges 0–5. -/
def moserSpindleChunk0 : List (Fin 7 × Fin 7) :=
  [(0,1), (0,2), (0,4), (0,5), (1,2), (1,3)]
theorem moserSpindleChunk0_valid : moserSpindle.ValidOn moserSpindleChunk0 = true := by decide

/-- Edges 6–10. -/
def moserSpindleChunk1 : List (Fin 7 × Fin 7) :=
  [(2,3), (3,6), (4,5), (4,6), (5,6)]
theorem moserSpindleChunk1_valid : moserSpindle.ValidOn moserSpindleChunk1 = true := by decide

/-- Every listed edge has exact squared distance `12²`, glued from the
chunks above. The chunk theorems are *cited*, never re-decided — `by decide` here would
redo every edge and double the cost. -/
theorem moserSpindle_valid : moserSpindle.Valid = true :=
  moserSpindle.valid_of_chunks [moserSpindleChunk0, moserSpindleChunk1]
    (by rfl) (by
      intro ch hch
      fin_cases hch
      exacts [moserSpindleChunk0_valid, moserSpindleChunk1_valid])

end HadwigerNelson
