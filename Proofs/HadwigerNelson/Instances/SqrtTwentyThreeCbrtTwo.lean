import Proofs.HadwigerNelson.Instances.SqrtFiveClass
import Mathlib.FieldTheory.KummerPolynomial

/-!
# `χ(ℚ(√23, ∛2)²) = 5`: the main clause at a field with a complex place (FS-131, job FS131-KCS1; skeleton)

**Read aloud, against the informal claim** (`LEDGER.md` row 123: "The complex-place case is inhabited and not reducible to
totally real fields by monotonicity: ℚ(√23, ∛2) has `L = 5` while its totally real subfields have `L ≤ 4` (X28D-CP2)";
`plans/FS100-X28D-derivation.md` § 2.3). `F23` is the subfield of `ℝ` generated by `√23` and the real cube root of 2 — a
number field of degree 6 with one chosen real embedding; its other embeddings (one more real, two complex pairs) are
invisible to the library's stable primes, and the headline asks no total reality.

* `chromaticNumber_planeOver_sqrt23_cbrt2_eq_five` — **`χ(F23²) = 5`**; `localBound_sqrt23_cbrt2_eq_five` — **`L(F23) = 5`**.
* The arithmetic: no stable prime above 2 (`23 ≡ 7 mod 8`), none with residue field `𝔽₉` (`23` no square mod 3) and **none
  with residue field `𝔽₄₉`, because `∛2 ∈ F23` and `2` is no cube mod 7** (`card_ne_sq_of_pow_eq`); the upper half at a
  degree-one prime above 11 (`23 ≡ 1`, `2 ≡ 7³ (mod 11)`).
* `localBound_sqrt23_eq_four` — **`L(ℚ(√23)) = 4`**: at the totally real subfield `ℚ(√23)` the prime 7 splits and `Γ₇`
  is four-colourable, which is why the cube root carries the five here.
* `not_isTotallyReal_F23` — `F23` has a complex place (the embedding sending `∛2` to `ω∛2`).

**Not claimed:** that `ℚ` and `ℚ(√23)` are all of `F23`'s totally real subfields (X28D's statement, a Galois-theoretic
enumeration); anything about `F23` at six colours; that the value is new mathematics.

**What rests on what.** `χ ≥ 5` and `L ≥ 5`'s use rest on the headline's two declared outside theorems; the upper half and
`L ≤ 5` on the standard three.

**Inhabitants.** `F23` is a number field (`numberField_F23`); every statement about it is closed.
-/

namespace HadwigerNelson.SqrtTwentyThreeCbrtTwo

open SpectralChain NumberField SimpleGraph SquareClass UpperHalf

/-- **A stable prime with `p²` residues is excluded by a `k`-th power**: if some `t ∈ F` has `t^k = a` and `a` is no `k`-th
power modulo `p`, no odd stable prime of `F(i)` has `p²` residues (its fixed field is `𝔽_p` and holds the residue of
`t`, an integer fixed by conjugation). -/
theorem card_ne_sq_of_pow_eq {F : Subfield ℝ} [NumberField F] (P : StablePrime F) (h2 : (2 : 𝓞 (fieldI F)) ∉ P.P)
    {p k a : ℕ} (hp : p.Prime) (ht : ∃ t : F, t ^ k = a) (ha : ∀ y : ZMod p, y ^ k ≠ a) :
    Nat.card (𝓞 (fieldI F) ⧸ P.P) ≠ p ^ 2 := by
  classical
  intro hcard
  obtain ⟨t, ht⟩ := ht
  have hk : k ≠ 0 := by
    rintro rfl
    have h1 : ((a : ℕ) : F) = 1 := by rw [← ht, pow_zero]
    have ha1 : a = 1 := by exact_mod_cast h1
    exact ha 1 (by rw [pow_zero, ha1, Nat.cast_one])
  -- the residue field, conjugation on it, and its fixed field `𝔽_p`
  haveI hmax : (P.P ^ 1).IsMaximal := by rw [pow_one]; exact P.isMaximal
  letI : Field (𝓞 (fieldI F) ⧸ P.P ^ 1) := Ideal.Quotient.field (P.P ^ 1)
  haveI : Finite (𝓞 (fieldI F) ⧸ P.P ^ 1) := Ideal.finiteQuotientOfFreeOfNeBot _ (pow_ne_zero 1 P.heightOne.ne_bot)
  set σ : (𝓞 (fieldI F) ⧸ P.P ^ 1) →+* (𝓞 (fieldI F) ⧸ P.P ^ 1) :=
    Ideal.quotientMap (P.P ^ 1) (conjO F) (P.le_comap 1) with hσdef
  have hσmk : ∀ x, σ (Ideal.Quotient.mk (P.P ^ 1) x) = Ideal.Quotient.mk (P.P ^ 1) (conjO F x) := fun x =>
    Ideal.quotientMap_mk
  have hσ : ∀ x, σ (σ x) = x := fun x => by
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [hσmk, hσmk, UpperHalf.conjO_conjO]
  obtain ⟨i, hi2, hci⟩ := UpperHalf.exists_I_integer (F := F)
  have h2k : (2 : 𝓞 (fieldI F) ⧸ P.P ^ 1) ≠ 0 := by
    rw [← map_ofNat (Ideal.Quotient.mk (P.P ^ 1)) 2, Ne, Ideal.Quotient.eq_zero_iff_mem, pow_one]; exact h2
  set ι := Ideal.Quotient.mk (P.P ^ 1) i with hιdef
  have hι : ι ^ 2 = -1 := by rw [hιdef, ← map_pow, hi2, map_neg, map_one]
  have hσι : σ ι = -ι := by rw [hιdef, hσmk, hci, map_neg]
  obtain ⟨hcard0, -⟩ := StandingFive.card_fixed_of_involution σ hσ hι hσι h2k
  set k₀ := σ.eqLocusField (RingHom.id _) with hk₀def
  have hk₀ : Nat.card k₀ = p := by
    have e : Nat.card k₀ ^ 2 = p ^ 2 := by rw [← hcard0, pow_one, hcard]
    exact Nat.pow_left_injective two_ne_zero e
  obtain ⟨e⟩ := Arith.nonempty_ringEquiv_zmod_of_card hp hk₀
  -- `t` as an integer of `F(i)` fixed by conjugation
  let tL : fieldI F := ⟨((t : ℝ) : ℂ), by simp, by simp [zero_mem]⟩
  have htR : (t : ℝ) ^ k = (a : ℝ) := by exact_mod_cast congrArg (fun x : F => (x : ℝ)) ht
  have htL : tL ^ k = (a : fieldI F) := Subtype.ext (by
    show ((t : ℝ) : ℂ) ^ k = ((a : ℕ) : ℂ)
    rw [← Complex.ofReal_pow, htR, Complex.ofReal_natCast])
  have hint : IsIntegral ℤ tL := IsIntegral.of_pow (Nat.pos_of_ne_zero hk) (by rw [htL]; exact isIntegral_natCast a)
  let tO : 𝓞 (fieldI F) := ⟨tL, hint⟩
  have htO : tO ^ k = (a : 𝓞 (fieldI F)) := RingOfIntegers.coe_injective (by rw [map_pow, map_natCast]; exact htL)
  have hcO : conjO F tO = tO := RingOfIntegers.coe_injective (Subtype.ext (Complex.conj_ofReal _))
  have hx : Ideal.Quotient.mk (P.P ^ 1) tO ∈ k₀ := by
    show σ (Ideal.Quotient.mk (P.P ^ 1) tO) = Ideal.Quotient.mk (P.P ^ 1) tO
    rw [hσmk, hcO]
  have hxk : (⟨_, hx⟩ : k₀) ^ k = (a : k₀) := by
    apply Subtype.val_injective
    show k₀.subtype (⟨_, hx⟩ ^ k) = k₀.subtype (a : k₀)
    rw [map_pow, map_natCast]
    show (Ideal.Quotient.mk (P.P ^ 1) tO) ^ k = _
    rw [← map_pow, htO, map_natCast]
  exact ha (e ⟨_, hx⟩) (by rw [← map_pow, hxk, map_natCast])

/-- **The real cube root of 2.** -/
noncomputable def cbrtTwo : ℝ := (2 : ℝ) ^ ((1 : ℝ) / 3)

/-- `(∛2)³ = 2`. -/
theorem cbrtTwo_pow_three : cbrtTwo ^ 3 = 2 := by
  unfold cbrtTwo
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
  norm_num

/-- **`ℚ(√23, ∛2) ⊂ ℝ`**: the subfield generated by `√23` and the real cube root of 2. -/
noncomputable def F23 : Subfield ℝ := Subfield.closure {Real.sqrt 23, cbrtTwo}

-- The generators lie in `F23`.
private theorem sqrt_mem_F23 : Real.sqrt 23 ∈ F23 := Subfield.subset_closure (by simp)

private theorem cbrtTwo_mem_F23 : cbrtTwo ∈ F23 := Subfield.subset_closure (by simp)

-- `∛2` is integral over `ℚ`, with minimal polynomial `X³ − 2` (no rational cube root of 2: the 2-adic valuation).
private theorem isIntegral_cbrtTwo : IsIntegral ℚ cbrtTwo := by
  refine IsIntegral.of_pow (n := 3) (by norm_num) ?_
  rw [cbrtTwo_pow_three, ← map_ofNat (algebraMap ℚ ℝ) 2]
  exact isIntegral_algebraMap

private theorem isIntegral_sqrt23 : IsIntegral ℚ (Real.sqrt 23) := by
  refine IsIntegral.of_pow (n := 2) two_pos ?_
  rw [Real.sq_sqrt (by norm_num), ← map_ofNat (algebraMap ℚ ℝ) 23]
  exact isIntegral_algebraMap

-- The residues at 11 the embedding reads: `23 ≡ 1 = 1²`.
private theorem twentyThree_ne_zero_mod_eleven : ((23 : ℕ) : ZMod 11) ≠ 0 := by decide

private theorem isSquare_twentyThree_mod_eleven : IsSquare ((23 : ℕ) : ZMod 11) := ⟨1, by decide⟩

private theorem rat_pow_three_ne_two (b : ℚ) : b ^ 3 ≠ 2 := by
  intro hb
  have h := congrArg (padicValRat 2) hb
  rw [padicValRat.pow, show (2 : ℚ) = ((2 : ℕ) : ℚ) by norm_num, padicValRat.self (by norm_num)] at h
  omega

private theorem minpoly_cbrtTwo : minpoly ℚ cbrtTwo = Polynomial.X ^ 3 - Polynomial.C 2 :=
  (minpoly.eq_of_irreducible_of_monic (X_pow_sub_C_irreducible_of_prime Nat.prime_three rat_pow_three_ne_two)
    (by simp [cbrtTwo_pow_three]) (Polynomial.monic_X_pow_sub_C 2 (by norm_num))).symm

-- **`F23` maps to any field of characteristic zero that holds a cube root `y` of 2 and a square root of 23**, with
-- `∛2 ↦ y`: first `ℚ(∛2) → L` at the root `y` of `X³ − 2`, then over `ℚ(∛2)` the square root of 23, whose minimal
-- polynomial divides `X² − 23`, split in `L`.
open IntermediateField in
private theorem exists_ringHom_F23 {L : Type*} [Field L] [CharZero L] {y s : L} (hy : y ^ 3 = 2) (hs : s ^ 2 = 23) :
    ∃ φ : F23 →+* L, φ ⟨cbrtTwo, cbrtTwo_mem_F23⟩ = y := by
  have hyroot : y ∈ (minpoly ℚ cbrtTwo).aroots L := by
    rw [Polynomial.mem_aroots, minpoly_cbrtTwo]
    refine ⟨Polynomial.X_pow_sub_C_ne_zero (by norm_num) _, ?_⟩
    simp [hy]
  let φ₀ : ℚ⟮cbrtTwo⟯ →ₐ[ℚ] L := (algHomAdjoinIntegralEquiv ℚ isIntegral_cbrtTwo).symm ⟨y, hyroot⟩
  have hφ₀ : φ₀ (AdjoinSimple.gen ℚ cbrtTwo) = y := algHomAdjoinIntegralEquiv_symm_apply_gen ℚ isIntegral_cbrtTwo _
  letI : Algebra ℚ⟮cbrtTwo⟯ L := φ₀.toRingHom.toAlgebra
  have hK : ∀ t ∈ ({Real.sqrt 23} : Set ℝ), IsIntegral ℚ⟮cbrtTwo⟯ t ∧
      ((minpoly ℚ⟮cbrtTwo⟯ t).map (algebraMap ℚ⟮cbrtTwo⟯ L)).Splits := by
    rintro t rfl
    refine ⟨isIntegral_sqrt23.tower_top, ?_⟩
    have hdvd : minpoly ℚ⟮cbrtTwo⟯ (Real.sqrt 23) ∣ Polynomial.X ^ 2 - Polynomial.C (23 : ℚ⟮cbrtTwo⟯) :=
      minpoly.dvd _ _ (by
        rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_ofNat, Real.sq_sqrt (by norm_num), sub_self])
    have hmap : (Polynomial.X ^ 2 - Polynomial.C (23 : ℚ⟮cbrtTwo⟯)).map (algebraMap ℚ⟮cbrtTwo⟯ L)
        = (Polynomial.X - Polynomial.C s) * (Polynomial.X + Polynomial.C s) := by
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C, map_ofNat, ← hs, map_pow]
      ring
    have hsp : ((Polynomial.X - Polynomial.C s) * (Polynomial.X + Polynomial.C s)).Splits :=
      (Polynomial.Splits.X_sub_C _).mul (Polynomial.Splits.X_add_C _)
    refine hsp.of_dvd (mul_ne_zero (Polynomial.X_sub_C_ne_zero _) (Polynomial.X_add_C_ne_zero _)) ?_
    rw [← hmap]
    exact Polynomial.map_dvd _ hdvd
  obtain ⟨ψ⟩ := nonempty_algHom_adjoin_of_splits hK
  -- `F23 ⊆ ℚ(∛2)(√23)`
  have hsub : ∀ x ∈ F23, x ∈ adjoin ℚ⟮cbrtTwo⟯ ({Real.sqrt 23} : Set ℝ) := by
    intro x hx
    refine (Subfield.closure_le (t := (adjoin ℚ⟮cbrtTwo⟯ ({Real.sqrt 23} : Set ℝ)).toSubfield)).2 ?_ hx
    rintro z (rfl | rfl)
    · exact subset_adjoin _ _ rfl
    · exact algebraMap_mem _ (AdjoinSimple.gen ℚ cbrtTwo)
  refine ⟨{ toFun := fun x => ψ ⟨x, hsub x x.2⟩
            map_one' := by rw [← map_one ψ]; rfl
            map_mul' := fun x y => by rw [← map_mul]; rfl
            map_zero' := by rw [← map_zero ψ]; rfl
            map_add' := fun x y => by rw [← map_add]; rfl }, ?_⟩
  show ψ ⟨cbrtTwo, _⟩ = y
  rw [show (⟨cbrtTwo, hsub _ cbrtTwo_mem_F23⟩ : adjoin ℚ⟮cbrtTwo⟯ ({Real.sqrt 23} : Set ℝ)) =
    algebraMap ℚ⟮cbrtTwo⟯ _ (AdjoinSimple.gen ℚ cbrtTwo) from rfl, ψ.commutes]
  exact hφ₀

-- **Hensel at 7**: `7³ = 343 ≡ 2 (mod 11)` and `3·7² = 147 ≢ 0 (mod 11)`, so 2 is a cube in `ℤ₁₁`.
private theorem exists_padicInt_cube_eq_two : ∃ r : ℤ_[11], r ^ 3 = 2 := by
  haveI : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  let G : Polynomial ℤ_[11] := Polynomial.X ^ 3 - Polynomial.C 2
  have hG : Polynomial.aeval (7 : ℤ_[11]) G = ((341 : ℤ) : ℤ_[11]) := by
    simp [G]; norm_num
  have hG' : Polynomial.aeval (7 : ℤ_[11]) (Polynomial.derivative G) = ((147 : ℕ) : ℤ_[11]) := by
    simp [G]; norm_num
  have h1 : ‖Polynomial.aeval (7 : ℤ_[11]) (Polynomial.derivative G)‖ = 1 := by
    rw [hG', PadicInt.norm_natCast_eq_one_iff]; norm_num
  have h2 : ‖Polynomial.aeval (7 : ℤ_[11]) G‖ < 1 := by
    rw [hG]; exact (PadicInt.norm_int_lt_one_iff_dvd _).2 (by norm_num)
  obtain ⟨z, hz, -⟩ := hensels_lemma (F := G) (a := (7 : ℤ_[11])) (by rw [h1, one_pow]; exact h2)
  exact ⟨z, sub_eq_zero.1 (by simpa [G] using hz)⟩

/-- **`ℚ(√23, ∛2)` is a number field**: generated by two algebraic numbers. -/
theorem numberField_F23 : NumberField F23 := by
  set S : Set ℝ := {Real.sqrt 23, cbrtTwo}
  haveI : Finite S := (Set.toFinite _)
  haveI : FiniteDimensional ℚ (IntermediateField.adjoin ℚ S) :=
    IntermediateField.finiteDimensional_adjoin fun x hx => by
      rcases hx with rfl | rfl
      · exact isIntegral_sqrt23
      · exact isIntegral_cbrtTwo
  have hle : ∀ x ∈ F23, x ∈ IntermediateField.adjoin ℚ S := fun x hx =>
    (Subfield.closure_le (t := (IntermediateField.adjoin ℚ S).toSubfield)).2 (IntermediateField.subset_adjoin ℚ S) hx
  let j : F23 →ₗ[ℚ] IntermediateField.adjoin ℚ S :=
    { toFun := fun x => ⟨x, hle x x.2⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun c x => Subtype.ext (by simp [Algebra.smul_def]) }
  have hj : Function.Injective j := fun x y h => Subtype.ext (congrArg Subtype.val h :)
  exact { to_finiteDimensional := Module.Finite.of_injective j hj }

instance : NumberField F23 := numberField_F23

/-- `23` is a square in `F23`. -/
theorem isSquare_twentyThree : IsSquare ((23 : ℕ) : F23) :=
  ⟨⟨Real.sqrt 23, sqrt_mem_F23⟩, Subtype.ext (by
    show ((23 : ℕ) : ℝ) = Real.sqrt 23 * Real.sqrt 23
    rw [Real.mul_self_sqrt (by norm_num)]; norm_num)⟩

/-- `2` is a cube in `F23`. -/
theorem exists_cube_two : ∃ t : F23, t ^ 3 = ((2 : ℕ) : F23) :=
  ⟨⟨cbrtTwo, cbrtTwo_mem_F23⟩, Subtype.ext (by push_cast; exact cbrtTwo_pow_three)⟩

/-- **`5 ≤ L(F23)`**: every stable prime is odd, and has neither 9 nor 49 residues. -/
theorem five_le_localBound_sqrt23_cbrt2 : 5 ≤ localBound F23 := by
  refine le_iInf fun P => ?_
  have h2 := Rigidity.two_notMem_of_isSquare P isSquare_twentyThree (by norm_num)
  refine Rigidity.five_le_chromaticNumber_of_two_notMem P h2 ?_ fun h49 =>
    card_ne_sq_of_pow_eq P h2 (p := 7) (k := 3) (a := 2) (by norm_num) exists_cube_two (by decide)
      (h49.trans (by norm_num))
  -- nine residues: the prime below is 3, and 23 is no square modulo 3
  intro h9
  obtain ⟨p, n, hp, -, hn, -, hcard, hsq⟩ := Rigidity.stablePrime_card_of_two_notMem P h2
  have hp3 : p ^ n = 3 := Nat.pow_left_injective two_ne_zero (hcard.symm.trans (h9.trans (by norm_num)))
  have hp3' : p = 3 :=
    (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 (hp3 ▸ dvd_pow_self p hn.pos.ne')
  subst hp3'
  exact (by decide : ¬ IsSquare ((23 : ℕ) : ZMod 3)) (hsq 23 isSquare_twentyThree)

/-- **`F23` embeds in `ℚ₁₁`**: `∛2 ↦` the 11-adic cube root of 2 (Hensel at 7), then `√23 ↦` an 11-adic square root
of 23 (`23 ≡ 1`). -/
theorem nonempty_ringHom_padic_eleven_F23 : Nonempty (F23 →+* ℚ_[11]) := by
  haveI : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  obtain ⟨r, hr⟩ := exists_padicInt_cube_eq_two
  obtain ⟨t, ht⟩ := QuadraticPrime.exists_padicInt_sq_eq (p := 11) (by norm_num) (d := 23) twentyThree_ne_zero_mod_eleven
    isSquare_twentyThree_mod_eleven
  have hr' : (r : ℚ_[11]) ^ 3 = 2 := by exact_mod_cast congrArg (fun z : ℤ_[11] => (z : ℚ_[11])) hr
  have ht' : (t : ℚ_[11]) ^ 2 = 23 := by exact_mod_cast congrArg (fun z : ℤ_[11] => (z : ℚ_[11])) ht
  obtain ⟨φ, -⟩ := exists_ringHom_F23 hr' ht'
  exact ⟨φ⟩

/-- **A usable prime of `F23` with residue field `𝔽₁₁`.** -/
theorem exists_usablePrime_eleven_F23 :
    ∃ 𝔭 : Ideal (𝓞 F23), Arith.IsUsablePrime 𝔭 ∧ Nat.card (𝓞 F23 ⧸ 𝔭) = 11 := by
  haveI : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  obtain ⟨ι⟩ := nonempty_ringHom_padic_eleven_F23
  obtain ⟨𝔭, hmax, hcard⟩ := QuadraticPrime.exists_maximal_card_of_padic ι
  exact ⟨𝔭, ⟨hmax, by rw [hcard]⟩, hcard⟩

/-- **`χ(ℚ(√23, ∛2)²) = 5`.** -/
theorem chromaticNumber_planeOver_sqrt23_cbrt2_eq_five : ((unitDistance ℂ).induce (planeOver F23)).chromaticNumber = 5 := by
  obtain ⟨𝔭, h𝔭, hcard⟩ := exists_usablePrime_eleven_F23
  exact le_antisymm
    (colorable_planeOver_of_finitePlane F23 h𝔭 (by norm_num) hcard finitePlane11_colorable_five).chromaticNumber_le
    (Rigidity.five_le_chromaticNumber_planeOver_of_five_le_localBound F23 five_le_localBound_sqrt23_cbrt2)

/-- **`L(ℚ(√23, ∛2)) = 5`.** -/
theorem localBound_sqrt23_cbrt2_eq_five : localBound F23 = 5 := by
  obtain ⟨𝔭, h𝔭, hcard⟩ := exists_usablePrime_eleven_F23
  exact le_antisymm
    ((localBound_le_finitePlane F23 h𝔭 (by norm_num) hcard).trans finitePlane11_colorable_five.chromaticNumber_le)
    five_le_localBound_sqrt23_cbrt2

/-- **`L(ℚ(√23)) = 4`**: `χ(ℚ(√23)²) = 4` (the table: `23 ≡ 11 (mod 12)`, outside the class) and the headline's `min`
form. -/
theorem localBound_sqrt23_eq_four : localBound (fieldOfRadicands {23}) = 4 := by
  have hχ : ((unitDistance ℂ).induce (planeOver (fieldOfRadicands {23}))).chromaticNumber = 4 :=
    (ThreeFourColours.chromaticNumber_planeOver_sqrt_table (by norm_num : Nat.Prime 23).prime.squarefree).2.2.2
      (by norm_num) ⟨by norm_num, by norm_num, by norm_num⟩
  have hmin := Rigidity.min_localBound_five_le_chromaticNumber (fieldOfRadicands {23})
  have hup := chromaticNumber_planeOver_le_localBound (fieldOfRadicands {23})
  refine le_antisymm ?_ (hχ ▸ hup)
  rcases min_le_iff.1 (hmin.trans hχ.le) with h | h
  · exact h
  · exact absurd h (by norm_num)

/-- **`F23` has a complex place.** -/
theorem not_isTotallyReal_F23 : ¬ IsTotallyReal F23 := by
  intro htr
  -- the embedding `∛2 ↦ ω∛2`, `ω` a primitive cube root of unity
  set ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / (3 : ℕ)) with hωdef
  have hω : IsPrimitiveRoot ω 3 := Complex.isPrimitiveRoot_exp 3 (by norm_num)
  have hy : (ω * (cbrtTwo : ℂ)) ^ 3 = 2 := by
    rw [mul_pow, hω.pow_eq_one, one_mul, ← Complex.ofReal_pow, cbrtTwo_pow_three]; norm_num
  have hs : ((Real.sqrt 23 : ℝ) : ℂ) ^ 2 = 23 := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num)]; norm_num
  obtain ⟨φ, hφ⟩ := exists_ringHom_F23 hy hs
  -- a real embedding would fix `ω∛2` under conjugation, making `ω` real, hence `1`
  have hreal := NumberField.ComplexEmbedding.isReal_iff.1 (NumberField.IsTotallyReal.complexEmbedding_isReal φ)
  have hc := RingHom.congr_fun hreal ⟨cbrtTwo, cbrtTwo_mem_F23⟩
  rw [NumberField.ComplexEmbedding.conjugate_coe_eq, hφ, map_mul, Complex.conj_ofReal] at hc
  have hc0 : (cbrtTwo : ℂ) ≠ 0 := by
    intro h0
    have h := congrArg (· ^ 3) h0
    simp only [← Complex.ofReal_pow, cbrtTwo_pow_three] at h
    norm_num at h
  have hωc : (starRingEnd ℂ) ω = ω := mul_right_cancel₀ hc0 hc
  have hωr : ((ω.re : ℝ) : ℂ) = ω := Complex.conj_eq_iff_re.1 hωc
  have h3 : (ω.re) ^ 3 = 1 := by
    have := hω.pow_eq_one
    rw [← hωr, ← Complex.ofReal_pow] at this
    exact_mod_cast this
  have h1 : ω.re = 1 := (Odd.pow_inj (by decide : Odd 3)).1 (by rw [h3, one_pow])
  exact hω.ne_one (by norm_num) (by rw [← hωr, h1, Complex.ofReal_one])

/-! ## Spec -/

-- The residues the proofs read: `23 ≡ 7 (mod 8)`, `23 ≡ 2 (mod 3)` no square, `2` no cube mod 7, `7³ ≡ 2` and
-- `23 ≡ 1 (mod 11)`, and `3·7² ≢ 0 (mod 11)` (Hensel's simple root).
example : 23 % 8 = 7 ∧ ¬ IsSquare (23 : ZMod 3) ∧ (∀ y : ZMod 7, y ^ 3 ≠ 2) ∧ (7 : ZMod 11) ^ 3 = 2 ∧
    (23 : ZMod 11) = 1 ∧ (3 * 7 ^ 2 : ZMod 11) ≠ 0 := by decide
-- At `ℚ(√23)` the prime 7 splits (`23 ≡ 3² mod 7`): the cube root is what removes `Γ₇`.
example : IsSquare (23 : ZMod 7) := ⟨3, by decide⟩

end HadwigerNelson.SqrtTwentyThreeCbrtTwo
