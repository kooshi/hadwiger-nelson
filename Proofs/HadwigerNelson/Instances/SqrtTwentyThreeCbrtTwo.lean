import Proofs.HadwigerNelson.Instances.SqrtFiveClass

/-!
# `χ(ℚ(√23, ∛2)²) = 5`: the main clause at a field with a complex place (FS-131, job FS131-KCS1; skeleton)

**Read aloud, against the informal claim** (`LEDGER.md` row 123: "The complex-place case is inhabited and not reducible to
totally real fields by monotonicity: ℚ(√23, ∛2) has `L = 5` while its totally real subfields have `L ≤ 4` (X28D-CP2)";
`plans/FS100-X28D-derivation.md` § 2.3). `F23` is the subfield of `ℝ` generated by `√23` and the real cube root of 2 — a
number field of degree 6 with one chosen real embedding; its other embeddings (one more real, two complex pairs) are
invisible to the library's stable primes, and the headline asks no total reality.

* `chromaticNumber_planeOver_sqrt23_cbrt2_eq_five` — **`χ(F23²) = 5`**; `localBound_sqrt23_cbrt2_eq_five` — **`L(F23) = 5`**.
* The arithmetic: no stable prime above 2 (`23 ≡ 7 mod 8`), none with residue field `𝔽₉` (`23` no square mod 3) and **none
  with residue field `𝔽₄₉`, because `∛2 ∈ F23` and `2` is no cube mod 7** (`card_ne_sq_of_pow_eq`); the upper half at a
  degree-one prime above 11 (`23 ≡ 1`, `2 ≡ 7³ (mod 11)`).
* `localBound_sqrt23_eq_four` — **`L(ℚ(√23)) = 4`**: at the totally real subfield `ℚ(√23)` the prime 7 splits and `Γ₇`
  is four-colourable, which is why the cube root carries the five here.
* `not_isTotallyReal_F23` — `F23` has a complex place (the embedding sending `∛2` to `ω∛2`).

**Not claimed:** that `ℚ` and `ℚ(√23)` are all of `F23`'s totally real subfields (X28D's statement, a Galois-theoretic
enumeration); anything about `F23` at six colours; that the value is new mathematics.

**What rests on what.** `χ ≥ 5` and `L ≥ 5`'s use rest on the headline's two declared outside theorems; the upper half and
`L ≤ 5` on the standard three.

**Inhabitants.** `F23` is a number field (`numberField_F23`); every statement about it is closed.
-/

namespace HadwigerNelson.SqrtTwentyThreeCbrtTwo

open SpectralChain NumberField SimpleGraph SquareClass UpperHalf

/-- **A stable prime with `p²` residues is excluded by a `k`-th power**: if some `t ∈ F` has `t^k = a` and `a` is no `k`-th
power modulo `p`, no odd stable prime of `F(i)` has `p²` residues (its fixed field is `𝔽_p` and holds the residue of
`t`, an integer fixed by conjugation). -/
theorem card_ne_sq_of_pow_eq {F : Subfield ℝ} [NumberField F] (P : StablePrime F) (h2 : (2 : 𝓞 (fieldI F)) ∉ P.P)
    {p k a : ℕ} (hp : p.Prime) (ht : ∃ t : F, t ^ k = a) (ha : ∀ y : ZMod p, y ^ k ≠ a) :
    Nat.card (𝓞 (fieldI F) ⧸ P.P) ≠ p ^ 2 := by
  sorry

/-- **The real cube root of 2.** -/
noncomputable def cbrtTwo : ℝ := (2 : ℝ) ^ ((1 : ℝ) / 3)

/-- `(∛2)³ = 2`. -/
theorem cbrtTwo_pow_three : cbrtTwo ^ 3 = 2 := by
  sorry

/-- **`ℚ(√23, ∛2) ⊂ ℝ`**: the subfield generated by `√23` and the real cube root of 2. -/
noncomputable def F23 : Subfield ℝ := Subfield.closure {Real.sqrt 23, cbrtTwo}

/-- **`ℚ(√23, ∛2)` is a number field**: generated by two algebraic numbers. -/
theorem numberField_F23 : NumberField F23 := by
  sorry

instance : NumberField F23 := numberField_F23

/-- `23` is a square in `F23`. -/
theorem isSquare_twentyThree : IsSquare ((23 : ℕ) : F23) := by
  sorry

/-- `2` is a cube in `F23`. -/
theorem exists_cube_two : ∃ t : F23, t ^ 3 = ((2 : ℕ) : F23) := by
  sorry

/-- **`5 ≤ L(F23)`**: every stable prime is odd, and has neither 9 nor 49 residues. -/
theorem five_le_localBound_sqrt23_cbrt2 : 5 ≤ localBound F23 := by
  sorry

/-- **`F23` embeds in `ℚ₁₁`**: `∛2 ↦` the 11-adic cube root of 2 (Hensel at 7), then `√23 ↦` an 11-adic square root
of 23 (`23 ≡ 1`). -/
theorem nonempty_ringHom_padic_eleven_F23 : Nonempty (F23 →+* ℚ_[11]) := by
  sorry

/-- **A usable prime of `F23` with residue field `𝔽₁₁`.** -/
theorem exists_usablePrime_eleven_F23 :
    ∃ 𝔭 : Ideal (𝓞 F23), Arith.IsUsablePrime 𝔭 ∧ Nat.card (𝓞 F23 ⧸ 𝔭) = 11 := by
  sorry

/-- **`χ(ℚ(√23, ∛2)²) = 5`.** -/
theorem chromaticNumber_planeOver_sqrt23_cbrt2_eq_five : ((unitDistance ℂ).induce (planeOver F23)).chromaticNumber = 5 := by
  sorry

/-- **`L(ℚ(√23, ∛2)) = 5`.** -/
theorem localBound_sqrt23_cbrt2_eq_five : localBound F23 = 5 := by
  sorry

/-- **`L(ℚ(√23)) = 4`**: `χ(ℚ(√23)²) = 4` (the table: `23 ≡ 11 (mod 12)`, outside the class) and the headline's `min`
form. -/
theorem localBound_sqrt23_eq_four : localBound (fieldOfRadicands {23}) = 4 := by
  sorry

/-- **`F23` has a complex place.** -/
theorem not_isTotallyReal_F23 : ¬ IsTotallyReal F23 := by
  sorry

/-! ## Spec -/

-- The residues the proofs read: `23 ≡ 7 (mod 8)`, `23 ≡ 2 (mod 3)` no square, `2` no cube mod 7, `7³ ≡ 2` and
-- `23 ≡ 1 (mod 11)`, and `3·7² ≢ 0 (mod 11)` (Hensel's simple root).
example : 23 % 8 = 7 ∧ ¬ IsSquare (23 : ZMod 3) ∧ (∀ y : ZMod 7, y ^ 3 ≠ 2) ∧ (7 : ZMod 11) ^ 3 = 2 ∧
    (23 : ZMod 11) = 1 ∧ (3 * 7 ^ 2 : ZMod 11) ≠ 0 := by decide
-- At `ℚ(√23)` the prime 7 splits (`23 ≡ 3² mod 7`): the cube root is what removes `Γ₇`.
example : IsSquare (23 : ZMod 7) := ⟨3, by decide⟩

end HadwigerNelson.SqrtTwentyThreeCbrtTwo
