import Mathlib.Analysis.Real.Pi.Bounds
import Mathlib.Data.ZMod.Basic

/-!
# The circle's cosine sums at `q ∈ {23, 31}` (FS-131, job FS131-ICM3; module M13's exact spectra)

**Read aloud, against the informal claim.** KC13 § 5.3 and FS131-ICM2's split of `charBound_one_exact`: over the circle
`a² + b² = 1` of `UD(𝔽_q, 2)` (`q + 1` points), every non-trivial character `(a, b) ↦ e^{2πi(αa + βb)/q}` has real part at
least `−κ(q + 1)` for one `κ < 1/3` with `κ ≥ 2/(q + 1)` — the normalised least eigenvalue of the circle's Cayley graph is
above `−1/3`, by `3.9·10⁻²` at 23 and `1.6·10⁻⁴` at 31 (`circleCos_ge`). **No outside theorem; no float.**

**The certificate** (each a `decide +kernel`; generated by `tools/fs131_icm3_circlecos.py`, which mirrors the bounds below
in exact rational arithmetic):

* `cosLow q j`, a rational below `cos(2πj/q)` (`cosLow_le_cos`): the Taylor polynomial of degree 25 at
  `r = 2·π₀·j′/q`, `j′ = min(j, q − j)`, `π₀ = 3.1415926535`, less the remainder bound of `Complex.exp_bound'` and the
  Lipschitz error `2j′/q · 10⁻¹⁰` (`π₀ < π < π₀ + 10⁻¹⁰`, from `Real.pi_gt_d20` and `Real.pi_lt_d20`).
* a table of integers `C_j ≤ 10⁹·cosLow q j` (`tab23_ok`, `tab31_ok`); the circle as a list of pairs, exactly the solutions
  of `a² + b² ≡ 1` below `q` (`circ23_eq`, `circ31_eq`, with `circ23_nodup`, `circ31_nodup`);
* one pass over the `q² − 1` non-zero `(α, β)`: `Σ_{(a,b)} C_{(αa + βb) mod q} ≥ −M` (`check23`, `check31`), with
  `3M < 10⁹(q + 1)` and `2·10⁹ ≤ M`; then `κ = M/(10⁹(q + 1))`.

**Models.** The statements are closed (no hypothesis but `q ∈ {23, 31}`). The control: at `q = 11` and `19`, where
Hoffman's bound is known to fail, the same certificate's inequality `3M < 10⁹(q + 1)` fails (`--plant` of the tool).
-/

namespace HadwigerNelson.CircleCos

open Finset Real

/-! ### A rational lower bound for the cosine -/

/-- `Re(iᵐ)`: `1, 0, −1, 0` by `m mod 4`. -/
def reIPow (m : ℕ) : ℚ := if m % 4 = 0 then 1 else if m % 4 = 2 then -1 else 0

theorem re_I_pow (m : ℕ) : (Complex.I ^ m).re = (reIPow m : ℝ) := by
  have h4 : Complex.I ^ m = Complex.I ^ (m % 4) := by
    conv_lhs => rw [← Nat.mod_add_div m 4, pow_add, pow_mul, Complex.I_pow_four, one_pow, mul_one]
  rw [h4, reIPow]
  have h : m % 4 = 0 ∨ m % 4 = 1 ∨ m % 4 = 2 ∨ m % 4 = 3 := by omega
  rcases h with h | h | h | h <;> simp [h, pow_succ]

/-- The Taylor polynomial of `cos` at a rational `r`, of `n` terms (the odd ones zero). -/
def taylorCos (r : ℚ) (n : ℕ) : ℚ := ∑ m ∈ range n, r ^ m / (m.factorial : ℚ) * reIPow m

/-- **Taylor's bound for `cos`** at a rational point (`Complex.exp_bound'` at `r·i`, real parts). -/
theorem taylorCos_sub_le_cos (r : ℚ) (n : ℕ) (hr : |(r : ℝ)| / (n.succ : ℝ) ≤ 1 / 2) :
    ((taylorCos r n - |r| ^ n / (n.factorial : ℚ) * 2 : ℚ) : ℝ) ≤ Real.cos r := by
  set x : ℝ := (r : ℝ) with hx
  have hz : ‖(x : ℂ) * Complex.I‖ = |x| := by
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
  have hb := Complex.exp_bound' (x := (x : ℂ) * Complex.I) (n := n) (by rw [hz]; exact hr)
  rw [hz] at hb
  have hsum : (∑ m ∈ range n, ((x : ℂ) * Complex.I) ^ m / (m.factorial : ℂ)).re =
      ∑ m ∈ range n, x ^ m / (m.factorial : ℝ) * (reIPow m : ℝ) := by
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [Complex.div_natCast_re, mul_pow, ← Complex.ofReal_pow, Complex.re_ofReal_mul, re_I_pow]
    ring
  have hre := Complex.abs_re_le_norm
    (Complex.exp ((x : ℂ) * Complex.I) - ∑ m ∈ range n, ((x : ℂ) * Complex.I) ^ m / (m.factorial : ℂ))
  rw [Complex.sub_re, Complex.exp_ofReal_mul_I_re, hsum] at hre
  have hcast : ((taylorCos r n - |r| ^ n / (n.factorial : ℚ) * 2 : ℚ) : ℝ) =
      ∑ m ∈ range n, x ^ m / (m.factorial : ℝ) * (reIPow m : ℝ) - |x| ^ n / (n.factorial : ℝ) * 2 := by
    rw [taylorCos, hx]
    push_cast
    rfl
  rw [hcast]
  linarith [(abs_le.1 (hre.trans hb)).1]

/-- `π₀ = 3.1415926535`. -/
def piLo : ℚ := 31415926535 / 10 ^ 10

theorem piLo_lt_pi : (piLo : ℝ) < π := by
  have h := Real.pi_gt_d20
  rw [piLo]
  push_cast
  linarith

theorem pi_lt_piLo_add : π < (piLo : ℝ) + 1 / 10 ^ 10 := by
  have h := Real.pi_lt_d20
  rw [piLo]
  push_cast
  linarith

/-- The point `2π₀·j′/q`, `j′ = min(j, q − j)`, at which the Taylor bound is taken. -/
def cosArg (Q j : ℕ) : ℚ := 2 * piLo * (min j (Q - j) : ℕ) / Q

/-- **A rational below `cos(2πj/q)`**: Taylor at `cosArg q j` with 26 terms, less its remainder bound and the Lipschitz
error of replacing `π` by `π₀`. -/
def cosLow (Q j : ℕ) : ℚ :=
  taylorCos (cosArg Q j) 26 - |cosArg Q j| ^ 26 / ((26 : ℕ).factorial : ℚ) * 2 - 2 * (min j (Q - j) : ℕ) / Q / 10 ^ 10

theorem cosLow_le_cos {Q j : ℕ} (hQ : 0 < Q) (hj : j < Q) : (cosLow Q j : ℝ) ≤ Real.cos (2 * π * j / Q) := by
  set j' := min j (Q - j) with hj'
  have hQr : (0 : ℝ) < Q := by exact_mod_cast hQ
  have hsym : Real.cos (2 * π * j / Q) = Real.cos (2 * π * j' / Q) := by
    rcases min_choice j (Q - j) with h | h
    · rw [hj', h]
    · rw [hj', h, Nat.cast_sub hj.le, ← Real.cos_two_pi_sub]
      congr 1
      field_simp
  have hj2 : 2 * j' ≤ Q := by omega
  have hj2r : 2 * (j' : ℝ) ≤ Q := by exact_mod_cast hj2
  have hj0 : (0 : ℝ) ≤ j' := Nat.cast_nonneg _
  have hpi0 := piLo_lt_pi
  have hpi1 := pi_lt_piLo_add
  have hpi4 : (piLo : ℝ) < 4 := by linarith [Real.pi_lt_four]
  have hpilo0 : (0 : ℝ) < piLo := by rw [piLo]; norm_num
  have harg : (cosArg Q j : ℝ) = 2 * piLo * j' / Q := by rw [cosArg, ← hj']; push_cast; rfl
  have hfrac : 2 * (j' : ℝ) / Q ≤ 1 := by rw [div_le_one hQr]; exact hj2r
  have hfrac0 : 0 ≤ 2 * (j' : ℝ) / Q := by positivity
  have harg_le : (cosArg Q j : ℝ) ≤ 4 := by
    rw [harg, show 2 * (piLo : ℝ) * j' / Q = piLo * (2 * j' / Q) by ring]
    nlinarith
  have harg0 : 0 ≤ (cosArg Q j : ℝ) := by rw [harg]; positivity
  have hT := taylorCos_sub_le_cos (cosArg Q j) 26 (by
    rw [abs_of_nonneg harg0]
    rw [div_le_iff₀ (by norm_num)]
    push_cast
    linarith)
  have hL := Real.abs_cos_sub_cos_le (2 * π * j' / Q) (cosArg Q j)
  have hdiff : |2 * π * j' / Q - (cosArg Q j : ℝ)| ≤ 2 * j' / Q / 10 ^ 10 := by
    rw [harg, show 2 * π * (j' : ℝ) / Q - 2 * piLo * j' / Q = (π - piLo) * (2 * j' / Q) by ring,
      abs_of_nonneg (mul_nonneg (by linarith) hfrac0)]
    rw [show 2 * (j' : ℝ) / Q / 10 ^ 10 = 1 / 10 ^ 10 * (2 * j' / Q) by ring]
    exact mul_le_mul_of_nonneg_right (by linarith) hfrac0
  have hcast : (cosLow Q j : ℝ) = ((taylorCos (cosArg Q j) 26 - |cosArg Q j| ^ 26 / ((26 : ℕ).factorial : ℚ) * 2 : ℚ) : ℝ)
      - 2 * j' / Q / 10 ^ 10 := by
    rw [cosLow, ← hj']
    push_cast
    rfl
  rw [hsym, hcast]
  linarith [(abs_le.1 hL).1]

/-! ### The circle, as a list of pairs below `q` -/

/-- The sum over the circle `a² + b² = 1` of `ZMod q` of a function of the coordinates' values is its sum over any list of
pairs that is exactly the circle's solutions below `q`. -/
theorem sum_circle_eq {Q : ℕ} [NeZero Q] (hQ : 1 < Q) (circ : List (ℕ × ℕ))
    (hcirc : (range Q ×ˢ range Q).filter (fun x : ℕ × ℕ => (x.1 ^ 2 + x.2 ^ 2) % Q = 1) = circ.toFinset)
    (f : ℕ → ℕ → ℝ) :
    ∑ v ∈ univ.filter (fun v : ZMod Q × ZMod Q => v.1 ^ 2 + v.2 ^ 2 = 1), f v.1.val v.2.val =
      ∑ x ∈ circ.toFinset, f x.1 x.2 := by
  classical
  have hval : ∀ a b : ZMod Q, a ^ 2 + b ^ 2 = 1 ↔ (a.val ^ 2 + b.val ^ 2) % Q = 1 := by
    intro a b
    have e : a ^ 2 + b ^ 2 = ((a.val ^ 2 + b.val ^ 2 : ℕ) : ZMod Q) := by
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [e, ← Nat.cast_one, ZMod.natCast_eq_natCast_iff', Nat.one_mod_eq_one.2 (by omega)]
  -- the sum over `ZMod Q` of a function of the value is the sum over `range Q`
  have hrange : ∀ h : ℕ → ℝ, ∑ a : ZMod Q, h a.val = ∑ i ∈ range Q, h i := by
    intro h
    have himg : (univ : Finset (ZMod Q)).image ZMod.val = range Q := by
      ext i
      simp only [mem_image, mem_univ, true_and, mem_range]
      constructor
      · rintro ⟨a, rfl⟩
        exact ZMod.val_lt a
      · intro hi
        exact ⟨i, ZMod.val_cast_of_lt hi⟩
    rw [← himg, Finset.sum_image fun a _ b _ hab => ZMod.val_injective Q hab]
  rw [← hcirc, Finset.sum_filter, Finset.sum_filter, Fintype.sum_prod_type, Finset.sum_product]
  simp only [hval]
  rw [hrange fun i => ∑ b : ZMod Q, if (i ^ 2 + b.val ^ 2) % Q = 1 then f i b.val else 0]
  refine Finset.sum_congr rfl fun i _ => ?_
  exact hrange fun j => if (i ^ 2 + j ^ 2) % Q = 1 then f i j else 0

/-! ### The check -/

/-- **The check**: for every non-zero `(α, β)` below `q`, the table's sum over the circle is at least `−M`. -/
def circCheck (Q : ℕ) (circ : List (ℕ × ℕ)) (C : List ℤ) (M : ℤ) : Bool :=
  (List.range Q).all fun α => (List.range Q).all fun β =>
    (α == 0 && β == 0) || decide (-M ≤ (circ.map fun x => C.getD ((α * x.1 + β * x.2) % Q) 0).sum)

theorem circCheck_sound {Q : ℕ} {circ : List (ℕ × ℕ)} {C : List ℤ} {M : ℤ} (h : circCheck Q circ C M = true)
    {α β : ℕ} (hα : α < Q) (hβ : β < Q) (hαβ : α ≠ 0 ∨ β ≠ 0) :
    -M ≤ (circ.map fun x => C.getD ((α * x.1 + β * x.2) % Q) 0).sum := by
  rw [circCheck, List.all_eq_true] at h
  have h1 := h α (List.mem_range.2 hα)
  rw [List.all_eq_true] at h1
  have h2 := h1 β (List.mem_range.2 hβ)
  simp only [Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h2
  rcases h2 with h2 | h2
  · exfalso
    rcases hαβ with h | h
    · exact h h2.1
    · exact h h2.2
  · exact h2

/-- **From the certificate to the bound**, at any `q`: a circle list, a table below `10⁹·cos`, and a passing check give
`κ = M/(10⁹(q + 1))`. -/
theorem circleCos_of_check {Q : ℕ} [NeZero Q] (hQ : 1 < Q) (circ : List (ℕ × ℕ)) (C : List ℤ) (M : ℤ)
    (hcirc : (range Q ×ˢ range Q).filter (fun x : ℕ × ℕ => (x.1 ^ 2 + x.2 ^ 2) % Q = 1) = circ.toFinset)
    (hnd : circ.Nodup) (htab : ∀ j < Q, ((C.getD j 0 : ℤ) : ℚ) ≤ 10 ^ 9 * cosLow Q j)
    (hchk : circCheck Q circ C M = true) (hM3 : 3 * M < 10 ^ 9 * ((Q : ℤ) + 1)) (hM2 : 2 * 10 ^ 9 ≤ M) :
    ∃ κ : ℝ, κ < 1 / 3 ∧ 2 / ((Q : ℝ) + 1) ≤ κ ∧ ∀ α β : ℕ, α < Q → β < Q → (α ≠ 0 ∨ β ≠ 0) →
      -(κ * ((Q : ℝ) + 1)) ≤ ∑ v ∈ Finset.univ.filter (fun v : ZMod Q × ZMod Q => v.1 ^ 2 + v.2 ^ 2 = 1),
        Real.cos (2 * Real.pi * (((α * v.1.val + β * v.2.val) % Q : ℕ) : ℝ) / Q) := by
  classical
  have hQ1 : (0 : ℝ) < (Q : ℝ) + 1 := by positivity
  have hM3r : 3 * (M : ℝ) < 10 ^ 9 * ((Q : ℝ) + 1) := by exact_mod_cast hM3
  have hM2r : 2 * 10 ^ 9 ≤ (M : ℝ) := by exact_mod_cast hM2
  refine ⟨(M : ℝ) / (10 ^ 9 * ((Q : ℝ) + 1)), ?_, ?_, ?_⟩
  · rw [div_lt_iff₀ (by positivity)]
    linarith
  · rw [div_le_div_iff₀ hQ1 (by positivity)]
    nlinarith
  · intro α β hα hβ hαβ
    have hκ : (M : ℝ) / (10 ^ 9 * ((Q : ℝ) + 1)) * ((Q : ℝ) + 1) = M / 10 ^ 9 := by
      field_simp
    rw [hκ, sum_circle_eq hQ circ hcirc fun a b => Real.cos (2 * Real.pi * (((α * a + β * b) % Q : ℕ) : ℝ) / Q)]
    have hle : ∀ x ∈ circ.toFinset, ((C.getD ((α * x.1 + β * x.2) % Q) 0 : ℤ) : ℝ) ≤
        10 ^ 9 * Real.cos (2 * Real.pi * (((α * x.1 + β * x.2) % Q : ℕ) : ℝ) / Q) := by
      intro x _
      have hj := Nat.mod_lt (α * x.1 + β * x.2) (by omega : 0 < Q)
      have h1 : ((C.getD ((α * x.1 + β * x.2) % Q) 0 : ℤ) : ℝ) ≤ 10 ^ 9 * (cosLow Q ((α * x.1 + β * x.2) % Q) : ℝ) := by
        have := htab _ hj
        exact_mod_cast this
      have h2 := cosLow_le_cos (by omega : 0 < Q) hj
      nlinarith
    have hsum := Finset.sum_le_sum hle
    rw [← Finset.mul_sum, ← Int.cast_sum, List.sum_toFinset _ hnd] at hsum
    have hchk' := circCheck_sound hchk hα hβ hαβ
    have hchk'' : (-(M : ℝ)) ≤ (((circ.map fun x => C.getD ((α * x.1 + β * x.2) % Q) 0).sum : ℤ) : ℝ) := by
      exact_mod_cast hchk'
    have h := hchk''.trans hsum
    rw [show -((M : ℝ) / 10 ^ 9) = -(M : ℝ) / 10 ^ 9 by ring, div_le_iff₀ (by norm_num)]
    linarith

/-! ### The certificates at 23 and 31 -/

/-- The circle `a² + b² ≡ 1 (mod 23)`, `a, b < 23` (24 points). -/
def circ23 : List (ℕ × ℕ) := [(0, 1), (0, 22), (1, 0), (4, 10), (4, 13), (8, 11), (8, 12), (9, 9), (9, 14), (10, 4), (10, 19), (11, 8), (11, 15), (12, 8), (12, 15), (13, 4), (13, 19), (14, 9), (14, 14), (15, 11), (15, 12), (19, 10), (19, 13), (22, 0)]

/-- `C_j ≤ 10⁹·cosLow 23 j`, `j < 23`. -/
def tab23 : List ℤ := [1000000000, 962917287, 854419404, 682553143, 460065037, 203456013, -68242414, -334879613, -576680323, -775711291, -917211302, -990685947, -990685947, -917211302, -775711291, -576680323, -334879613, -68242414, 203456013, 460065037, 682553143, 854419404, 962917287]

/-- The circle `a² + b² ≡ 1 (mod 31)`, `a, b < 31` (32 points). -/
def circ31 : List (ℕ × ℕ) := [(0, 1), (0, 30), (1, 0), (2, 11), (2, 20), (4, 4), (4, 27), (5, 10), (5, 21), (7, 13), (7, 18), (10, 5), (10, 26), (11, 2), (11, 29), (13, 7), (13, 24), (18, 7), (18, 24), (20, 2), (20, 29), (21, 5), (21, 26), (24, 13), (24, 18), (26, 10), (26, 21), (27, 4), (27, 27), (29, 11), (29, 20), (30, 0)]

/-- `C_j ≤ 10⁹·cosLow 31 j`, `j < 31`. -/
def tab31 : List ℤ := [1000000000, 979529941, 918957811, 820763441, 688966919, 528964010, 347305252, 151427777, -50649169, -250652533, -440394152, -612105983, -758758123, -874346617, -954139257, -994869324, -994869324, -954139257, -874346617, -758758123, -612105983, -440394152, -250652533, -50649169, 151427777, 347305252, 528964010, 688966919, 820763441, 918957811, 979529941]

theorem circ23_eq : (range 23 ×ˢ range 23).filter (fun x : ℕ × ℕ => (x.1 ^ 2 + x.2 ^ 2) % 23 = 1) = circ23.toFinset := by
  decide +kernel

theorem circ31_eq : (range 31 ×ˢ range 31).filter (fun x : ℕ × ℕ => (x.1 ^ 2 + x.2 ^ 2) % 31 = 1) = circ31.toFinset := by
  decide +kernel

theorem circ23_nodup : circ23.Nodup := by decide +kernel

theorem circ31_nodup : circ31.Nodup := by decide +kernel

theorem tab23_ok : ((List.range 23).all fun j => decide (((tab23.getD j 0 : ℤ) : ℚ) ≤ 10 ^ 9 * cosLow 23 j)) = true := by
  decide +kernel

theorem tab31_ok : ((List.range 31).all fun j => decide (((tab31.getD j 0 : ℤ) : ℚ) ≤ 10 ^ 9 * cosLow 31 j)) = true := by
  decide +kernel

theorem check23 : circCheck 23 circ23 tab23 7960687200 = true := by decide +kernel

theorem check31 : circCheck 31 circ31 tab31 10666510510 = true := by decide +kernel

private theorem tab_le {Q : ℕ} {C : List ℤ} (h : ((List.range Q).all fun j => decide (((C.getD j 0 : ℤ) : ℚ) ≤
    10 ^ 9 * cosLow Q j)) = true) : ∀ j < Q, ((C.getD j 0 : ℤ) : ℚ) ≤ 10 ^ 9 * cosLow Q j := by
  intro j hj
  rw [List.all_eq_true] at h
  simpa using h j (List.mem_range.2 hj)

/-- **The circle's cosine sums at `q ∈ {23, 31}`**: some `κ < 1/3` with `κ ≥ 2/(q + 1)` bounds every non-trivial
character sum over the circle from below by `−κ(q + 1)`. -/
theorem circleCos_ge {Q : ℕ} (hQ : Q = 23 ∨ Q = 31) [NeZero Q] :
    ∃ κ : ℝ, κ < 1 / 3 ∧ 2 / ((Q : ℝ) + 1) ≤ κ ∧ ∀ α β : ℕ, α < Q → β < Q → (α ≠ 0 ∨ β ≠ 0) →
      -(κ * ((Q : ℝ) + 1)) ≤ ∑ v ∈ Finset.univ.filter (fun v : ZMod Q × ZMod Q => v.1 ^ 2 + v.2 ^ 2 = 1),
        Real.cos (2 * Real.pi * (((α * v.1.val + β * v.2.val) % Q : ℕ) : ℝ) / Q) := by
  rcases hQ with rfl | rfl
  · exact circleCos_of_check (by norm_num) circ23 tab23 7960687200 circ23_eq circ23_nodup (tab_le tab23_ok) check23
      (by norm_num) (by norm_num)
  · exact circleCos_of_check (by norm_num) circ31 tab31 10666510510 circ31_eq circ31_nodup (tab_le tab31_ok) check31
      (by norm_num) (by norm_num)

/-! ## Spec -/

-- `reIPow` is the pattern `1, 0, −1, 0` (it would fail if the residues were read in another order).
example : (List.range 8).map reIPow = [1, 0, -1, 0, 1, 0, -1, 0] := by decide +kernel
-- `cosLow` at `j = 0` is `1` exactly (no Taylor remainder at `0`), and at `q = 4, j = 1` (the angle `π/2`) it is just below 0.
example : cosLow 23 0 = 1 := by decide +kernel
example : cosLow 4 1 < 0 ∧ -1 / 10 ^ 9 < cosLow 4 1 := by decide +kernel
-- the control: at `q = 11`, where Hoffman fails, the same certificate's least sum is about `−4.796·10⁹ < −4·10⁹`, so the
-- check fails at `M = 4·10⁹`, the largest `M` that `3M < 10⁹·12` allows.
example : circCheck 11 [(0, 1), (0, 10), (1, 0), (2, 5), (2, 6), (5, 2), (5, 9), (6, 2), (6, 9), (9, 5), (9, 6), (10, 0)]
    [1000000000, 841253532, 415415012, -142314839, -654860734, -959492974, -959492974, -654860734, -142314839,
      415415012, 841253532] 4000000000 = false := by decide +kernel

end HadwigerNelson.CircleCos
