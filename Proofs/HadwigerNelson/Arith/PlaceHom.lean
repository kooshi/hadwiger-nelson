import Proofs.HadwigerNelson.Transcendental
import Proofs.HadwigerNelson.Arith.NoAffine
import Proofs.HadwigerNelson.Instances.FalconerOrbit
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.AlgebraicIndependent.Basic

/-!
# The place homomorphism, and no linear identity over a slack residue plane (FS-131 wave 2)

Rows: **FS129-SA1-PLACE-HOM**, **FS129-SA1-NOAFF-FIELDS**. Plan: `plans/FS131-w2-kernel-plan.md` § 4.

A number field `F ⊆ ℝ` is a `Subfield ℝ` with `NumberField F`; a **usable prime** is a maximal ideal `𝔭` of `𝓞 F` whose
residue field `𝓞 F ⧸ 𝔭 = 𝔽_q` has `q ≡ 3 (mod 4)` (`CLAUDE.md` § Notation: `p ≡ 3 (mod 4)` and `f` odd), and `Γ_q` is
`unitQuadrance (𝓞 F ⧸ 𝔭)`. `E = F(t₁, …, t_n) ⊂ ℝ` is `pureTranscendental F t`, the subfield of `ℝ` generated by `F` and
the `tᵢ`. `IsPlaceHom F 𝔭 E V φ` packages PLACE-HOM's conclusion about `V` and `φ`, so that FALC-RES (ii) can quantify over
every such pair.
-/

namespace HadwigerNelson.Arith

open HadwigerNelson HadwigerNelson.RouteC NumberField SimpleGraph

/-- A usable prime of `F`: maximal, with residue field of size `q ≡ 3 (mod 4)`. -/
def IsUsablePrime {F : Subfield ℝ} (𝔭 : Ideal (𝓞 F)) : Prop := 𝔭.IsMaximal ∧ Nat.card (𝓞 F ⧸ 𝔭) % 4 = 3

/-- `F(t₁, …, t_n) ⊂ ℝ`, the subfield generated by `F` and the `tᵢ`. -/
noncomputable def pureTranscendental (F : Subfield ℝ) {n : ℕ} (t : Fin n → ℝ) : Subfield ℝ :=
  Subfield.closure ((F : Set ℝ) ∪ Set.range t)

/-- PLACE-HOM's conclusion about a pair `(V, φ)`: `V ⊆ E` a subring holding both coordinates of every unit vector of `E²`,
and `φ : V → 𝔽_q` a ring hom restricting to reduction mod `𝔭` on `𝒪_{F,𝔭}` (every `a/s`, `a, s ∈ 𝓞 F`, `s ∉ 𝔭`, lies in `V`
and `φ(a/s) · s̄ = ā`). -/
def IsPlaceHom (F : Subfield ℝ) (𝔭 : Ideal (𝓞 F)) (E : Subfield ℝ) (V : Subring ℝ) (φ : V →+* (𝓞 F ⧸ 𝔭)) : Prop :=
  (V : Set ℝ) ⊆ E ∧ (∀ a b : ℝ, a ∈ E → b ∈ E → a ^ 2 + b ^ 2 = 1 → a ∈ V ∧ b ∈ V) ∧
    ∀ a s : 𝓞 F, s ∉ 𝔭 → ∃ h : ((a : F) : ℝ) / ((s : F) : ℝ) ∈ V,
      φ ⟨_, h⟩ * Ideal.Quotient.mk 𝔭 s = Ideal.Quotient.mk 𝔭 a

/-! ## FS131-K2d: children of `exists_placeHom` and `noAffine_fields`

Each child was stated and priced in `plans/FS131-w2-kernel-plan.md` § 15 (route, Mathlib names confirmed with `#check`, order); all are proved.
`exists_placeHom` is induction on `n` **generalizing the base field** (stage 9.3): the base is the localization of `𝓞 F` at `𝔭`
inside `F ⊆ ℝ`, the step is evaluation at `t = 0` (`zeroPlace`, `evalZero`), and the homomorphism is the coset construction of
`unitQuadrance_colorable_of_subring`. -/

/-- `F(t₁, …, t₀) = F`. -/
theorem pureTranscendental_zero (F : Subfield ℝ) (t : Fin 0 → ℝ) : pureTranscendental F t = F := by
  unfold pureTranscendental
  rw [Set.range_eq_empty, Set.union_empty, Subfield.closure_eq]

/-- **The last variable**: `F(t₁, …, t_{n+1}) = F(t₁, …, t_n)(t_{n+1})`. -/
theorem pureTranscendental_succ (F : Subfield ℝ) {n : ℕ} (t : Fin (n + 1) → ℝ) :
    pureTranscendental F t = adjoinTranscendental (pureTranscendental F (Fin.init t)) (t (Fin.last n)) := by
  unfold pureTranscendental adjoinTranscendental
  rw [IntermediateField.adjoin_toSubfield]
  apply le_antisymm
  · rw [Subfield.closure_le]
    rintro x (hx | ⟨i, rfl⟩)
    · exact Subfield.subset_closure (Or.inl ⟨⟨x, Subfield.subset_closure (Or.inl hx)⟩, rfl⟩)
    · induction i using Fin.lastCases with
      | last => exact Subfield.subset_closure (Or.inr rfl)
      | cast j =>
        exact Subfield.subset_closure (Or.inl ⟨⟨t j.castSucc, Subfield.subset_closure (Or.inr ⟨j, rfl⟩)⟩, rfl⟩)
  · rw [Subfield.closure_le]
    rintro x (⟨y, rfl⟩ | hx)
    · refine Subfield.closure_mono ?_ y.2
      rintro z (hz | ⟨j, rfl⟩)
      · exact Or.inl hz
      · exact Or.inr ⟨j.castSucc, rfl⟩
    · rw [Set.mem_singleton_iff.1 hx]
      exact Subfield.subset_closure (Or.inr ⟨_, rfl⟩)

/-- **Algebraic independence, peeled**: the first `n` variables stay independent, and the last is transcendental over the
field they generate with `F` (`AlgebraicIndependent.transcendental_adjoin`, `IntermediateField.transcendental_adjoin_iff`). -/
theorem algebraicIndependent_init_and_transcendental_last (F : Subfield ℝ) {n : ℕ} {t : Fin (n + 1) → ℝ}
    (ht : AlgebraicIndependent F t) :
    AlgebraicIndependent F (Fin.init t) ∧ Transcendental (pureTranscendental F (Fin.init t)) (t (Fin.last n)) := by
  refine ⟨ht.comp Fin.castSucc (Fin.castSucc_injective n), ?_⟩
  have h1 := ht.transcendental_adjoin (s := Set.range Fin.castSucc) (i := Fin.last n)
    (by rintro ⟨j, hj⟩; exact Fin.castSucc_ne_last j hj)
  rw [← Set.range_comp] at h1
  have h2 := IntermediateField.transcendental_adjoin_iff.2 h1
  have e : pureTranscendental F (Fin.init t) = (IntermediateField.adjoin F (Set.range (t ∘ Fin.castSucc))).toSubfield := by
    rw [IntermediateField.adjoin_toSubfield]
    unfold pureTranscendental
    congr 1
    ext x
    simp only [Set.mem_union, Set.mem_range, SetLike.mem_coe]
    constructor
    · rintro (hx | ⟨j, rfl⟩)
      · exact Or.inl ⟨⟨x, hx⟩, rfl⟩
      · exact Or.inr ⟨j, rfl⟩
    · rintro (⟨y, rfl⟩ | ⟨j, rfl⟩)
      · exact Or.inl y.2
      · exact Or.inr ⟨j, rfl⟩
  rw [e]
  exact h2

/-- **The base: the localization at `𝔭` is a valuation subring of `F`.** Its elements are the `a/s`, `a, s ∈ 𝓞 F`, `s ∉ 𝔭`
(`IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain`, `ValuationRing.iff_isInteger_or_isInteger`). -/
theorem exists_valuationSubring_localization (F : Subfield ℝ) [NumberField F] {𝔭 : Ideal (𝓞 F)} (h𝔭 : 𝔭.IsMaximal) :
    ∃ B : ValuationSubring F, ∀ x : F, x ∈ B ↔ ∃ a s : 𝓞 F, s ∉ 𝔭 ∧ x = (a : F) / (s : F) := by
  haveI : 𝔭.IsPrime := h𝔭.isPrime
  have hS : 𝔭.primeCompl ≤ nonZeroDivisors (𝓞 F) := Ideal.primeCompl_le_nonZeroDivisors 𝔭
  let Bs := Localization.subalgebra.ofField F 𝔭.primeCompl hS
  have hne : 𝔭 ≠ ⊥ := Ring.ne_bot_of_isMaximal_of_not_isField h𝔭 (NumberField.RingOfIntegers.not_isField F)
  haveI : IsLocalization.AtPrime Bs 𝔭 := Localization.subalgebra.isLocalization_ofField F 𝔭.primeCompl hS
  haveI : IsDiscreteValuationRing Bs :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (𝓞 F) hne Bs
  have hval := (ValuationRing.iff_isInteger_or_isInteger Bs F).1 inferInstance
  have hmem : ∀ x : F, IsLocalization.IsInteger Bs x → x ∈ Bs := fun x ⟨y, hy⟩ => hy ▸ y.2
  refine ⟨ValuationSubring.ofSubring Bs.toSubring (fun x => (hval x).imp (hmem x) (hmem _)), fun x => ?_⟩
  rw [ValuationSubring.mem_ofSubring]
  show (∃ (a s : 𝓞 F) (_ : s ∈ 𝔭.primeCompl), x = algebraMap (𝓞 F) F a * (algebraMap (𝓞 F) F s)⁻¹) ↔ _
  constructor
  · rintro ⟨a, s, hs, rfl⟩; exact ⟨a, s, hs, by rw [div_eq_mul_inv]⟩
  · rintro ⟨a, s, hs, rfl⟩; exact ⟨a, s, hs, by rw [div_eq_mul_inv]⟩

/-- **The base: its residue map** onto `𝓞 F ⧸ 𝔭`, `a/s ↦ ā s̄⁻¹` (well defined by cross-multiplication), killing exactly the
non-units. -/
theorem exists_residue_localization (F : Subfield ℝ) [NumberField F] {𝔭 : Ideal (𝓞 F)} (h𝔭 : 𝔭.IsMaximal)
    (B : ValuationSubring F) (hB : ∀ x : F, x ∈ B ↔ ∃ a s : 𝓞 F, s ∉ 𝔭 ∧ x = (a : F) / (s : F)) :
    ∃ r : B →+* (𝓞 F ⧸ 𝔭), (∀ (a s : 𝓞 F) (hs : s ∉ 𝔭),
        r ⟨(a : F) / (s : F), (hB _).2 ⟨a, s, hs, rfl⟩⟩ * Ideal.Quotient.mk 𝔭 s = Ideal.Quotient.mk 𝔭 a) ∧
      ∀ x : B, r x ≠ 0 → (x : F) ∉ B.nonunits := by
  haveI : 𝔭.IsPrime := h𝔭.isPrime
  have hS : 𝔭.primeCompl ≤ nonZeroDivisors (𝓞 F) := Ideal.primeCompl_le_nonZeroDivisors 𝔭
  let Bs := Localization.subalgebra.ofField F 𝔭.primeCompl hS
  haveI : IsLocalization 𝔭.primeCompl Bs := Localization.subalgebra.isLocalization_ofField F 𝔭.primeCompl hS
  have hBs : ∀ x : F, x ∈ B → x ∈ Bs := fun x hx => by
    obtain ⟨a, s, hs, rfl⟩ := (hB x).1 hx
    exact ⟨a, s, hs, by rw [div_eq_mul_inv]⟩
  letI : Field (𝓞 F ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  have hunit : ∀ y : 𝔭.primeCompl, IsUnit ((Ideal.Quotient.mk 𝔭) (y : 𝓞 F)) := fun y =>
    isUnit_iff_ne_zero.2 (fun h => y.2 (Ideal.Quotient.eq_zero_iff_mem.1 h))
  let L : Bs →+* 𝓞 F ⧸ 𝔭 := IsLocalization.lift hunit
  let r : B →+* 𝓞 F ⧸ 𝔭 :=
    { toFun := fun x => L ⟨x.1, hBs x.1 x.2⟩
      map_one' := L.map_one
      map_mul' := fun x y => L.map_mul ⟨x.1, hBs x.1 x.2⟩ ⟨y.1, hBs y.1 y.2⟩
      map_zero' := L.map_zero
      map_add' := fun x y => L.map_add ⟨x.1, hBs x.1 x.2⟩ ⟨y.1, hBs y.1 y.2⟩ }
  have hLa : ∀ a : 𝓞 F, L (algebraMap (𝓞 F) Bs a) = Ideal.Quotient.mk 𝔭 a := fun a => IsLocalization.lift_eq hunit a
  have hs0 : ∀ s : 𝓞 F, s ∉ 𝔭 → ((s : 𝓞 F) : F) ≠ 0 := by
    intro s hs h
    apply hs
    have : s = 0 := by exact_mod_cast h
    rw [this]; exact 𝔭.zero_mem
  have hdiv : ∀ (a s : 𝓞 F) (hs : s ∉ 𝔭),
      r ⟨(a : F) / (s : F), (hB _).2 ⟨a, s, hs, rfl⟩⟩ * Ideal.Quotient.mk 𝔭 s = Ideal.Quotient.mk 𝔭 a := by
    intro a s hs
    have key : (⟨(a : F) / (s : F), hBs _ ((hB _).2 ⟨a, s, hs, rfl⟩)⟩ : Bs) * algebraMap (𝓞 F) Bs s =
        algebraMap (𝓞 F) Bs a := Subtype.ext (by
      show (a : F) / (s : F) * (s : F) = (a : F)
      exact div_mul_cancel₀ _ (hs0 s hs))
    show L _ * _ = _
    rw [← hLa s, ← L.map_mul, key, hLa]
  refine ⟨r, hdiv, fun x hx => ?_⟩
  obtain ⟨a, s, hs, hxe⟩ := (hB x).1 x.2
  have hxa : x = ⟨(a : F) / (s : F), (hB _).2 ⟨a, s, hs, rfl⟩⟩ := Subtype.ext hxe
  have ha : a ∉ 𝔭 := by
    intro ha
    have h1 := hdiv a s hs
    rw [Ideal.Quotient.eq_zero_iff_mem.2 ha, ← hxa] at h1
    exact hx ((mul_eq_zero.1 h1).resolve_right (fun h => hs (Ideal.Quotient.eq_zero_iff_mem.1 h)))
  have hinv : (x : F)⁻¹ ∈ B := by
    rw [hxe, inv_div]; exact (hB _).2 ⟨s, a, ha, rfl⟩
  have hx0 : (x : F) ≠ 0 := by
    rw [hxe]; exact div_ne_zero (hs0 a ha) (hs0 s hs)
  rw [ValuationSubring.mem_nonunits_iff]
  intro hlt
  have h1 : B.valuation (x : F)⁻¹ ≤ 1 := (B.valuation_le_one_iff _).2 hinv
  have h2 : B.valuation ((x : F) * (x : F)⁻¹) < 1 := by
    rw [map_mul]
    calc B.valuation (x : F) * B.valuation (x : F)⁻¹ ≤ B.valuation (x : F) * 1 := by gcongr
      _ < 1 := by rw [mul_one]; exact hlt
  rw [mul_inv_cancel₀ hx0, map_one] at h2
  exact lt_irrefl _ h2

/-- **PLACE-HOM at `n = 0`**: the localization at a usable prime, carried into `ℝ`, with its residue map. Unit vectors of `F²`
are integral there because `−1` is not a square in `𝔽_q`, `q ≡ 3 (mod 4)` (`FiniteField.isSquare_neg_one_iff`,
`mem_valuationSubring_of_sq_add_sq_eq_one`). -/
theorem placeHom_base (F : Subfield ℝ) [NumberField F] {𝔭 : Ideal (𝓞 F)} (h𝔭 : IsUsablePrime 𝔭) :
    ∃ (V : Subring ℝ) (φ : V →+* (𝓞 F ⧸ 𝔭)), IsPlaceHom F 𝔭 F V φ := by
  haveI : 𝔭.IsMaximal := h𝔭.1
  letI : Field (𝓞 F ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  obtain ⟨B, hB⟩ := exists_valuationSubring_localization F h𝔭.1
  obtain ⟨r, hr1, hr2⟩ := exists_residue_localization F h𝔭.1 B hB
  let e := Subring.equivMapOfInjective B.toSubring F.subtype Subtype.val_injective
  let r' : B.toSubring →+* 𝓞 F ⧸ 𝔭 := r
  refine ⟨B.toSubring.map F.subtype, r'.comp e.symm.toRingHom, ?_, ?_, ?_⟩
  · rintro y ⟨x, -, rfl⟩; exact x.2
  · intro a b ha hb hab
    haveI : Finite (𝓞 F ⧸ 𝔭) := Nat.finite_of_card_ne_zero (fun h => by have := h𝔭.2; rw [h] at this; norm_num at this)
    letI : Fintype (𝓞 F ⧸ 𝔭) := Fintype.ofFinite _
    have hsq : ¬ IsSquare (-1 : 𝓞 F ⧸ 𝔭) := by
      rw [FiniteField.isSquare_neg_one_iff, ← Nat.card_eq_fintype_card, not_not]; exact h𝔭.2
    have hnon : ∀ x ∈ B, 1 + x ^ 2 ∉ B.nonunits := by
      intro x hx
      refine hr2 ⟨1 + x ^ 2, add_mem B.one_mem (pow_mem hx 2)⟩ ?_
      have : (⟨1 + x ^ 2, add_mem B.one_mem (pow_mem hx 2)⟩ : B) = 1 + ⟨x, hx⟩ ^ 2 := rfl
      rw [this, map_add, map_one, map_pow]
      intro h
      exact hsq ⟨r ⟨x, hx⟩, by linear_combination -h⟩
    have hab' : (⟨a, ha⟩ : F) ^ 2 + (⟨b, hb⟩ : F) ^ 2 = 1 := Subtype.ext (by simpa using hab)
    obtain ⟨haB, hbB⟩ := mem_valuationSubring_of_sq_add_sq_eq_one B hnon hab'
    exact ⟨⟨_, haB, rfl⟩, ⟨_, hbB, rfl⟩⟩
  · intro a s hs
    have hmemB := (hB _).2 ⟨a, s, hs, rfl⟩
    have h : ((a : F) : ℝ) / ((s : F) : ℝ) ∈ B.toSubring.map F.subtype :=
      ⟨(a : F) / (s : F), hmemB, by simp⟩
    refine ⟨h, ?_⟩
    have he : e.symm ⟨_, h⟩ = ⟨(a : F) / (s : F), hmemB⟩ := by
      rw [RingEquiv.symm_apply_eq]; exact Subtype.ext (by simp [e])
    show r' (e.symm ⟨_, h⟩) * _ = _
    rw [he]
    exact hr1 a s hs

/-- **PLACE-HOM's step**: a place-hom pair over `E₀` extends over `E₀(s)`, `s` transcendental over `E₀` — `V₁` the elements of
`E₀(s)` regular at `s = 0` whose value there is in `V₀`, `φ₁ = φ₀ ∘ evalZero` (through `adjoinTranscendentalEquiv`); unit vectors
of `E₀(s)²` are regular at `0` (`mem_valuationSubring_of_sq_add_sq_eq_one` at `zeroPlace`) and evaluate to unit vectors of `E₀²`. -/
theorem placeHom_step (F : Subfield ℝ) [NumberField F] {𝔭 : Ideal (𝓞 F)} {E₀ : Subfield ℝ} {V₀ : Subring ℝ}
    {φ₀ : V₀ →+* (𝓞 F ⧸ 𝔭)} (h₀ : IsPlaceHom F 𝔭 E₀ V₀ φ₀) {s : ℝ} (hs : Transcendental E₀ s) :
    ∃ (V₁ : Subring ℝ) (φ₁ : V₁ →+* (𝓞 F ⧸ 𝔭)), IsPlaceHom F 𝔭 (adjoinTranscendental E₀ s) V₁ φ₁ := by
  classical
  let L := adjoinTranscendentalEquiv E₀ hs
  let g : zeroPlace E₀ →+* ℝ := E₀.subtype.comp (evalZero E₀)
  let W₀ : Subring (zeroPlace E₀) := V₀.comap g
  let W : Subring (RatFunc E₀) := W₀.map (zeroPlace E₀).subtype
  let U : Subring (adjoinTranscendental E₀ s) := W.comap L.toRingHom
  let V₁ : Subring ℝ := U.map (adjoinTranscendental E₀ s).subtype
  let e₁ := Subring.equivMapOfInjective U (adjoinTranscendental E₀ s).subtype Subtype.val_injective
  let e₂ := Subring.equivMapOfInjective W₀ (zeroPlace E₀).subtype Subtype.val_injective
  let ρ₁ : U →+* W := L.toRingHom.restrict U W (fun _ hx => hx)
  let ρ₂ : W₀ →+* V₀ := g.restrict W₀ V₀ (fun _ hx => hx)
  let φ₁ : V₁ →+* (𝓞 F ⧸ 𝔭) := φ₀.comp (ρ₂.comp (e₂.symm.toRingHom.comp (ρ₁.comp e₁.symm.toRingHom)))
  -- constants: `L c = C c`, regular at `0` with value `c`
  have hLc : ∀ (c : ℝ) (hc : c ∈ E₀), L ⟨c, le_adjoinTranscendental E₀ s hc⟩ = RatFunc.C ⟨c, hc⟩ := by
    intro c hc
    rw [← RatFunc.algebraMap_eq_C]
    exact (RatFunc.algEquivOfTranscendental s hs).symm.commutes ⟨c, hc⟩
  have hCz : ∀ (c : ℝ) (hc : c ∈ E₀), RatFunc.C (⟨c, hc⟩ : E₀) ∈ zeroPlace E₀ := by
    intro c hc
    rw [mem_zeroPlace, RatFunc.denom_C]; simp
  have hgC : ∀ (c : ℝ) (hc : c ∈ E₀), g ⟨RatFunc.C ⟨c, hc⟩, hCz c hc⟩ = c := by
    intro c hc
    show ((evalZero E₀ ⟨RatFunc.C ⟨c, hc⟩, hCz c hc⟩ : E₀) : ℝ) = c
    rw [evalZero_apply, RatFunc.eval_C]; rfl
  refine ⟨V₁, φ₁, ?_, ?_, ?_⟩
  · rintro y ⟨x, -, rfl⟩; exact x.2
  · intro a b ha hb hab
    have hnon : ∀ x ∈ zeroPlace E₀, 1 + x ^ 2 ∉ (zeroPlace E₀).nonunits := by
      intro x hx hmem
      obtain ⟨hm, hmax⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.1 hmem
      have h0 := evalZero_eq_zero_of_mem_maximalIdeal E₀ _ hmax
      have : (⟨1 + x ^ 2, hm⟩ : zeroPlace E₀) = 1 + ⟨x, hx⟩ ^ 2 := rfl
      rw [this, map_add, map_one, map_pow] at h0
      exact one_add_sq_ne_zero_of_subfield E₀ _ h0
    have hab' : L ⟨a, ha⟩ ^ 2 + L ⟨b, hb⟩ ^ 2 = 1 := by
      rw [← map_pow, ← map_pow, ← map_add]
      have : (⟨a, ha⟩ : adjoinTranscendental E₀ s) ^ 2 + ⟨b, hb⟩ ^ 2 = 1 := Subtype.ext (by simpa using hab)
      rw [this, map_one]
    obtain ⟨haz, hbz⟩ := mem_valuationSubring_of_sq_add_sq_eq_one (zeroPlace E₀) hnon hab'
    have hpq : (⟨_, haz⟩ : zeroPlace E₀) ^ 2 + ⟨_, hbz⟩ ^ 2 = 1 := Subtype.ext (by simpa using hab')
    have hgq : g ⟨_, haz⟩ ^ 2 + g ⟨_, hbz⟩ ^ 2 = 1 := by
      rw [← map_pow, ← map_pow, ← map_add, hpq, map_one]
    obtain ⟨hga, hgb⟩ := h₀.2.1 _ _ (evalZero E₀ ⟨_, haz⟩).2 (evalZero E₀ ⟨_, hbz⟩).2 hgq
    exact ⟨⟨⟨a, ha⟩, ⟨⟨_, haz⟩, hga, rfl⟩, rfl⟩, ⟨⟨b, hb⟩, ⟨⟨_, hbz⟩, hgb, rfl⟩, rfl⟩⟩
  · intro a s' hs'
    obtain ⟨h0, hφ0⟩ := h₀.2.2 a s' hs'
    set c : ℝ := ((a : F) : ℝ) / ((s' : F) : ℝ) with hc_def
    have hc : c ∈ E₀ := h₀.1 h0
    have hW₀ : (⟨RatFunc.C ⟨c, hc⟩, hCz c hc⟩ : zeroPlace E₀) ∈ W₀ := by
      show g _ ∈ V₀; rw [hgC]; exact h0
    have hU : (⟨c, le_adjoinTranscendental E₀ s hc⟩ : adjoinTranscendental E₀ s) ∈ U := by
      show L _ ∈ W; rw [hLc c hc]; exact ⟨_, hW₀, rfl⟩
    have h1 : c ∈ V₁ := ⟨_, hU, rfl⟩
    refine ⟨h1, ?_⟩
    have he₁ : e₁.symm ⟨c, h1⟩ = ⟨_, hU⟩ := by
      rw [RingEquiv.symm_apply_eq]; rfl
    have he₂ : e₂.symm (ρ₁ ⟨_, hU⟩) = ⟨_, hW₀⟩ := by
      rw [RingEquiv.symm_apply_eq]; exact Subtype.ext (hLc c hc)
    have hρ₂ : ρ₂ ⟨_, hW₀⟩ = ⟨c, h0⟩ := Subtype.ext (hgC c hc)
    show φ₀ (ρ₂ (e₂.symm (ρ₁ (e₁.symm ⟨c, h1⟩)))) * _ = _
    rw [he₁, he₂, hρ₂]
    exact hφ0

/-- **PLACE-HOM's pair**, by induction on `n` from `placeHom_base` through `placeHom_step`. -/
theorem exists_isPlaceHom (F : Subfield ℝ) [NumberField F] {𝔭 : Ideal (𝓞 F)} (h𝔭 : IsUsablePrime 𝔭) :
    ∀ {n : ℕ} (t : Fin n → ℝ), AlgebraicIndependent F t →
      ∃ (V : Subring ℝ) (φ : V →+* (𝓞 F ⧸ 𝔭)), IsPlaceHom F 𝔭 (pureTranscendental F t) V φ := by
  intro n
  induction n with
  | zero =>
    intro t _
    rw [pureTranscendental_zero]
    exact placeHom_base F h𝔭
  | succ n ih =>
    intro t ht
    obtain ⟨hinit, hlast⟩ := algebraicIndependent_init_and_transcendental_last F ht
    obtain ⟨V₀, φ₀, h₀⟩ := ih (Fin.init t) hinit
    rw [pureTranscendental_succ]
    exact placeHom_step F h₀ hlast

/-- **The homomorphism from a place-hom pair**: on each coset `x₀ + V²` of the plane over `E`, `x ↦ (φ, φ)(x − x₀)`
(`cosetResidue`, as in `unitQuadrance_colorable_of_subring`); a unit edge's difference is a unit vector with coordinates in `V`,
which `φ` carries to the circle. -/
theorem exists_hom_of_isPlaceHom {F : Subfield ℝ} {𝔭 : Ideal (𝓞 F)} [𝔭.IsMaximal] {E : Subfield ℝ} {V : Subring ℝ}
    {φ : V →+* (𝓞 F ⧸ 𝔭)} (hφ : IsPlaceHom F 𝔭 E V φ) :
    ∃ h : (unitDistance ℂ).induce (planeOver E) →g unitQuadrance (𝓞 F ⧸ 𝔭),
      ∀ x y : planeOver E, ∀ (hre : (x : ℂ).re - (y : ℂ).re ∈ V) (him : (x : ℂ).im - (y : ℂ).im ∈ V),
        h x - h y = (φ ⟨_, hre⟩, φ ⟨_, him⟩) := by
  have hV0 : ∀ (r : ℝ) (hr : r ∈ V), r = 0 → φ ⟨r, hr⟩ = 0 := by
    rintro r hr rfl; exact map_zero φ
  have hVadd : ∀ (r s : ℝ) (hr : r ∈ V) (hs : s ∈ V) (hrs : r + s ∈ V),
      φ ⟨r + s, hrs⟩ = φ ⟨r, hr⟩ + φ ⟨s, hs⟩ := by
    intro r s hr hs hrs; rw [← map_add]; rfl
  let P : AddSubgroup ℂ :=
    { carrier := {z | z.re ∈ V ∧ z.im ∈ V}
      add_mem' := fun ha hb => ⟨by simpa using V.add_mem ha.1 hb.1, by simpa using V.add_mem ha.2 hb.2⟩
      zero_mem' := ⟨by simp, by simp⟩
      neg_mem' := fun ha => ⟨by simpa using V.neg_mem ha.1, by simpa using V.neg_mem ha.2⟩ }
  let ψ : P →+ (𝓞 F ⧸ 𝔭) × (𝓞 F ⧸ 𝔭) :=
    { toFun := fun z => (φ ⟨(z : ℂ).re, z.2.1⟩, φ ⟨(z : ℂ).im, z.2.2⟩)
      map_zero' := Prod.ext (hV0 _ _ (by simp)) (hV0 _ _ (by simp))
      map_add' := fun z w => Prod.ext (by simpa using hVadd _ _ z.2.1 w.2.1 (by simpa using (z + w).2.1))
        (by simpa using hVadd _ _ z.2.2 w.2.2 (by simpa using (z + w).2.2)) }
  have hres : ∀ x y : planeOver E, ∀ (hre : (x : ℂ).re - (y : ℂ).re ∈ V) (him : (x : ℂ).im - (y : ℂ).im ∈ V),
      cosetResidue ψ (x : ℂ) - cosetResidue ψ (y : ℂ) = (φ ⟨_, hre⟩, φ ⟨_, him⟩) := by
    intro x y hre him
    have hmem : (x : ℂ) - y ∈ P := ⟨by simpa using hre, by simpa using him⟩
    rw [cosetResidue_sub ψ hmem, cosetResidue_apply_of_mem ψ hmem]
    exact Prod.ext (congrArg φ (Subtype.ext (by simp))) (congrArg φ (Subtype.ext (by simp)))
  refine ⟨{ toFun := fun x => cosetResidue ψ (x : ℂ), map_rel' := ?_ }, hres⟩
  intro x y hxy
  have hd : dist (x : ℂ) (y : ℂ) = 1 := hxy
  have hreE : ((x : ℂ) - y).re ∈ E := by simpa using E.sub_mem x.2.1 y.2.1
  have himE : ((x : ℂ) - y).im ∈ E := by simpa using E.sub_mem x.2.2 y.2.2
  have hn : ((x : ℂ) - y).re ^ 2 + ((x : ℂ) - y).im ^ 2 = 1 := by
    have h1 : ‖(x : ℂ) - y‖ = 1 := by rw [← dist_eq_norm]; exact hd
    have h2 := Complex.sq_norm ((x : ℂ) - y)
    rw [h1, Complex.normSq_apply] at h2
    nlinarith [h2]
  obtain ⟨hur, hui⟩ := hφ.2.1 _ _ hreE himE hn
  have hre : (x : ℂ).re - (y : ℂ).re ∈ V := by simpa using hur
  have him : (x : ℂ).im - (y : ℂ).im ∈ V := by simpa using hui
  have hq : (φ ⟨_, hre⟩) ^ 2 + (φ ⟨_, him⟩) ^ 2 = 1 := by
    have : (⟨_, hre⟩ : V) ^ 2 + ⟨_, him⟩ ^ 2 = 1 := Subtype.ext (by simpa using hn)
    simpa only [map_add, map_pow, map_one] using congrArg φ this
  have hsub := hres x y hre him
  show (unitQuadrance _).Adj (cosetResidue ψ (x : ℂ)) (cosetResidue ψ (y : ℂ))
  rw [unitQuadrance_adj]
  refine ⟨fun heq => ?_, ?_⟩
  · rw [heq, sub_self] at hsub
    have h1 : φ ⟨_, hre⟩ = 0 := (congrArg Prod.fst hsub).symm
    have h2 : φ ⟨_, him⟩ = 0 := (congrArg Prod.snd hsub).symm
    rw [h1, h2] at hq
    simp at hq
  · rw [show (cosetResidue ψ (x : ℂ)).1 - (cosetResidue ψ (y : ℂ)).1 = φ ⟨_, hre⟩ from congrArg Prod.fst hsub,
      show (cosetResidue ψ (x : ℂ)).2 - (cosetResidue ψ (y : ℂ)).2 = φ ⟨_, him⟩ from congrArg Prod.snd hsub]
    exact hq

/-- **FS129-SA1-PLACE-HOM**: for a number field `F ⊆ ℝ` with a usable prime `𝔭` and `t₁, …, t_n` algebraically independent
over `F`, there are `V` and `φ` as in `IsPlaceHom`; so the unit-distance graph on `E²` has a homomorphism into `Γ_q`, given on
each coset `x₀ + V²` by `x ↦ φ(x − x₀)`. -/
theorem exists_placeHom (F : Subfield ℝ) [NumberField F] {𝔭 : Ideal (𝓞 F)} (h𝔭 : IsUsablePrime 𝔭) {n : ℕ}
    (t : Fin n → ℝ) (ht : AlgebraicIndependent F t) :
    ∃ (V : Subring ℝ) (φ : V →+* (𝓞 F ⧸ 𝔭)), IsPlaceHom F 𝔭 (pureTranscendental F t) V φ ∧
      ∃ h : (unitDistance ℂ).induce (planeOver (pureTranscendental F t)) →g unitQuadrance (𝓞 F ⧸ 𝔭),
        ∀ x y : planeOver (pureTranscendental F t), ∀ (hre : (x : ℂ).re - (y : ℂ).re ∈ V)
          (him : (x : ℂ).im - (y : ℂ).im ∈ V), h x - h y = (φ ⟨_, hre⟩, φ ⟨_, him⟩) := by
  haveI : 𝔭.IsMaximal := h𝔭.1
  obtain ⟨V, φ, hφ⟩ := exists_isPlaceHom F h𝔭 t ht
  exact ⟨V, φ, hφ, exists_hom_of_isPlaceHom hφ⟩

/-- The field hypotheses of NOAFF-FIELDS at `k`: `k = 5` and a usable prime with residue field `𝔽₁₁` or `𝔽₁₉`, or `χ(F²) ≤ 4`;
or `k = 4` and a usable prime with residue field `𝔽₇`, or `χ(F²) ≤ 3`. -/
def NoAffFieldHyp (F : Subfield ℝ) (k : ℕ) : Prop :=
  (k = 5 ∧ ((∃ 𝔭 : Ideal (𝓞 F), IsUsablePrime 𝔭 ∧ (Nat.card (𝓞 F ⧸ 𝔭) = 11 ∨ Nat.card (𝓞 F ⧸ 𝔭) = 19)) ∨
      ((unitDistance ℂ).induce (planeOver F)).chromaticNumber ≤ 4)) ∨
    (k = 4 ∧ ((∃ 𝔭 : Ideal (𝓞 F), IsUsablePrime 𝔭 ∧ Nat.card (𝓞 F ⧸ 𝔭) = 7) ∨
      ((unitDistance ℂ).induce (planeOver F)).chromaticNumber ≤ 3))

/-- **Transcendence is free, `n` times** (row 104 iterated): `χ(F(t₁, …, t_n)²) = χ(F²)` for algebraically independent `tᵢ`
(`chromaticNumber_planeOver_adjoin_transcendental_eq` through `pureTranscendental_succ`). -/
theorem chromaticNumber_planeOver_pureTranscendental_eq (F : Subfield ℝ) {n : ℕ} (t : Fin n → ℝ)
    (ht : AlgebraicIndependent F t) :
    ((unitDistance ℂ).induce (planeOver (pureTranscendental F t))).chromaticNumber =
      ((unitDistance ℂ).induce (planeOver F)).chromaticNumber := by
  induction n with
  | zero => rw [pureTranscendental_zero]
  | succ n ih =>
    obtain ⟨hinit, hlast⟩ := algebraicIndependent_init_and_transcendental_last F ht
    rw [pureTranscendental_succ, chromaticNumber_planeOver_adjoin_transcendental_eq _ hlast, ih _ hinit]

/-- A commutative ring of prime cardinality `p` is `ZMod p` (`ZMod.ringEquivOfPrime`, with `Fintype` from `Nat.card ≠ 0`). -/
theorem nonempty_ringEquiv_zmod_of_card {R : Type*} [CommRing R] {p : ℕ} (hp : p.Prime) (h : Nat.card R = p) :
    Nonempty (R ≃+* ZMod p) := by
  haveI : Finite R := Nat.finite_of_card_ne_zero (by rw [h]; exact hp.ne_zero)
  letI : Fintype R := Fintype.ofFinite R
  exact ⟨(ZMod.ringEquivOfPrime R hp (by rw [← Nat.card_eq_fintype_card, h])).symm⟩

/-- **The plane over `E = F(t₁, …, t_n)` maps to `UD(𝔽_p, 2)`** at a usable prime with residue field of prime size `p`:
`exists_placeHom` composed with `unitQuadrance.map` of the ring isomorphism. -/
theorem exists_hom_finitePlane_of_card (F : Subfield ℝ) [NumberField F] {n : ℕ} (t : Fin n → ℝ)
    (ht : AlgebraicIndependent F t) {𝔭 : Ideal (𝓞 F)} (h𝔭 : IsUsablePrime 𝔭) {p : ℕ} (hp : p.Prime)
    (hcard : Nat.card (𝓞 F ⧸ 𝔭) = p) :
    Nonempty ((unitDistance ℂ).induce (planeOver (pureTranscendental F t)) →g finitePlane p) := by
  haveI : 𝔭.IsMaximal := h𝔭.1
  obtain ⟨V, φ, -, h, -⟩ := exists_placeHom F h𝔭 t ht
  obtain ⟨e⟩ := nonempty_ringEquiv_zmod_of_card hp hcard
  haveI : Fact p.Prime := ⟨hp⟩
  exact ⟨(unitQuadrance.map e.toRingHom).comp h⟩

/-- **The complete graph on `k` vertices is slack at `k + 1` colours**: colour `k` is absent everywhere. -/
theorem slack_complete (k : ℕ) : Slack (⊤ : SimpleGraph (Fin k)) (k + 1) := by
  intro v
  refine ⟨SimpleGraph.Coloring.mk Fin.castSucc (fun {u w} huw heq => huw (Fin.castSucc_injective _ heq)),
    Fin.last k, ?_, ?_⟩
  · exact (Fin.castSucc_lt_last v).ne'
  · intro w _
    exact (Fin.castSucc_lt_last w).ne

/-- **NOAFF's targets**: under the field hypotheses at `k`, the plane over `E` maps to a graph slack at `k` colours — `Γ₁₁`,
`Γ₁₉` (`finitePlane11_slack`, `finitePlane19_slack`), `Γ₇` (`finitePlane7_slack`), or `K_{k−1}` when `χ(F²) ≤ k − 1`. -/
theorem exists_hom_slack (F : Subfield ℝ) [NumberField F] {n : ℕ} (t : Fin n → ℝ) (ht : AlgebraicIndependent F t)
    {k : ℕ} (hk : NoAffFieldHyp F k) :
    ∃ (W : Type) (T : SimpleGraph W), Slack T k ∧
      Nonempty ((unitDistance ℂ).induce (planeOver (pureTranscendental F t)) →g T) := by
  rcases hk with ⟨rfl, ⟨𝔭, h𝔭, h11 | h19⟩ | hχ⟩ | ⟨rfl, ⟨𝔭, h𝔭, h7⟩ | hχ⟩
  · exact ⟨_, finitePlane 11, finitePlane11_slack, exists_hom_finitePlane_of_card F t ht h𝔭 (by norm_num) h11⟩
  · exact ⟨_, finitePlane 19, finitePlane19_slack, exists_hom_finitePlane_of_card F t ht h𝔭 (by norm_num) h19⟩
  · refine ⟨Fin 4, ⊤, slack_complete 4, ?_⟩
    rw [← chromaticNumber_planeOver_pureTranscendental_eq F t ht] at hχ
    obtain ⟨C⟩ := (SimpleGraph.chromaticNumber_le_iff_colorable (n := 4)).1 (by exact_mod_cast hχ)
    exact ⟨C⟩
  · exact ⟨_, finitePlane 7, finitePlane7_slack, exists_hom_finitePlane_of_card F t ht h𝔭 (by norm_num) h7⟩
  · refine ⟨Fin 3, ⊤, slack_complete 3, ?_⟩
    rw [← chromaticNumber_planeOver_pureTranscendental_eq F t ht] at hχ
    obtain ⟨C⟩ := (SimpleGraph.chromaticNumber_le_iff_colorable (n := 3)).1 (by exact_mod_cast hχ)
    exact ⟨C⟩

/-- **`noAffine` on a finite vertex set**: a homomorphism into a graph slack at `k ≥ 2` colours makes every `φ_v` constant
(`noAffine`'s second clause, with `finsum_eq_sum_of_fintype`). -/
theorem forall_const_of_hom_slack {V : Finset ℂ} {W : Type} {T : SimpleGraph W} {k : ℕ} (hk : 2 ≤ k) (hT : Slack T k)
    (ρ : (unitDistance ℂ).induce (V : Set ℂ) →g T) (φ : V → Fin k → ℝ) (b : ℝ)
    (hconst : ∀ C : ((unitDistance ℂ).induce (V : Set ℂ)).Coloring (Fin k), ∑ v, φ v (C v) = b) :
    ∀ v i j, φ v i = φ v j := by
  classical
  have h := (noAffine hk ρ φ (Set.toFinite _) b (fun C => by rw [finsum_eq_sum_of_fintype]; exact hconst C)).2
  refine (h (fun w => ?_)).1
  obtain ⟨C, γ, hgap⟩ := hT w
  refine ⟨C, γ, ?_⟩
  rintro x (rfl | hx)
  · exact Ne.symm hgap.1
  · exact hgap.2 x hx

/-- **FS129-SA1-NOAFF-FIELDS**: over `E = F(t₁, …, t_n)` with the field hypotheses at `k`, for every finite unit-distance
graph `H ⊂ E²` and every family `φ_v : Fin k → ℝ` with `Σ_v φ_v(C(v))` taking one value on every proper `k`-colouring of `H`,
every `φ_v` is constant. -/
theorem noAffine_fields (F : Subfield ℝ) [NumberField F] {n : ℕ} (t : Fin n → ℝ) (ht : AlgebraicIndependent F t)
    {k : ℕ} (hk : NoAffFieldHyp F k) (V : Finset ℂ) (hV : (V : Set ℂ) ⊆ planeOver (pureTranscendental F t))
    (φ : V → Fin k → ℝ) (b : ℝ)
    (hconst : ∀ C : ((unitDistance ℂ).induce (V : Set ℂ)).Coloring (Fin k), ∑ v, φ v (C v) = b) :
    ∀ v i j, φ v i = φ v j := by
  obtain ⟨W, T, hT, ⟨ρ⟩⟩ := exists_hom_slack F t ht hk
  have hk2 : 2 ≤ k := by rcases hk with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num
  exact forall_const_of_hom_slack hk2 hT (ρ.comp (SimpleGraph.induceHomOfLE _ hV).toHom) φ b hconst

end HadwigerNelson.Arith
