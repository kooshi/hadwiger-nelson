import Proofs.HadwigerNelson.SquareClass
import Mathlib.NumberTheory.Padics.Hensel
import Mathlib.NumberTheory.Padics.RingHoms
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.FieldTheory.Extension

/-!
# Degree-one primes of fields of square roots (FS-131, NF1-S2)

Claims: `data/fs131/claims-NF1.md` (NF1-S2, with its dated lines). Plan: `plans/FS131-KN2-upper-half-plan.md`.

**Read aloud, against the informal claim.** `ℚ(√D) ⊂ ℝ` is `SquareClass.fieldOfRadicands D`, the subfield of `ℝ` generated by
the `√d`, `d ∈ D ⊆ ℕ`; `𝓞 F` is Mathlib's ring of integers. The claim: for an odd prime `p`, if every radicand is a nonzero
square modulo `p` then `𝓞 (ℚ(√D))` has a maximal ideal `𝔭` whose quotient has exactly `p` elements
(`exists_maximal_card_eq`); and the same when one more radicand `q` is adjoined with `p ∣ q`, `p² ∤ q`
(`exists_maximal_card_eq_of_ramified`).

**Wider than the claim.** No radicand need be squarefree or exceed `1`, and `D` need not be finite: the proof never computes
the ring of integers. `√d` exists in `ℤ_p` (Hensel), so `ℚ(√D)` embeds in `ℚ_p` (`nonempty_ringHom_padic`); a field that
embeds in `ℚ_p` sends its integers to `ℤ_p`, which is integrally closed (`exists_ringHom_zmod_of_padic`); and the kernel of a
ring homomorphism onto `ℤ/p` is a maximal ideal with `p` elements in the quotient (`isMaximal_ker_and_card`). The claim's own
form, with `Squarefree d` and `1 < d` carried and unused, is `exists_maximal_card_eq_sqrt`.

**Narrower than the claim's second sentence as written**: "every radicand a square, a ramified radicand included" is false
with two radicands divisible by `p` — `ℚ(√11, √22) ∋ √2` and `2` is not a square modulo `11`, so every prime above `11` has
residue field of `121` elements. The ramified clause is stated for **one** radicand divisible by `p`, exactly once.

**Not claimed:** anything at `p = 2`; a prime where some radicand is a non-residue; that the ideal is unique.

**Inhabitants.** A homomorphism `K →+* ℚ_[p]` is the hypothesis that is a structure: `ℚ → ℚ_5` is exhibited in the spec,
and `nonempty_ringHom_padic` supplies one for every field of radicands that are nonzero squares modulo `p` (`{11}` at `7`).
-/

namespace HadwigerNelson.QuadraticPrime

open HadwigerNelson HadwigerNelson.SquareClass NumberField

/-! ## The field `ℚ(√D)` as a number field -/

/-- `√d` is integral over `ℚ` (a root of `X² − d`). -/
theorem isIntegral_sqrt_natCast (d : ℕ) : IsIntegral ℚ (Real.sqrt d) := by
  sorry

/-- `ℚ(√D)`, the closure of the square roots in `ℝ`, is the intermediate field of `ℝ/ℚ` they generate. -/
theorem fieldOfRadicands_eq_adjoin (D : Set ℕ) :
    fieldOfRadicands D = (IntermediateField.adjoin ℚ ((fun d : ℕ => Real.sqrt d) '' D)).toSubfield := by
  sorry

/-- **`ℚ(√D)` is a number field for finite `D`** (finitely many integral generators:
`IntermediateField.finiteDimensional_adjoin`). -/
theorem numberField_fieldOfRadicands {D : Set ℕ} (hD : D.Finite) : NumberField (fieldOfRadicands D) := by
  sorry

/-- The instance the statements about `𝓞 (ℚ(√D))` read. Global and named, so that no module downstream declares its own
(two anonymous instances of one proposition merge in silence: `LEAN.md` § The gate). -/
instance instNumberFieldFieldOfRadicands (D : Set ℕ) [Finite D] : NumberField (fieldOfRadicands D) :=
  numberField_fieldOfRadicands (Set.toFinite D)

/-! ## A homomorphism onto `ℤ/p` is a degree-one prime -/

/-- **The kernel of a ring homomorphism to `ℤ/p` is a maximal ideal with `p` elements in the quotient** (such a
homomorphism is onto: `ZMod.ringHom_surjective`). -/
theorem isMaximal_ker_and_card {R : Type*} [CommRing R] {p : ℕ} (hp : p.Prime) (f : R →+* ZMod p) :
    (RingHom.ker f).IsMaximal ∧ Nat.card (R ⧸ RingHom.ker f) = p := by
  sorry

/-- **The integers of a field that embeds in `ℚ_p` map to `ℤ/p`**: an integral element lands in `ℤ_p` (integrally closed
in `ℚ_p`), and `f x` is its residue there. -/
theorem exists_ringHom_zmod_of_padic {K : Type*} [Field K] {p : ℕ} [Fact p.Prime] (ι : K →+* ℚ_[p]) :
    ∃ f : 𝓞 K →+* ZMod p, ∀ (x : 𝓞 K) (z : ℤ_[p]), (z : ℚ_[p]) = ι (x : K) → f x = PadicInt.toZMod z := by
  sorry

/-- **A field that embeds in `ℚ_p` has a maximal ideal of its integers with `p` elements in the quotient.** -/
theorem exists_maximal_card_of_padic {K : Type*} [Field K] {p : ℕ} [Fact p.Prime] (ι : K →+* ℚ_[p]) :
    ∃ 𝔭 : Ideal (𝓞 K), 𝔭.IsMaximal ∧ Nat.card (𝓞 K ⧸ 𝔭) = p :=
  let ⟨f, _⟩ := exists_ringHom_zmod_of_padic ι
  ⟨RingHom.ker f, isMaximal_ker_and_card Fact.out f⟩

/-! ## Square roots in `ℤ_p`, and the embedding -/

/-- **Hensel**: a natural number that is a nonzero square modulo an odd prime `p` is a square in `ℤ_p`. -/
theorem exists_padicInt_sq_eq {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {d : ℕ} (hd0 : (d : ZMod p) ≠ 0)
    (hd : IsSquare (d : ZMod p)) : ∃ r : ℤ_[p], r ^ 2 = (d : ℤ_[p]) := by
  sorry

/-- **`ℚ(√D)` embeds in `ℚ_p`** when every radicand is a nonzero square modulo the odd prime `p`: each generator's minimal
polynomial divides `X² − d`, which splits in `ℚ_p` (`IntermediateField.nonempty_algHom_adjoin_of_splits`). -/
theorem nonempty_ringHom_padic (D : Set ℕ) {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    (hD : ∀ d ∈ D, (d : ZMod p) ≠ 0 ∧ IsSquare (d : ZMod p)) : Nonempty (fieldOfRadicands D →+* ℚ_[p]) := by
  sorry

/-! ## NF1-S2 -/

/-- **NF1-S2, widened**: for an odd prime `p` and any set `D` of naturals each a nonzero square modulo `p`, the ring of
integers of `ℚ(√D)` has a maximal ideal with exactly `p` elements in its quotient. -/
theorem exists_maximal_card_eq (D : Set ℕ) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hD : ∀ d ∈ D, (d : ZMod p) ≠ 0 ∧ IsSquare (d : ZMod p)) :
    ∃ 𝔭 : Ideal (𝓞 (fieldOfRadicands D)), 𝔭.IsMaximal ∧ Nat.card (𝓞 (fieldOfRadicands D) ⧸ 𝔭) = p := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨ι⟩ := nonempty_ringHom_padic D hp2 hD
  exact exists_maximal_card_of_padic ι

/-- **NF1-S2, first sentence, as claimed**: squarefree `d > 1`, an odd prime `p`, `d ≡ s² ≢ 0 (mod p)`. The hypotheses
`Squarefree d` and `1 < d` are the claim's and are not used. -/
theorem exists_maximal_card_eq_sqrt {d : ℕ} (_hd : Squarefree d) (_hd1 : 1 < d) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {s : ℕ} (hs : (d : ZMod p) = (s : ZMod p) ^ 2) (hs0 : (s : ZMod p) ≠ 0) :
    ∃ 𝔭 : Ideal (𝓞 (fieldOfRadicands {d})), 𝔭.IsMaximal ∧ Nat.card (𝓞 (fieldOfRadicands {d}) ⧸ 𝔭) = p := by
  haveI : Fact p.Prime := ⟨hp⟩
  refine exists_maximal_card_eq {d} hp hp2 ?_
  rintro e rfl
  exact ⟨by rw [hs]; exact pow_ne_zero 2 hs0, ⟨(s : ZMod p), by rw [hs, sq]⟩⟩

/-! ## The ramified radicand -/

/-- **The ramified quadratic step.** Let `K₀ ⊆ K` be fields, `K₀` embedded in `ℚ_p` with `p` odd, and `K = K₀(π)` with
`π² = q`, a natural number divisible by `p` exactly once. Then the integers of `K` map to `ℤ/p`. (`π ∉ K₀`: a square root of
`q` in `ℚ_p` would have valuation `1/2`. Every `x ∈ K` is `a + bπ` with `a, b ∈ K₀` uniquely; `a + bπ ↦ a − bπ` is a ring
automorphism, so an integral `x` has `2a` and `a² − b²q` integral, hence in `ℤ_p`, hence `a, b ∈ ℤ_p` — the second by parity
of the valuation — and `x ↦ a mod p` is the homomorphism, multiplicative because `q ≡ 0`.) -/
theorem nonempty_ringHom_zmod_of_ramified_sqrt {K : Type*} [Field K] {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    (K₀ : Subfield K) (ι₀ : K₀ →+* ℚ_[p]) {q : ℕ} (hq : p ∣ q) (hq2 : ¬ p ^ 2 ∣ q) {π : K} (hπ : π ^ 2 = (q : K))
    (hgen : Subfield.closure ((K₀ : Set K) ∪ {π}) = ⊤) : Nonempty (𝓞 K →+* ZMod p) := by
  sorry

/-- **NF1-S2, the ramified clause, corrected**: every radicand in `D` a nonzero square modulo the odd prime `p`, and one
more radicand `q` with `p ∣ q`, `p² ∤ q` (`11` in `ℚ(√3, √11)` at `p = 11`): the ring of integers of `ℚ(√D, √q)` has a
maximal ideal with exactly `p` elements in its quotient. With two radicands divisible by `p` the statement is false
(module docstring). -/
theorem exists_maximal_card_eq_of_ramified (D : Set ℕ) (q : ℕ) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hD : ∀ d ∈ D, (d : ZMod p) ≠ 0 ∧ IsSquare (d : ZMod p)) (hq : p ∣ q) (hq2 : ¬ p ^ 2 ∣ q) :
    ∃ 𝔭 : Ideal (𝓞 (fieldOfRadicands (insert q D))),
      𝔭.IsMaximal ∧ Nat.card (𝓞 (fieldOfRadicands (insert q D)) ⧸ 𝔭) = p := by
  sorry

/-! ## Spec -/

-- A model of `exists_maximal_card_of_padic`'s hypothesis: `ℚ` embeds in `ℚ_5`.
example : ∃ 𝔭 : Ideal (𝓞 ℚ), 𝔭.IsMaximal ∧ Nat.card (𝓞 ℚ ⧸ 𝔭) = 5 :=
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  exists_maximal_card_of_padic (algebraMap ℚ ℚ_[5])

-- The headline at `(11, 7)`: `11 ≡ 2² (mod 7)`.
example : ∃ 𝔭 : Ideal (𝓞 (fieldOfRadicands {11})), 𝔭.IsMaximal ∧ Nat.card (𝓞 (fieldOfRadicands {11}) ⧸ 𝔭) = 7 :=
  exists_maximal_card_eq {11} (by norm_num) (by norm_num) (by rintro d rfl; exact ⟨by decide, ⟨2, by decide⟩⟩)

-- The claim's own form at `(47, 11)`: `47 ≡ 5² (mod 11)`.
example : ∃ 𝔭 : Ideal (𝓞 (fieldOfRadicands {47})), 𝔭.IsMaximal ∧ Nat.card (𝓞 (fieldOfRadicands {47}) ⧸ 𝔭) = 11 :=
  exists_maximal_card_eq_sqrt (Nat.Prime.prime (by norm_num : Nat.Prime 47)).squarefree (by norm_num) (by norm_num)
    (by norm_num) (s := 5) (by decide) (by decide)

-- The ramified clause at `K = ℚ(√3, √11)`, `p = 11`: `3 ≡ 5² (mod 11)`, and `11 ∣ 11`, `121 ∤ 11`.
example : ∃ 𝔭 : Ideal (𝓞 (fieldOfRadicands {11, 3})), 𝔭.IsMaximal ∧ Nat.card (𝓞 (fieldOfRadicands {11, 3}) ⧸ 𝔭) = 11 :=
  exists_maximal_card_eq_of_ramified {3} 11 (by norm_num) (by norm_num)
    (by rintro d rfl; exact ⟨by decide, ⟨5, by decide⟩⟩) (dvd_refl 11) (by norm_num)

-- The hypotheses refuse the false reading: `2` is not a square modulo `11`, so `{2}` is no model at `11`.
example : ¬ IsSquare ((2 : ℕ) : ZMod 11) := by decide

-- The instance resolves at an explicit finite set.
example : NumberField (fieldOfRadicands {3, 11, 5}) := inferInstance

end HadwigerNelson.QuadraticPrime
