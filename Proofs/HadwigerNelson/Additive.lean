import Mathlib.GroupTheory.Exponent
import Proofs.HadwigerNelson.Fan
import Proofs.HadwigerNelson.Palette

/-!
# Additive colourings (M56)

Fischer's *additive k-colouring* (Discrete Math. 82, 1990) of a plane over a field colours a point by
the image of its position under a group homomorphism from the subgroup generated by the unit vectors
into a group of order `k`, nonzero on every unit vector. Restricted to a finite chunk the object is
simpler still, and this file holds the three facts the milestone's instrument (`tools/additive.py`)
rests on, in the least form that carries them:

* a graph `Γ` on an additive group `V` (the chunk's difference lattice, translated so a base point
  is `0`) and a homomorphism `φ : V →+ G` nonzero on every edge difference give a proper
  `G`-colouring, `additiveColoring` — so an additive colouring is a colouring (Fischer, Thm 1(i));
* hence a homomorphism SEPARATING two vertices refutes `Forces`, and one IDENTIFYING them refutes
  `Separated` — the theory bounds where a compulsion can live, one direction each, and says nothing
  in the other direction (additive colourings are a proper subset of all colourings:
  `plans/M56-arithmetic-of-tightness.md` §S6 holds the standing counterexample, the fabric's
  valuation-4 pairs);
* and the divisibility lemma: if `p − q = e • w` with `e` killing `G`, every homomorphism identifies
  `p` and `q` — every difference in `e·Λ` is forced in every additive colouring into a group of
  exponent `e` (L1 of the plan).

The unit-distance instance is the comap of `unitDistance ℂ` along `w ↦ p₀ + w` on the chunk's
lattice; no consumer needed it here, so it is not stated. Nothing in this file is search.
-/

namespace HadwigerNelson

open SimpleGraph

variable {V G : Type*} [AddCommGroup V] [AddCommGroup G]

/-- **An additive colouring is a colouring.** A homomorphism `φ` that is nonzero on the difference of
every adjacent pair colours the graph by itself: `φ a = φ b` would force `φ (a - b) = 0`.

The lattice is the vertex type: the chunk's points sit at lattice offsets from a base point, and the
graph is the induced unit graph on those offsets. Consumers reason through `additiveColoring_apply`;
the definition is sealed. -/
def additiveColoring (Γ : SimpleGraph V) (φ : V →+ G)
    (h : ∀ a b, Γ.Adj a b → φ (a - b) ≠ 0) : Γ.Coloring G :=
  Coloring.mk φ fun {a b} hab heq => h a b hab (by rw [map_sub, heq, sub_self])

@[simp] theorem additiveColoring_apply (Γ : SimpleGraph V) (φ : V →+ G)
    (h : ∀ a b, Γ.Adj a b → φ (a - b) ≠ 0) (a : V) : additiveColoring Γ φ h a = φ a := rfl

/-- **A separating homomorphism refutes `Forces`.** If some additive colouring gives `p` and `q`
different colours then not every proper `k`-colouring identifies them — the instrument's
`separated-additively` verdict, with the colouring itself as the certificate. The converse is FALSE:
a homomorphism identifying `p` and `q` says nothing about `Forces` (see the module docstring). -/
theorem not_forces_of_addMonoidHom [Fintype G] {k : ℕ} (hk : Fintype.card G = k)
    (Γ : SimpleGraph V) (φ : V →+ G) (h : ∀ a b, Γ.Adj a b → φ (a - b) ≠ 0)
    {p q : V} (hpq : φ (p - q) ≠ 0) : ¬ Forces Γ k p q :=
  not_forces_of_coloring_ne hk (additiveColoring Γ φ h) fun h1 =>
    hpq (by rw [map_sub, sub_eq_zero]; exact h1)

/-- **An identifying homomorphism refutes `Separated`.** If some additive colouring gives `p` and `q`
one colour then they are not forced apart at `k` colours. -/
theorem not_separated_of_addMonoidHom [Fintype G] {k : ℕ} (hk : Fintype.card G = k)
    (Γ : SimpleGraph V) (φ : V →+ G) (h : ∀ a b, Γ.Adj a b → φ (a - b) ≠ 0)
    {p q : V} (hpq : φ (p - q) = 0) : ¬ Separated Γ k p q :=
  not_separated_of_coloring_eq hk (additiveColoring Γ φ h)
    (sub_eq_zero.mp (by rwa [map_sub] at hpq))

/-- **The divisibility lemma (L1).** If `e` kills `G` and `p − q = e • w`, every homomorphism into `G`
identifies `p` and `q`: a difference in `e·Λ` is forced in every additive colouring into a group of
exponent dividing `e`. The instrument's `forced-additively` verdict at 2-adic depth `≥ 2` is this
lemma with `e = 4`. -/
theorem addMonoidHom_apply_eq_of_sub_eq_nsmul (φ : V →+ G) {e : ℕ} (he : ∀ g : G, e • g = 0)
    {p q w : V} (h : p - q = e • w) : φ p = φ q := by
  rw [← sub_eq_zero, ← map_sub, h, map_nsmul, he]

/-- L1 at the exponent of `G` itself (`AddMonoid.exponent_nsmul_eq_zero`). -/
theorem addMonoidHom_apply_eq_of_sub_eq_exponent_nsmul (φ : V →+ G) {p q w : V}
    (h : p - q = AddMonoid.exponent G • w) : φ p = φ q :=
  addMonoidHom_apply_eq_of_sub_eq_nsmul φ (fun g => AddMonoid.exponent_nsmul_eq_zero g) h

/-! ## Spec: the integer grid and its parity colouring

The unit-distance graph of `ℤ × ℤ` is the grid; the parity functional `x + y mod 2` is Woodall's
2-colouring of `ℚ²` restricted to it. The three examples exercise the three theorems, and the fourth
is the planted red: the zero homomorphism fails the hypothesis, which is therefore load-bearing. -/

/-- The integer grid: neighbours differ by a unit coordinate vector. -/
def grid : SimpleGraph (ℤ × ℤ) :=
  SimpleGraph.fromRel fun a b => a - b = (1, 0) ∨ a - b = (0, 1)

/-- The parity functional `(x, y) ↦ x + y mod 2`. -/
def parity : ℤ × ℤ →+ ZMod 2 :=
  (Int.castAddHom (ZMod 2)).comp (AddMonoidHom.fst ℤ ℤ + AddMonoidHom.snd ℤ ℤ)

theorem parity_apply (a : ℤ × ℤ) : parity a = ((a.1 + a.2 : ℤ) : ZMod 2) := by
  simp [parity]

/-- Parity is nonzero on every grid edge: the hypothesis of `additiveColoring`, discharged. -/
theorem parity_grid : ∀ a b, grid.Adj a b → parity (a - b) ≠ 0 := by
  intro a b hab
  rw [grid, SimpleGraph.fromRel_adj] at hab
  obtain ⟨-, h | h⟩ := hab
  · rcases h with h | h <;> rw [h] <;> decide
  · rw [show a - b = -(b - a) by abel, map_neg]
    rcases h with h | h <;> rw [h] <;> decide

example : ¬ Forces grid 2 (0, 0) (1, 0) :=
  not_forces_of_addMonoidHom (ZMod.card 2) grid parity parity_grid (by decide)

/-- L1 on the grid: `(0, 0)` and `(2, 0)` differ by `2 • (−1, 0)`, so every homomorphism into a group of
exponent 2 identifies them — and indeed the grid's unique 2-colouring does. -/
example : parity (0, 0) = parity (2, 0) :=
  addMonoidHom_apply_eq_of_sub_eq_nsmul parity (e := 2) (by decide) (w := (-1, 0)) (by decide)

example : ¬ Separated grid 2 (0, 0) (2, 0) :=
  not_separated_of_addMonoidHom (ZMod.card 2) grid parity parity_grid (by decide)

/-- The planted red: the zero homomorphism vanishes on an edge, so `additiveColoring`'s hypothesis
refuses it — the hypothesis is load-bearing, not decoration. -/
example : ¬ ∀ a b, grid.Adj a b → (0 : ℤ × ℤ →+ ZMod 2) (a - b) ≠ 0 :=
  fun h => h (1, 0) (0, 0) ((SimpleGraph.fromRel_adj ..).mpr ⟨by decide, Or.inl (Or.inl rfl)⟩) rfl

end HadwigerNelson
