lemma sampling_weak_compact (hc : Measurable c) (y : ℕ → ℂ) (r : ℕ → ℝ) :
    ∃ b : Fin k → RealL2 angularMeasure, ∃ φ : ℕ → ℕ, StrictMono φ ∧
