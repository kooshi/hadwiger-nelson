import Mathlib.NumberTheory.SumFourSquares
import Proofs.HadwigerNelson.RationalFour.Basic

/-!
# The component of the origin and its residue classes (FS-131, FS131-KFS1, FS131-IRF1)

The component of the origin in the unit-distance graph on `ℚ⁴` is the additive group the rational unit vectors generate,
`comp = ⟨S⟩`. It is described by one valuation: `z ∈ comp ↔ 0 ≤ v₂(|z|²)` (`mem_comp_iff`) — `[BendaPerles2000]`
pp. 123–125's `H⁴` (their types (a) and (b), p. 124), proved here as in the consolidation run's job LX (L1, L3): a normal
form `z = (a, b, c, d)/(2m)`, `m` odd, `a ≡ b ≡ c ≡ d (mod 2)` (`zero_le_val_iff`), and the ring route to `1/m ∈ ⟨S⟩`
(`inv_odd_mem_comp`: `1/p` from the trace of the unit `q²/p`, `|q|² = p`).

Inside it, `pr = (1 + i)·comp` is the set `z = 0 ∨ 1 ≤ v₂(|z|²)` (`mem_pr_iff`), of index 4: the **unit tetrahedron**
`tetra = (0, 1, h, h′)` (`h = ½(1+i+j+k)`, `h′ = ½(1+i+j−k)`), whose six differences are unit vectors, meets each class of
`comp/pr` exactly once (`existsUnique_tetra_sub_mem_pr`). That is the whole residue structure `comp/pr ≅ 𝔽₄` the colouring
argument needs; no map to `𝔽₄` is built.

**Not claimed:** that `comp` is a maximal order (true; not used). It is a ring (`mul_mem_comp`, and `1` is a unit
vector), the `ℚ⁴` form of the plane's unit ring.
-/

namespace HadwigerNelson.RationalFour

open Quaternion

/-! ## The component of the origin -/

/-- **The component of the origin**: the additive group generated by the rational unit vectors. Two points of `ℚ⁴` are joined
by a path of unit steps iff their difference lies in it. -/
def comp : AddSubgroup ℍ[ℚ] := AddSubgroup.closure unitSphere

theorem unitSphere_subset_comp : unitSphere ⊆ comp := AddSubgroup.subset_closure

/-! ## The normal form -/

private theorem padicValRat_int_div_odd (k : ℤ) {m : ℕ} (hm : Odd m) :
    padicValRat 2 ((k : ℚ) / m) = padicValRat 2 (k : ℚ) := by
  rcases eq_or_ne k 0 with rfl | hk
  · simp
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
  have h2 : ¬ 2 ∣ m := fun h => by have := Nat.odd_iff.mp hm; omega
  rw [padicValRat.div (by exact_mod_cast hk) hm0, padicValRat.of_nat, padicValNat.eq_zero_of_not_dvd h2]
  simp

private theorem zero_le_padicValRat_int (k : ℤ) : 0 ≤ padicValRat 2 (k : ℚ) := by
  rw [padicValRat.of_int]
  exact Int.natCast_nonneg _

private theorem two_pow_dvd_iff {k : ℤ} (hk : k ≠ 0) (n : ℕ) :
    (2 : ℤ) ^ n ∣ k ↔ (n : ℤ) ≤ padicValRat 2 (k : ℚ) := by
  rw [padicValRat.of_int, Nat.cast_le]
  have := padicValInt_dvd_iff (p := 2) n k
  simp only [Nat.cast_ofNat] at this
  rw [this]
  simp [hk]

private theorem sq_emod_four (a : ℤ) : a ^ 2 % 4 = a % 2 := by
  obtain ⟨k, rfl | rfl⟩ := Int.even_or_odd' a
  · have : (2 * k) ^ 2 = 4 * k ^ 2 := by ring
    omega
  · have : (2 * k + 1) ^ 2 = 4 * (k ^ 2 + k) + 1 := by ring
    omega

private theorem sq_emod_eight_of_odd {a : ℤ} (h : a % 2 = 1) : a ^ 2 % 8 = 1 := by
  obtain ⟨k, rfl | rfl⟩ := Int.even_or_odd' a
  · omega
  · obtain ⟨j, rfl | rfl⟩ := Int.even_or_odd' k
    · have : (2 * (2 * j) + 1) ^ 2 = 8 * (2 * j ^ 2 + j) + 1 := by ring
      omega
    · have : (2 * (2 * j + 1) + 1) ^ 2 = 8 * (2 * j ^ 2 + 3 * j + 1) + 1 := by ring
      omega

private theorem parity_of_four_dvd {a b c d : ℤ} (h : 4 ∣ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2) :
    a % 2 = b % 2 ∧ a % 2 = c % 2 ∧ a % 2 = d % 2 := by
  have := sq_emod_four a; have := sq_emod_four b; have := sq_emod_four c; have := sq_emod_four d
  omega

private theorem four_dvd_of_parity {a b c d : ℤ} (hb : a % 2 = b % 2) (hc : a % 2 = c % 2) (hd : a % 2 = d % 2) :
    4 ∣ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 := by
  have := sq_emod_four a; have := sq_emod_four b; have := sq_emod_four c; have := sq_emod_four d
  omega

private theorem normal_form_aux {m : ℕ} (hm : Odd m) : ∀ (e : ℕ) (a b c d : ℤ),
    4 ^ e ∣ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 →
    ∃ a' b' c' d' : ℤ, a' ≡ b' [ZMOD 2] ∧ a' ≡ c' [ZMOD 2] ∧ a' ≡ d' [ZMOD 2] ∧
      (a : ℚ) / (2 ^ e * m) = a' / (2 * m) ∧ (b : ℚ) / (2 ^ e * m) = b' / (2 * m) ∧
      (c : ℚ) / (2 ^ e * m) = c' / (2 * m) ∧ (d : ℚ) / (2 ^ e * m) = d' / (2 * m) := by
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
  intro e
  induction e with
  | zero =>
    intro a b c d _
    refine ⟨2 * a, 2 * b, 2 * c, 2 * d, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · show _ % _ = _ % _; omega
    · show _ % _ = _ % _; omega
    · show _ % _ = _ % _; omega
    all_goals push_cast; field_simp
  | succ e ih =>
    intro a b c d h
    have h4 : (4 : ℤ) ∣ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 := (dvd_pow_self 4 (Nat.succ_ne_zero e)).trans h
    obtain ⟨hb, hc, hd⟩ := parity_of_four_dvd h4
    rcases Int.emod_two_eq_zero_or_one a with ha | ha
    · obtain ⟨A, rfl⟩ : (2 : ℤ) ∣ a := Int.dvd_of_emod_eq_zero ha
      obtain ⟨B, rfl⟩ : (2 : ℤ) ∣ b := Int.dvd_of_emod_eq_zero (by omega)
      obtain ⟨C, rfl⟩ : (2 : ℤ) ∣ c := Int.dvd_of_emod_eq_zero (by omega)
      obtain ⟨D, rfl⟩ : (2 : ℤ) ∣ d := Int.dvd_of_emod_eq_zero (by omega)
      have h' : 4 ^ e ∣ A ^ 2 + B ^ 2 + C ^ 2 + D ^ 2 := by
        have e1 : (2 * A) ^ 2 + (2 * B) ^ 2 + (2 * C) ^ 2 + (2 * D) ^ 2 = 4 * (A ^ 2 + B ^ 2 + C ^ 2 + D ^ 2) := by
          ring
        rw [e1, pow_succ, mul_comm] at h
        exact (mul_dvd_mul_iff_left (by norm_num)).1 h
      obtain ⟨a', b', c', d', h1, h2, h3, ea, eb, ec, ed⟩ := ih A B C D h'
      refine ⟨a', b', c', d', h1, h2, h3, ?_, ?_, ?_, ?_⟩
      · rw [← ea]; push_cast; rw [pow_succ]; field_simp
      · rw [← eb]; push_cast; rw [pow_succ]; field_simp
      · rw [← ec]; push_cast; rw [pow_succ]; field_simp
      · rw [← ed]; push_cast; rw [pow_succ]; field_simp
    · cases e with
      | zero =>
        exact ⟨a, b, c, d, hb, hc, hd, by norm_num, by norm_num, by norm_num, by norm_num⟩
      | succ e =>
        exfalso
        have h8 : (8 : ℤ) ∣ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 :=
          (by norm_num : (8 : ℤ) ∣ 4 ^ 2).trans ((pow_dvd_pow 4 (by omega : 2 ≤ e + 1 + 1)).trans h)
        have := sq_emod_eight_of_odd ha
        have := sq_emod_eight_of_odd (a := b) (by omega)
        have := sq_emod_eight_of_odd (a := c) (by omega)
        have := sq_emod_eight_of_odd (a := d) (by omega)
        omega


private theorem exists_int_mul_of_den_dvd (q : ℚ) {D : ℕ} (h : q.den ∣ D) : ∃ n : ℤ, q * D = n := by
  obtain ⟨k, rfl⟩ := h
  refine ⟨q.num * k, ?_⟩
  push_cast
  rw [← mul_assoc, Rat.mul_den_eq_num]

/-- **The normal form of a quaternion of 2-integral squared length** (LX L1): `v₂(|z|²) ≥ 0` iff `2m·z` has integer
coordinates of one parity for some odd `m`. -/
theorem zero_le_val_iff (z : ℍ[ℚ]) :
    0 ≤ val z ↔ ∃ (m : ℕ) (a b c d : ℤ), Odd m ∧ a ≡ b [ZMOD 2] ∧ a ≡ c [ZMOD 2] ∧ a ≡ d [ZMOD 2] ∧
      z = ⟨a / (2 * m), b / (2 * m), c / (2 * m), d / (2 * m)⟩ := by
  constructor
  · intro hz
    rcases eq_or_ne z 0 with rfl | hz0
    · exact ⟨1, 0, 0, 0, 0, odd_one, rfl, rfl, rfl, by ext <;> simp⟩
    set D : ℕ := z.re.den * z.imI.den * z.imJ.den * z.imK.den with hD
    have hD0 : D ≠ 0 := by positivity
    have hDq : (D : ℚ) ≠ 0 := by exact_mod_cast hD0
    obtain ⟨A0, hA0⟩ := exists_int_mul_of_den_dvd z.re (D := D) ⟨z.imI.den * z.imJ.den * z.imK.den, by ring⟩
    obtain ⟨A1, hA1⟩ := exists_int_mul_of_den_dvd z.imI (D := D) ⟨z.re.den * z.imJ.den * z.imK.den, by ring⟩
    obtain ⟨A2, hA2⟩ := exists_int_mul_of_den_dvd z.imJ (D := D) ⟨z.re.den * z.imI.den * z.imK.den, by ring⟩
    obtain ⟨A3, hA3⟩ := exists_int_mul_of_den_dvd z.imK (D := D) ⟨z.re.den * z.imI.den * z.imJ.den, by ring⟩
    obtain ⟨e, m, hm, hDm⟩ := Nat.exists_eq_two_pow_mul_odd hD0
    have hDc : (D : ℚ) = 2 ^ e * m := by rw [hDm]; push_cast; ring
    have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
    set S : ℤ := A0 ^ 2 + A1 ^ 2 + A2 ^ 2 + A3 ^ 2 with hS
    have hN : normSq z = ((S : ℚ) / ((m ^ 2 : ℕ) : ℚ)) / (2 : ℚ) ^ (2 * e) := by
      rw [normSq_def', eq_div_of_mul_eq hDq hA0, eq_div_of_mul_eq hDq hA1, eq_div_of_mul_eq hDq hA2,
        eq_div_of_mul_eq hDq hA3, hDc, hS]
      push_cast
      field_simp
      ring
    have hS0 : S ≠ 0 := by
      rintro h0
      rw [h0] at hN
      simp only [Int.cast_zero, zero_div] at hN
      exact hz0 (normSq_eq_zero.1 hN)
    have hv : val z = padicValRat 2 (S : ℚ) - 2 * e := by
      have hm2 : ((m ^ 2 : ℕ) : ℚ) ≠ 0 := by exact_mod_cast (pow_pos hm.pos 2).ne'
      rw [val, hN, padicValRat.div (div_ne_zero (by exact_mod_cast hS0) hm2) (by positivity),
        padicValRat_int_div_odd S (hm.pow), padicValRat.pow (2 : ℚ)]
      have : padicValRat 2 (2 : ℚ) = 1 := padicValRat.self (p := 2) (by norm_num)
      rw [this]
      push_cast
      ring
    have hdvd : (4 : ℤ) ^ e ∣ S := by
      rw [show (4 : ℤ) ^ e = 2 ^ (2 * e) by rw [pow_mul]; norm_num, two_pow_dvd_iff hS0]
      push_cast
      omega
    obtain ⟨a, b, c, d, h1, h2, h3, ea, eb, ec, ed⟩ := normal_form_aux hm e A0 A1 A2 A3 hdvd
    refine ⟨m, a, b, c, d, hm, h1, h2, h3, ?_⟩
    ext
    · rw [eq_div_of_mul_eq hDq hA0, hDc, ea]
    · rw [eq_div_of_mul_eq hDq hA1, hDc, eb]
    · rw [eq_div_of_mul_eq hDq hA2, hDc, ec]
    · rw [eq_div_of_mul_eq hDq hA3, hDc, ed]
  · rintro ⟨m, a, b, c, d, hm, hb, hc, hd, rfl⟩
    have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
    obtain ⟨k, hk⟩ := four_dvd_of_parity hb hc hd
    have hN : normSq (⟨a / (2 * m), b / (2 * m), c / (2 * m), d / (2 * m)⟩ : ℍ[ℚ]) =
        (k : ℚ) / ((m ^ 2 : ℕ) : ℚ) := by
      have hk' : ((a : ℚ) ^ 2 + b ^ 2 + c ^ 2 + d ^ 2) = 4 * k := by exact_mod_cast hk
      rw [normSq_def']
      push_cast
      field_simp
      linear_combination hk'
    rw [val, hN, padicValRat_int_div_odd k hm.pow]
    exact zero_le_padicValRat_int k

/-- **The ultrametric step** (LX L1): two quaternions of 2-integral squared length sum to one (the normal form: odd denominators
multiply, parities add). -/
theorem zero_le_val_add {x y : ℍ[ℚ]} (hx : 0 ≤ val x) (hy : 0 ≤ val y) : 0 ≤ val (x + y) := by
  obtain ⟨m, a, b, c, d, hm, hb, hc, hd, rfl⟩ := (zero_le_val_iff x).1 hx
  obtain ⟨m', a', b', c', d', hm', hb', hc', hd', rfl⟩ := (zero_le_val_iff y).1 hy
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
  have hm0' : (m' : ℚ) ≠ 0 := by exact_mod_cast hm'.pos.ne'
  refine (zero_le_val_iff _).2 ⟨m * m', a * m' + a' * m, b * m' + b' * m, c * m' + c' * m, d * m' + d' * m,
    hm.mul hm', (hb.mul_right _).add (hb'.mul_right _), (hc.mul_right _).add (hc'.mul_right _),
    (hd.mul_right _).add (hd'.mul_right _), ?_⟩
  ext <;> simp only [re_add, imI_add, imJ_add, imK_add, Int.cast_add, Int.cast_mul, Int.cast_natCast, Nat.cast_mul] <;>
    field_simp

theorem zero_le_val_neg {x : ℍ[ℚ]} (hx : 0 ≤ val x) : 0 ≤ val (-x) := by
  rwa [val, normSq_neg]

/-- **The quaternions of 2-integral squared length**, `{z | v₂(|z|²) ≥ 0}`, as an additive group (`H ⊗ ℤ₍₂₎`). Auxiliary:
`mem_comp_iff` shows it is `comp`. -/
def ord : AddSubgroup ℍ[ℚ] where
  carrier := {z | 0 ≤ val z}
  add_mem' := zero_le_val_add
  zero_mem' := by simp [val]
  neg_mem' := zero_le_val_neg

/-- **The parity reading of `P`** (the statement every residue case reads): for an integer quadruple `B ≠ 0` over an odd
`m`, `v₂(|B/m|²) ≥ 1` iff `Σ Bᵢ` is even (`B² ≡ B (mod 2)`). -/
theorem one_le_val_div_odd {m : ℕ} (hm : Odd m) {a b c d : ℤ} (h0 : (a, b, c, d) ≠ (0, 0, 0, 0)) :
    1 ≤ val ⟨a / m, b / m, c / m, d / m⟩ ↔ 2 ∣ a + b + c + d := by
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
  set S : ℤ := a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 with hS
  have hS0 : S ≠ 0 := by
    intro h
    apply h0
    have ha : a = 0 := by nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c, sq_nonneg d]
    have hb : b = 0 := by nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c, sq_nonneg d]
    have hc : c = 0 := by nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c, sq_nonneg d]
    have hd : d = 0 := by nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c, sq_nonneg d]
    rw [ha, hb, hc, hd]
  have hN : normSq (⟨a / m, b / m, c / m, d / m⟩ : ℍ[ℚ]) = (S : ℚ) / ((m ^ 2 : ℕ) : ℚ) := by
    rw [normSq_def', hS]
    push_cast
    field_simp
  rw [val, hN, padicValRat_int_div_odd S hm.pow]
  have := two_pow_dvd_iff hS0 1
  simp only [pow_one, Nat.cast_one] at this
  rw [← this]
  have := sq_emod_four a; have := sq_emod_four b; have := sq_emod_four c; have := sq_emod_four d
  omega

/-- The rational scalars of `ℍ[ℚ]` (`Rat.cast`, the instance a coercion `ℚ → ℍ[ℚ]` elaborates to) invert as rationals. -/
private theorem ratCast_inv (r : ℚ) : (r : ℍ[ℚ])⁻¹ = ((r⁻¹ : ℚ) : ℍ[ℚ]) := by
  rcases eq_or_ne r 0 with rfl | hr
  · simp
  · exact inv_eq_of_mul_eq_one_right (by ext <;> simp [hr])

/-- … and multiply as rationals. -/
private theorem ratCast_mul (r s : ℚ) : ((r * s : ℚ) : ℍ[ℚ]) = (r : ℍ[ℚ]) * (s : ℍ[ℚ]) := by
  ext <;> simp

/-- The component is closed under multiplication (`S · S ⊆ S`). -/
theorem mul_mem_comp {x y : ℍ[ℚ]} (hx : x ∈ comp) (hy : y ∈ comp) : x * y ∈ comp := by
  have hu : ∀ u ∈ unitSphere, ∀ y ∈ comp, u * y ∈ comp := by
    intro u hu y hy
    have hy' : y ∈ AddSubgroup.closure unitSphere := hy
    clear hy
    induction hy' using AddSubgroup.closure_induction with
    | mem v hv =>
      apply unitSphere_subset_comp
      show normSq (u * v) = 1
      rw [map_mul, show normSq u = 1 from hu, show normSq v = 1 from hv, one_mul]
    | zero => rw [mul_zero]; exact zero_mem _
    | add a b _ _ ha hb => rw [mul_add]; exact add_mem ha hb
    | neg a _ ha => rw [mul_neg]; exact neg_mem ha
  have hx' : x ∈ AddSubgroup.closure unitSphere := hx
  clear hx
  induction hx' using AddSubgroup.closure_induction with
  | mem u hu' => exact hu u hu' y hy
  | zero => rw [zero_mul]; exact zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact add_mem ha hb
  | neg a _ ha => rw [neg_mul]; exact neg_mem ha

/-- **`1/p` for an odd prime** (LX L3): with `|q|² = p` (Lagrange) and `q`'s real part `a ≠ 0`, `u = q²/p` is a unit vector
and `u + ū = 4a²/p − 2`; `gcd(4a², p) = 1` finishes. -/
theorem inv_prime_mem_comp {p : ℕ} (hp : p.Prime) (h2 : p ≠ 2) : ((p : ℚ)⁻¹ : ℍ[ℚ]) ∈ comp := by
  -- `p` as a sum of four squares, the first one nonzero
  obtain ⟨a, b, c, d, ha, habcd⟩ : ∃ a b c d : ℕ, a ≠ 0 ∧ a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 = p := by
    obtain ⟨a, b, c, d, h⟩ := Nat.sum_four_squares p
    by_cases ha : a = 0
    · by_cases hb : b = 0
      · by_cases hc : c = 0
        · refine ⟨d, a, b, c, ?_, by rw [← h]; ring⟩
          rintro rfl
          subst ha hb hc
          exact hp.ne_zero (by simpa using h.symm)
        · exact ⟨c, a, b, d, hc, by rw [← h]; ring⟩
      · exact ⟨b, a, c, d, hb, by rw [← h]; ring⟩
    · exact ⟨a, b, c, d, ha, h⟩
  rw [ratCast_inv]
  -- `p` does not divide `4a²`
  have hcop : Nat.Coprime (4 * a ^ 2) p := by
    rw [Nat.coprime_comm, hp.coprime_iff_not_dvd]
    intro hdvd
    rcases (Nat.Prime.dvd_mul hp).1 hdvd with h4 | ha2
    · have : p ∣ 2 := hp.dvd_of_dvd_pow (show p ∣ 2 ^ 2 by simpa using h4)
      exact h2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 this)
    · have hle : p ≤ a := Nat.le_of_dvd (Nat.pos_of_ne_zero ha) (hp.dvd_of_dvd_pow ha2)
      have : a ^ 2 ≤ p := by rw [← habcd]; omega
      nlinarith [hp.two_le]
  obtain ⟨s, t, hst⟩ := Nat.Coprime.isCoprime hcop
  have hst' : (s : ℚ) * (4 * a ^ 2) + t * p = 1 := by exact_mod_cast hst
  have habcd' : (a : ℚ) ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 = p := by exact_mod_cast habcd
  -- `r = 1/p`, kept opaque to `simp`
  obtain ⟨r, hrdef, hr⟩ : ∃ r : ℚ, (p : ℚ)⁻¹ = r ∧ r * p = 1 :=
    ⟨_, rfl, inv_mul_cancel₀ (by exact_mod_cast hp.ne_zero)⟩
  rw [hrdef]
  -- the unit vector `u = q²/p`, `|q|² = p`
  set q : ℍ[ℚ] := ⟨a, b, c, d⟩ with hq
  have hqn : normSq q = p := by rw [normSq_def']; exact habcd'
  set u : ℍ[ℚ] := q * q * (r : ℍ[ℚ]) with hu
  have hus : u ∈ unitSphere := by
    show normSq u = 1
    rw [hu, map_mul, map_mul, hqn, normSq_def']
    simp only [re_ratCast, imI_ratCast, imJ_ratCast, imK_ratCast]
    linear_combination (r * p + 1) * hr
  have hus' : star u ∈ unitSphere := by
    show normSq (star u) = 1
    rw [normSq_star]
    exact hus
  have hone : (1 : ℍ[ℚ]) ∈ comp := unitSphere_subset_comp (show normSq (1 : ℍ[ℚ]) = 1 from map_one _)
  -- `u + ū + 2 = 4a²/p`
  have hmem : ((4 * a ^ 2 * r : ℚ) : ℍ[ℚ]) ∈ comp := by
    have key : ((4 * a ^ 2 * r : ℚ) : ℍ[ℚ]) = u + star u + 1 + 1 := by
      ext <;> simp only [hu, hq, re_ratCast, imI_ratCast, imJ_ratCast, imK_ratCast, re_add, imI_add, imJ_add,
        imK_add, re_star, imI_star, imJ_star, imK_star, re_mul, imI_mul, imJ_mul, imK_mul, re_one, imI_one, imJ_one,
        imK_one, Rat.cast_id]
      · linear_combination 2 * r * habcd' + 2 * hr
      all_goals ring
    rw [key]
    exact add_mem (add_mem (add_mem (unitSphere_subset_comp hus) (unitSphere_subset_comp hus')) hone) hone
  -- Bézout: `1/p = s·(4a²/p) + t`
  have hb : (r : ℍ[ℚ]) = s • ((4 * a ^ 2 * r : ℚ) : ℍ[ℚ]) + t • (1 : ℍ[ℚ]) := by
    ext <;> simp only [re_ratCast, imI_ratCast, imJ_ratCast, imK_ratCast, re_add, imI_add, imJ_add, imK_add, re_smul,
      imI_smul, imJ_smul, imK_smul, re_one, imI_one, imJ_one, imK_one, Rat.cast_id] <;>
      simp only [zsmul_eq_mul, mul_zero, add_zero, mul_one]
    linear_combination (-r) * hst' + t * hr
  rw [hb]
  exact add_mem (zsmul_mem hmem s) (zsmul_mem hone t)

/-- `1/m` for every odd `m` (`Nat.recOnMul` over `inv_prime_mem_comp` and `mul_mem_comp`). -/
theorem inv_odd_mem_comp {m : ℕ} (hm : Odd m) : ((m : ℚ)⁻¹ : ℍ[ℚ]) ∈ comp := by
  induction m using Nat.recOnMul with
  | zero => exact absurd hm (by decide)
  | one =>
    rw [ratCast_inv, Nat.cast_one, inv_one, Rat.cast_one]
    exact unitSphere_subset_comp (show normSq (1 : ℍ[ℚ]) = 1 from map_one _)
  | prime p hp => exact inv_prime_mem_comp hp (by rintro rfl; exact absurd hm (by decide))
  | mul a b ha hb =>
    obtain ⟨hao, hbo⟩ := Nat.odd_mul.1 hm
    have := mul_mem_comp (ha hao) (hb hbo)
    rw [ratCast_inv, ratCast_inv, ← ratCast_mul, ← mul_inv, ← Nat.cast_mul] at this
    rwa [ratCast_inv]

/-- **The component of the origin, described** (`[BendaPerles2000]` pp. 123–125; LX L1 and L3). -/
theorem mem_comp_iff (z : ℍ[ℚ]) : z ∈ comp ↔ 0 ≤ val z := by
  constructor
  · intro hz
    have hle : comp ≤ ord := (AddSubgroup.closure_le ord).2 fun u hu => by
      show 0 ≤ val u
      rw [val, show normSq u = 1 from hu, padicValRat.one]
    exact hle hz
  · intro hz
    obtain ⟨m, a, b, c, d, hm, hb, hc, hd, rfl⟩ := (zero_le_val_iff z).1 hz
    have hunit : ∀ w : ℍ[ℚ], normSq w = 1 → w ∈ comp := fun w hw => unitSphere_subset_comp hw
    -- `(a, b, c, d)/2` is an integer combination of `1, i, j, k` and `h = ½(1 + i + j + k)`
    set w : ℍ[ℚ] := ⟨a / 2, b / 2, c / 2, d / 2⟩ with hwdef
    have hw : w ∈ comp := by
      have key : w =
          (a % 2) • (⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ : ℍ[ℚ]) + (a / 2) • (⟨1, 0, 0, 0⟩ : ℍ[ℚ]) +
            (b / 2) • (⟨0, 1, 0, 0⟩ : ℍ[ℚ]) + (c / 2) • (⟨0, 0, 1, 0⟩ : ℍ[ℚ]) + (d / 2) • (⟨0, 0, 0, 1⟩ : ℍ[ℚ]) := by
        unfold Int.ModEq at hb hc hd
        have ea : (a : ℚ) = (a % 2 : ℤ) + 2 * (a / 2 : ℤ) := by
          have : a = a % 2 + 2 * (a / 2) := by omega
          exact_mod_cast this
        have eb : (b : ℚ) = (a % 2 : ℤ) + 2 * (b / 2 : ℤ) := by
          have : b = a % 2 + 2 * (b / 2) := by omega
          exact_mod_cast this
        have ec : (c : ℚ) = (a % 2 : ℤ) + 2 * (c / 2 : ℤ) := by
          have : c = a % 2 + 2 * (c / 2) := by omega
          exact_mod_cast this
        have ed : (d : ℚ) = (a % 2 : ℤ) + 2 * (d / 2 : ℤ) := by
          have : d = a % 2 + 2 * (d / 2) := by omega
          exact_mod_cast this
        ext <;> simp only [hwdef, QuaternionAlgebra.smul_mk, zsmul_eq_mul, QuaternionAlgebra.mk_add_mk]
        · rw [ea]; ring
        · rw [eb]; ring
        · rw [ec]; ring
        · rw [ed]; ring
      rw [key]
      refine add_mem (add_mem (add_mem (add_mem (zsmul_mem (hunit _ ?_) _) (zsmul_mem (hunit _ ?_) _))
        (zsmul_mem (hunit _ ?_) _)) (zsmul_mem (hunit _ ?_) _)) (zsmul_mem (hunit _ ?_) _) <;>
        · rw [normSq_def']; norm_num
    -- `z = (1/m) · (a, b, c, d)/2`
    have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
    have hz' : (⟨a / (2 * m), b / (2 * m), c / (2 * m), d / (2 * m)⟩ : ℍ[ℚ]) =
        (((m : ℚ)⁻¹ : ℚ) : ℍ[ℚ]) * w := by
      ext <;> simp only [hwdef, re_mul, imI_mul, imJ_mul, imK_mul, re_ratCast, imI_ratCast, imJ_ratCast, imK_ratCast,
        Rat.cast_id] <;> field_simp <;> ring
    rw [hz']
    have hinv := inv_odd_mem_comp hm
    rw [ratCast_inv] at hinv
    exact mul_mem_comp hinv hw

/-! ## The ideal `(1 + i)·comp` -/

/-- **`P = (1 + i)·comp`**, the points at even squared distance inside the component. -/
def pr : AddSubgroup ℍ[ℚ] := comp.map (AddMonoidHom.mulLeft onePlusI)

/-- `z ∈ P` iff `z = 0` or `v₂(|z|²) ≥ 1` (`(1 + i)⁻¹ z` has `v₂ = v₂(|z|²) − 1`). -/
theorem mem_pr_iff (z : ℍ[ℚ]) : z ∈ pr ↔ z = 0 ∨ 1 ≤ val z := by
  have hn : normSq onePlusI = 2 := by rw [normSq_def']; norm_num [onePlusI]
  have h0 : onePlusI ≠ 0 := fun h => by rw [h, map_zero] at hn; norm_num at hn
  have hv2 : padicValRat 2 (2 : ℚ) = 1 := padicValRat.self (p := 2) (by norm_num)
  rw [pr, AddSubgroup.mem_map]
  constructor
  · rintro ⟨r, hr, rfl⟩
    rcases eq_or_ne r 0 with rfl | hr0
    · left
      simp
    · right
      have hr' : 0 ≤ padicValRat 2 (normSq r) := (mem_comp_iff r).1 hr
      have hnr : normSq r ≠ 0 := fun h => hr0 (normSq_eq_zero.1 h)
      show 1 ≤ padicValRat 2 (normSq (onePlusI * r))
      rw [map_mul, hn, padicValRat.mul (by norm_num) hnr, hv2]
      omega
  · rintro (rfl | hz)
    · exact ⟨0, zero_mem _, by simp⟩
    · rcases eq_or_ne z 0 with rfl | hz0
      · exact ⟨0, zero_mem _, by simp⟩
      refine ⟨onePlusI⁻¹ * z, (mem_comp_iff _).2 ?_, ?_⟩
      · have hnz : normSq z ≠ 0 := fun h => hz0 (normSq_eq_zero.1 h)
        have hz' : 1 ≤ padicValRat 2 (normSq z) := hz
        show 0 ≤ padicValRat 2 (normSq (onePlusI⁻¹ * z))
        rw [map_mul, map_inv₀, hn, padicValRat.mul (by norm_num) hnz, padicValRat.inv, hv2]
        omega
      · show onePlusI * (onePlusI⁻¹ * z) = z
        rw [mul_inv_cancel_left₀ h0]

theorem pr_le_comp : pr ≤ comp := by
  intro z hz
  rcases (mem_pr_iff z).1 hz with rfl | h
  · exact zero_mem _
  · exact (mem_comp_iff z).2 (by omega)

/-! ## The unit tetrahedron -/

/-- `h = ½(1 + i + j + k)`. -/
def hur : ℍ[ℚ] := ⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩

/-- `h′ = ½(1 + i + j − k)`. -/
def hur' : ℍ[ℚ] := ⟨1 / 2, 1 / 2, 1 / 2, -1 / 2⟩

/-- **The unit tetrahedron** `(0, 1, h, h′)`: one point in each class of `comp/P`. -/
def tetra : Fin 4 → ℍ[ℚ] := ![0, 1, hur, hur']

/-- Its six edges have length one. -/
theorem sqDist_tetra {i j : Fin 4} (hij : i ≠ j) : sqDist (tetra i) (tetra j) = 1 := by
  fin_cases i <;> fin_cases j <;>
    first
    | exact absurd rfl hij
    | norm_num [sqDist, tetra, hur, hur', normSq_def']

/-- A quaternion `B/m` with `m` odd and `Σ Bᵢ` even lies in `P` (`one_le_val_div_odd`, `0` apart). -/
private theorem mem_pr_of_div_odd {m : ℕ} (hm : Odd m) {a b c d : ℤ} (h : 2 ∣ a + b + c + d) {q : ℍ[ℚ]}
    (hq : q = ⟨a / m, b / m, c / m, d / m⟩) : q ∈ pr := by
  rw [mem_pr_iff, hq]
  by_cases h0 : (a, b, c, d) = (0, 0, 0, 0)
  · left
    simp only [Prod.mk.injEq] at h0
    obtain ⟨rfl, rfl, rfl, rfl⟩ := h0
    ext <;> simp
  · exact Or.inr ((one_le_val_div_odd hm h0).2 h)

/-- The coordinate identity every residue case reads: `x/(2m) − s/2 = y/m` when `x = 2y + s·m`. -/
private theorem div_two_mul_sub_eq {m : ℕ} (hm : (m : ℚ) ≠ 0) {x y : ℤ} (s : ℤ) (h : x = 2 * y + s * m) :
    (x : ℚ) / (2 * m) - s / 2 = y / m := by
  have h' : (x : ℚ) = 2 * y + s * m := by exact_mod_cast h
  rw [h']
  field_simp
  ring

/-- **The four residue classes** (LX L2): each point of the component is congruent modulo `P` to exactly one vertex of the
tetrahedron. -/
theorem existsUnique_tetra_sub_mem_pr {z : ℍ[ℚ]} (hz : z ∈ comp) : ∃! i : Fin 4, z - tetra i ∈ pr := by
  -- uniqueness: two vertices of the tetrahedron differ by a unit vector, which is not in `P`
  have huniq : ∀ i j : Fin 4, z - tetra i ∈ pr → z - tetra j ∈ pr → i = j := by
    intro i j hi hj
    by_contra hij
    have hd : tetra j - tetra i ∈ pr := by
      have := sub_mem hi hj
      rwa [sub_sub_sub_cancel_left] at this
    have h1 : normSq (tetra j - tetra i) = 1 := sqDist_tetra (Ne.symm hij)
    rcases (mem_pr_iff _).1 hd with h | h
    · rw [h, map_zero] at h1
      norm_num at h1
    · rw [val, h1, padicValRat.one] at h
      norm_num at h
  -- existence: the normal form, and the parity of the coordinate sum after subtracting a vertex
  obtain ⟨m, a, b, c, d, hm, hb, hc, hd, hzeq⟩ := (zero_le_val_iff z).1 ((mem_comp_iff z).1 hz)
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.pos.ne'
  unfold Int.ModEq at hb hc hd
  have hmo : (m : ℤ) % 2 = 1 := by have := Nat.odd_iff.1 hm; omega
  suffices key : ∃ i : Fin 4, z - tetra i ∈ pr by
    obtain ⟨i, hi⟩ := key
    exact ⟨i, hi, fun j hj => huniq j i hj hi⟩
  rcases Int.emod_two_eq_zero_or_one a with ha | ha
  · -- all even: the vertex `0` or `1`
    by_cases hs : 2 ∣ a / 2 + b / 2 + c / 2 + d / 2
    · refine ⟨0, mem_pr_of_div_odd hm hs ?_⟩
      ext <;> simp only [hzeq, tetra, Matrix.cons_val_zero, sub_zero]
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : a = 2 * (a / 2) + 0 * m)
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : b = 2 * (b / 2) + 0 * m)
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : c = 2 * (c / 2) + 0 * m)
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : d = 2 * (d / 2) + 0 * m)
    · refine ⟨1, mem_pr_of_div_odd hm (a := a / 2 - m) (b := b / 2) (c := c / 2) (d := d / 2) (by omega) ?_⟩
      ext <;> simp only [hzeq, tetra, Matrix.cons_val_one, Matrix.cons_val_zero, re_sub, imI_sub, imJ_sub, imK_sub,
        re_one, imI_one, imJ_one, imK_one, sub_zero]
      · have := div_two_mul_sub_eq hm0 0 (by omega : a = 2 * (a / 2) + 0 * m)
        push_cast at this ⊢
        rw [sub_div, ← this]
        field_simp
        ring
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : b = 2 * (b / 2) + 0 * m)
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : c = 2 * (c / 2) + 0 * m)
      · simpa using div_two_mul_sub_eq hm0 0 (by omega : d = 2 * (d / 2) + 0 * m)
  · -- all odd: the vertex `h` or `h′`
    by_cases hs : 2 ∣ (a - m) / 2 + (b - m) / 2 + (c - m) / 2 + (d - m) / 2
    · refine ⟨2, mem_pr_of_div_odd hm hs ?_⟩
      ext <;> simp only [hzeq, tetra, hur, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons, re_sub,
        imI_sub, imJ_sub, imK_sub]
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : a = 2 * ((a - m) / 2) + 1 * m)
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : b = 2 * ((b - m) / 2) + 1 * m)
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : c = 2 * ((c - m) / 2) + 1 * m)
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : d = 2 * ((d - m) / 2) + 1 * m)
    · refine ⟨3, mem_pr_of_div_odd hm (a := (a - m) / 2) (b := (b - m) / 2) (c := (c - m) / 2) (d := (d + m) / 2)
        (by omega) ?_⟩
      ext <;> simp only [hzeq, tetra, hur', Matrix.cons_val_three, Matrix.tail_cons, Matrix.head_cons, re_sub,
        imI_sub, imJ_sub, imK_sub]
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : a = 2 * ((a - m) / 2) + 1 * m)
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : b = 2 * ((b - m) / 2) + 1 * m)
      · simpa using div_two_mul_sub_eq hm0 1 (by omega : c = 2 * ((c - m) / 2) + 1 * m)
      · have := div_two_mul_sub_eq hm0 (-1) (by omega : d = 2 * ((d + m) / 2) + (-1) * m)
        push_cast at this ⊢
        rw [← this]

/-! ## Spec -/

example : tetra 2 = hur := rfl

example : (⟨1 / 3, 2 / 3, 2 / 3, 0⟩ : ℍ[ℚ]) ∈ unitSphere := by
  show normSq _ = 1
  rw [normSq_def']
  norm_num

example : onePlusI ∈ comp := by
  have : onePlusI = ⟨1, 0, 0, 0⟩ + ⟨0, 1, 0, 0⟩ := by ext <;> norm_num [onePlusI]
  rw [this]
  exact add_mem (unitSphere_subset_comp (by show normSq _ = 1; rw [normSq_def']; norm_num))
    (unitSphere_subset_comp (by show normSq _ = 1; rw [normSq_def']; norm_num))

end HadwigerNelson.RationalFour
