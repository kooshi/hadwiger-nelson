import Mathlib.NumberTheory.SumFourSquares
import Proofs.HadwigerNelson.RationalFour.Basic

/-!
# The component of the origin and its residue classes (FS-131, FS131-KFS1; skeleton)

The component of the origin in the unit-distance graph on `ℚ⁴` is the additive group the rational unit vectors generate,
`comp = ⟨S⟩`. It is described by one valuation: `z ∈ comp ↔ 0 ≤ v₂(|z|²)` (`mem_comp_iff`) — `[BendaPerles2000]`
pp. 123–125's `H⁴` (their types (a) and (b), p. 124), proved here as in the consolidation run's job LX (L1, L3): a normal
form `z = (a, b, c, d)/(2m)`, `m` odd, `a ≡ b ≡ c ≡ d (mod 2)` (`zero_le_val_iff`), and the ring route to `1/m ∈ ⟨S⟩`
(`inv_odd_mem_comp`: `1/p` from the trace of the unit `q²/p`, `|q|² = p`).

Inside it, `pr = (1 + i)·comp` is the set `z = 0 ∨ 1 ≤ v₂(|z|²)` (`mem_pr_iff`), of index 4: the **unit tetrahedron**
`tetra = (0, 1, h, h′)` (`h = ½(1+i+j+k)`, `h′ = ½(1+i+j−k)`), whose six differences are unit vectors, meets each class of
`comp/pr` exactly once (`existsUnique_tetra_sub_mem_pr`). That is the whole residue structure `comp/pr ≅ 𝔽₄` the colouring
argument needs; no map to `𝔽₄` is built.

**Not claimed:** that `comp` is a ring, or a maximal order (both true; neither is used).
-/

namespace HadwigerNelson.RationalFour

open Quaternion

/-! ## The component of the origin -/

/-- **The component of the origin**: the additive group generated by the rational unit vectors. Two points of `ℚ⁴` are joined
by a path of unit steps iff their difference lies in it. -/
def comp : AddSubgroup ℍ[ℚ] := AddSubgroup.closure unitSphere

theorem unitSphere_subset_comp : unitSphere ⊆ comp := AddSubgroup.subset_closure

/-- **The normal form of a quaternion of 2-integral squared length** (LX L1): `v₂(|z|²) ≥ 0` iff `2m·z` has integer
coordinates of one parity for some odd `m`. -/
theorem zero_le_val_iff (z : ℍ[ℚ]) :
    0 ≤ val z ↔ ∃ (m : ℕ) (a b c d : ℤ), Odd m ∧ a ≡ b [ZMOD 2] ∧ a ≡ c [ZMOD 2] ∧ a ≡ d [ZMOD 2] ∧
      z = ⟨a / (2 * m), b / (2 * m), c / (2 * m), d / (2 * m)⟩ := by
  sorry

/-- **The ultrametric step** (LX L1): two quaternions of 2-integral squared length sum to one (the normal form: odd denominators
multiply, parities add). -/
theorem zero_le_val_add {x y : ℍ[ℚ]} (hx : 0 ≤ val x) (hy : 0 ≤ val y) : 0 ≤ val (x + y) := by
  sorry

theorem zero_le_val_neg {x : ℍ[ℚ]} (hx : 0 ≤ val x) : 0 ≤ val (-x) := by
  rwa [val, normSq_neg]

/-- **The quaternions of 2-integral squared length**, `{z | v₂(|z|²) ≥ 0}`, as an additive group (`H ⊗ ℤ₍₂₎`). Auxiliary:
`mem_comp_iff` shows it is `comp`. -/
def ord : AddSubgroup ℍ[ℚ] where
  carrier := {z | 0 ≤ val z}
  add_mem' := zero_le_val_add
  zero_mem' := by simp [val]
  neg_mem' := zero_le_val_neg

/-- **The parity reading of `P`** (the statement every residue case reads): for an integer quadruple `B ≠ 0` over an odd
`m`, `v₂(|B/m|²) ≥ 1` iff `Σ Bᵢ` is even (`B² ≡ B (mod 2)`). -/
theorem one_le_val_div_odd {m : ℕ} (hm : Odd m) {a b c d : ℤ} (h0 : (a, b, c, d) ≠ (0, 0, 0, 0)) :
    1 ≤ val ⟨a / m, b / m, c / m, d / m⟩ ↔ 2 ∣ a + b + c + d := by
  sorry

/-- The component is closed under multiplication (`S · S ⊆ S`). -/
theorem mul_mem_comp {x y : ℍ[ℚ]} (hx : x ∈ comp) (hy : y ∈ comp) : x * y ∈ comp := by
  sorry

/-- **`1/p` for an odd prime** (LX L3): with `|q|² = p` (Lagrange) and `q`'s real part `a ≠ 0`, `u = q²/p` is a unit vector
and `u + ū = 4a²/p − 2`; `gcd(4a², p) = 1` finishes. -/
theorem inv_prime_mem_comp {p : ℕ} (hp : p.Prime) (h2 : p ≠ 2) : ((p : ℚ)⁻¹ : ℍ[ℚ]) ∈ comp := by
  sorry

/-- `1/m` for every odd `m` (`Nat.recOnMul` over `inv_prime_mem_comp` and `mul_mem_comp`). -/
theorem inv_odd_mem_comp {m : ℕ} (hm : Odd m) : ((m : ℚ)⁻¹ : ℍ[ℚ]) ∈ comp := by
  sorry

/-- **The component of the origin, described** (`[BendaPerles2000]` pp. 123–125; LX L1 and L3). -/
theorem mem_comp_iff (z : ℍ[ℚ]) : z ∈ comp ↔ 0 ≤ val z := by
  sorry

/-! ## The ideal `(1 + i)·comp` -/

/-- **`P = (1 + i)·comp`**, the points at even squared distance inside the component. -/
def pr : AddSubgroup ℍ[ℚ] := comp.map (AddMonoidHom.mulLeft onePlusI)

/-- `z ∈ P` iff `z = 0` or `v₂(|z|²) ≥ 1` (`(1 + i)⁻¹ z` has `v₂ = v₂(|z|²) − 1`). -/
theorem mem_pr_iff (z : ℍ[ℚ]) : z ∈ pr ↔ z = 0 ∨ 1 ≤ val z := by
  sorry

theorem pr_le_comp : pr ≤ comp := by
  sorry

/-! ## The unit tetrahedron -/

/-- `h = ½(1 + i + j + k)`. -/
def hur : ℍ[ℚ] := ⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩

/-- `h′ = ½(1 + i + j − k)`. -/
def hur' : ℍ[ℚ] := ⟨1 / 2, 1 / 2, 1 / 2, -1 / 2⟩

/-- **The unit tetrahedron** `(0, 1, h, h′)`: one point in each class of `comp/P`. -/
def tetra : Fin 4 → ℍ[ℚ] := ![0, 1, hur, hur']

/-- Its six edges have length one. -/
theorem sqDist_tetra {i j : Fin 4} (hij : i ≠ j) : sqDist (tetra i) (tetra j) = 1 := by
  sorry

/-- **The four residue classes** (LX L2): each point of the component is congruent modulo `P` to exactly one vertex of the
tetrahedron. -/
theorem existsUnique_tetra_sub_mem_pr {z : ℍ[ℚ]} (hz : z ∈ comp) : ∃! i : Fin 4, z - tetra i ∈ pr := by
  sorry

/-! ## Spec -/

example : tetra 2 = hur := rfl

example : (⟨1 / 3, 2 / 3, 2 / 3, 0⟩ : ℍ[ℚ]) ∈ unitSphere := by
  show normSq _ = 1
  rw [normSq_def']
  norm_num

example : onePlusI ∈ comp := by
  sorry

end HadwigerNelson.RationalFour
