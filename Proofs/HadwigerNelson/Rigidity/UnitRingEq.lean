import Proofs.HadwigerNelson.Rigidity.CountResidue
import Proofs.HadwigerNelson.Rigidity.NormOneGen

/-!
# Lemma C′: the unit-vector ring is the ring integral at the stable primes (FS-131, job FS131-KRU1; skeleton)

Plan: `plans/FS131-KRU1-ring-plan.md` § 3 (module 2). `LEDGER.md` row 100's Lemma C′ (FS91-J07-4 = J10-T6; [hand], three
derivations); `ROADMAP.md` § 3 item 2.

**Read aloud, against the informal claim.** `F ⊆ ℝ` is a real number field and `L = F(i)` (`fieldI F`). `R` is the subring
of `L` generated by the elements of norm one — the unit vectors of `F²` read in `L` —, `UnitRing.unitRing (conjOn …)`.
`O′ = stableIntegers F` is the ring of elements of `L` integral at every conjugation-fixed prime of `𝓞 L`. A stable prime is
*ramified* when conjugation acts trivially on its residue field (`IsRamified`); only dyadic ones can be, and the scope
`NoRamifiedStableDyadic F` says none is.

* `unitRing_eq_stableIntegers` — **Lemma C′, as typed in the roadmap**: with no ramified stable prime, `R = O′`.
* `exists_two_pow_mul_mem_unitRing` — **the odd part, every real number field, no scope** (FS91-J07-4 at every odd `p`):
  every `x ∈ O′` has `2^a·x ∈ R` for some `a`; `R` and `O′` agree once `2` is inverted.
* `exists_sub_div_mem_stableIntegers` — the common step: for `n ≠ 0` such that no stable prime holding `n` is ramified, every
  `x ∈ O′` is `r + n·y` with `r ∈ R`, `y ∈ O′` (the surjection `R → O′/nO′`, J07-4's isomorphism's onto half).
* `resPi_surjective` — **the residues of `R` fill the product** `∏_{P ∈ Φ} 𝓞 L ⧸ P^m` at every finite set `Φ` of unramified
  stable primes, every `m`: the held joint lift of norm-one residues (`Counting.exists_normOneL_residues`, Hilbert 90 and the
  Chinese remainder theorem) and the generation of a finite ring by its norm-one elements (`closure_normOne_eq_top`,
  `Rigidity/NormOneGen`), applied in the product ring at once.

**Held, read here:** `unitRing_le_stableIntegers` (`R ⊆ O′`), `exists_mul_stableIntegers_le` (`c·O′ ⊆ R`),
`Counting.exists_normOneL_residues`, `Counting.resR`, `Counting.normOneQ`, `UpperHalf.residue_*`, `UpperHalf.isUnit_mk_pow`.

**Not claimed:** `R = O′` at a field with a ramified stable prime — false at `ℚ(√5)`, `ℚ(√17)`, true at `ℚ(√2)` (row 100;
FS91-J10-T6's scope data), so the scope is not necessary and no `iff` is stated; Lemma C (`R ⊗ ℤ_p`); the injectivity half of
`R/nR ≅ O′/nO′`.

**Models.** `NoRamifiedStableDyadic` holds at `ℚ(√47)`, which has no stable dyadic prime, and a stable prime exists there, so
`O′ ≠ L` and the head statement is not the trivial `L = L` (`Instances/UnitRingModels`). The hypotheses `¬ IsRamified P` of
the local leaves hold at the prime `(3)` of `ℚ(i)` (same module).
-/

namespace HadwigerNelson.Rigidity

open SpectralChain NumberField Counting

noncomputable section

variable {F : Subfield ℝ} [NumberField F]

/-- **The joint residue map of `R` at a finite set of stable primes**, at the exponent `m`. -/
def resPi (Φ : Finset (StablePrime F)) (m : ℕ) : unitRing F →+* ∀ P : Φ, 𝓞 (fieldI F) ⧸ P.1.P ^ m :=
  RingHom.pi fun P => resR P.1 m

/-- **The residue of an unramified stable prime's mover is a mover**: for `t` with `t̄ − t ∉ P`, the residue `θ` of `t` in
`𝓞 L ⧸ P^m` has `θ − θ̄` a unit, and `a + θ` is a unit for every residue `a` fixed by conjugation (else `a + t ∈ P` and
`a + t̄ ∈ P`, so `t − t̄ ∈ P`). -/
theorem isUnit_mover (P : StablePrime F) (m : ℕ) {t : 𝓞 (fieldI F)} (ht : conjO F t - t ∉ P.P) :
    IsUnit (Ideal.Quotient.mk (P.P ^ m) t -
        Ideal.quotientMap (P.P ^ m) (conjO F) (P.le_comap m) (Ideal.Quotient.mk (P.P ^ m) t)) ∧
      ∀ a : 𝓞 (fieldI F) ⧸ P.P ^ m, Ideal.quotientMap (P.P ^ m) (conjO F) (P.le_comap m) a = a →
        IsUnit (a + Ideal.Quotient.mk (P.P ^ m) t) := by
  sorry

/-- **The residues of `R` fill the product** at a finite set of unramified stable primes, at every exponent. -/
theorem resPi_surjective (Φ : Finset (StablePrime F)) (hΦ : ∀ P ∈ Φ, ¬ IsRamified P) (m : ℕ) :
    Function.Surjective (resPi Φ m) := by
  sorry

/-- **Division by a natural number in `𝓞_P`**: at the exponent `m = |𝓞 L ⧸ (n)|` no stable prime's `m`-th power holds `n`,
so an element of `𝓞_P` whose residue at `P^m` is zero is `n` times an element of `𝓞_P` (the valuation-ring dichotomy; the
step inside `Counting.exists_mem_nsmul_of_resR_eq_zero`). -/
theorem div_natCast_mem_localRing (P : StablePrime F) {n : ℕ} (hn : n ≠ 0) {x : fieldI F} (hx : x ∈ P.localRing)
    (h0 : P.residue (Ideal.absNorm (Ideal.span {(n : 𝓞 (fieldI F))})) ⟨x, hx⟩ = 0) :
    x / (n : fieldI F) ∈ P.localRing := by
  sorry

/-- **`R` maps onto `O′/nO′`** wherever no stable prime holding `n` is ramified: every `x ∈ O′` is `r + n·y`, `r ∈ R`,
`y ∈ O′`. -/
theorem exists_sub_div_mem_stableIntegers {n : ℕ} (hn : n ≠ 0)
    (hram : ∀ P : StablePrime F, (n : 𝓞 (fieldI F)) ∈ P.P → ¬ IsRamified P) {x : fieldI F}
    (hx : x ∈ stableIntegers F) :
    ∃ r ∈ UnitRing.unitRing (conjOn (fieldI_conj F)), (x - r) / (n : fieldI F) ∈ stableIntegers F := by
  sorry

/-- **Lemma C′** (FS91-J07-4 = J10-T6; `LEDGER.md` row 100): for a real number field with no ramified stable dyadic prime,
the ring generated by the unit vectors is the ring of elements of `F(i)` integral at every stable prime. -/
theorem unitRing_eq_stableIntegers (h : NoRamifiedStableDyadic F) :
    UnitRing.unitRing (conjOn (fieldI_conj F)) = stableIntegers F := by
  sorry

/-- An odd natural number lies in no ramified stable prime: a ramified stable prime holds `2` (`IsRamified.isDyadic`), and
`2` and an odd `n` generate the unit ideal of `ℤ`. -/
theorem not_isRamified_of_odd_mem (P : StablePrime F) {n : ℕ} (hodd : Odd n) (hn : (n : 𝓞 (fieldI F)) ∈ P.P) :
    ¬ IsRamified P := by
  sorry

/-- **Lemma C′ away from 2, every real number field, no scope** (FS91-J07-4 at every odd prime): every element integral at
every stable prime is in the unit-vector ring after multiplication by a power of `2`. -/
theorem exists_two_pow_mul_mem_unitRing {x : fieldI F} (hx : x ∈ stableIntegers F) :
    ∃ a : ℕ, (2 : fieldI F) ^ a * x ∈ UnitRing.unitRing (conjOn (fieldI_conj F)) := by
  sorry

/-! ## Spec examples -/

example (Φ : Finset (StablePrime F)) (m : ℕ) (r : unitRing F) (P : Φ) : resPi Φ m r P = resR P.1 m r := rfl

end

end HadwigerNelson.Rigidity
