-/

namespace HadwigerNelson.Rigidity

open SpectralChain NumberField

variable (F : Subfield ℝ)

/-- **`O′`**: the elements of `F(i)` integral at every conjugation-stable prime of `𝓞 (F(i))`. -/
noncomputable def stableIntegers [NumberField F] : Subring (fieldI F) := ⨅ P : StablePrime F, P.localRing.toSubring

theorem mem_stableIntegers [NumberField F] {x : fieldI F} : x ∈ stableIntegers F ↔ ∀ P : StablePrime F, x ∈ P.localRing := by
  simp [stableIntegers, Subring.mem_iInf]

/-- **`R ⊆ O′`**, over every real number field (where the stable valuation subrings are defined): a norm-one element lies in every stable valuation subring
(`UpperHalf.mem_localRing_of_mul_conj_eq_one`), and `R` is the ring they generate. -/
theorem unitRing_le_stableIntegers [NumberField F] : UnitRing.unitRing (conjOn (fieldI_conj F)) ≤ stableIntegers F :=
  UnitRing.unitRing_le_iff.mpr fun _ hu =>
    (mem_stableIntegers F).mpr fun P => UpperHalf.mem_localRing_of_mul_conj_eq_one P hu

/-- **`c·O′ ⊆ R`**, over every real number field, no scope (FS91-J10-L1 (e)). Route: (b) `ℚ·R = L` — `i ∈ R`, and for
`a ∈ F`, `u_a = (1 + ia)/(1 − ia)` is of norm one with `ia = (u_a − 1)/(u_a + 1)`, so the `ℚ`-span of `R`, a finite-dimensional
domain, is a field containing `L`; so `R` holds a `ℚ`-basis of `L` and `c₀·𝓞 L ⊆ R` for a common denominator `c₀`. (d)
`𝓞 L[U] = O′`: at a non-stable prime `𝔔` an element `u = a/ā` of norm one with `v_𝔔(u) = −1`; then the overring argument —
`J := {d : d x ∈ D}` for `D = 𝓞 L[U]` and `x ∈ O′`, a maximal `𝔐 ⊇ J` would localize `D` to a DVR at a stable prime.
(e) `O′ = Σ 𝓞 L · U`, so `c₀·O′ ⊆ R`. -/
theorem exists_mul_stableIntegers_le [NumberField F] :
    ∃ c : ℕ, c ≠ 0 ∧ ∀ x ∈ stableIntegers F, (c : fieldI F) * x ∈ UnitRing.unitRing (conjOn (fieldI_conj F)) := by
  sorry

/-- **`R = O′` in the scope** (Lemma C′, FS91-J07-4 = FS91-J10-T6; `LEDGER.md` row 100): for a real number field with no
ramified stable dyadic prime, the unit-vector ring is the ring of elements integral at every stable prime. Route
(FS91-J10's, plan § Stage 3): by `exists_mul_stableIntegers_le`, `R = O′` iff `R` maps onto `O′/cO′`, a finite product of
`O_𝔓/𝔓^m` over the stable `𝔓 ∣ c`; there the image of `U` is the product of the local norm-one images (weak approximation
for the norm-one torus, FS91-J10-L2), and the ring it generates is everything unless some `𝔓` is ramified and dyadic (at a
ramified dyadic level one the norm-one image is `{1}`). -/
theorem unitRing_eq_stableIntegers [NumberField F] (h : NoRamifiedStableDyadic F) :
    UnitRing.unitRing (conjOn (fieldI_conj F)) = stableIntegers F := by
  sorry

/-- **The density of `R`** (J45 N1 (b) at `S = ∅`, read for `L ⊗ ℝ`; EN1 § 8.1 row 3): for every `N ≥ 1` the image of `N·R`
under the canonical embedding of `L = F(i)` into its mixed space is dense. Route (EN1 § 8.2 item 4): `(3 ± 4i)/5 ∈ U`, so
`6/5 ∈ R` and `1/5 = 6/5 − 1 ∈ R`; `R ⊇ c₀·𝓞 L` (`exists_mul_stableIntegers_le`'s step (b)); so `N·R ⊇ N·5^{−k}c₀·𝓞 L` for
every `k`, whose image is the lattice `N 5^{−k} c₀ ·` (the image of `𝓞 L`, a full lattice:
`NumberField.mixedEmbedding.latticeBasis`), and these lattices' union is dense. -/
theorem dense_mixedEmbedding_nsmul_unitRing [NumberField F] (N : ℕ) (hN : N ≠ 0) :
    Dense {y | ∃ r ∈ UnitRing.unitRing (conjOn (fieldI_conj F)),
      y = NumberField.mixedEmbedding (fieldI F) ((N : fieldI F) * r)} := by
  sorry

end HadwigerNelson.Rigidity
