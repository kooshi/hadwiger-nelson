import Proofs.HadwigerNelson.Rigidity.RingScope

/-!
# The continuity group at `S = ∅`: the profinite-plus-archimedean topology on `ℤ[U_F]`, and its continuous characters are `T + A` (FS-131, job FS131-KR1; module M10; skeleton)

**Read aloud, against the informal claim.** J45's `τ′_∅` (`plans/FS84-SI-D-derivation.md` l. 105, at `S = ∅`) is the
topology on `R = ℤ[U_F]` induced by its diagonal map into `R̂_prof × (L ⊗ ℝ)`. Here it is `tauPrime F`, the topology
generated by two induced topologies, with **no profinite completion built**: `profTop F` makes every coset of `(N + 1)·R`
open (each quotient discrete), and `archTop F` is induced by the canonical embedding of `L = F(i)` into its mixed space
(Mathlib's `L ⊗ ℝ`). A basic neighbourhood of `0` is `N·R ∩ B_δ`. The guard `N + 1` is load-bearing: the subgroup `0·R = 0`
would make the topology discrete, and then every character would be continuous.

**The statement J45 N1 (a) at `S = ∅` makes, both inclusions** (EN1 § 3.3): `contChars_tauPrime : contChars (tauPrime F) =
TA F` — the `τ′_∅`-continuous characters are exactly the torsion characters times the archimedean ones. With
`isTopologicalAddGroup_tauPrime`, `isCountablyGenerated_nhds_tauPrime` and `BochnerOn (tauPrime F)` (module M2b,
`Rigidity/BochnerTau`), `SpectralInputs.spectral_carried_iff` reads at `TA F`: this is where M11 gets N2.

**Routes** (`plans/FS131-KR1-chain-map.md` § 2.3). `TA ⊆ contChars`: a torsion character kills `N·R`, so it is constant on
the open cosets; an additive lift `ψ : R → ℝ` is a real combination of `ℚ`-coordinates along a `ℚ`-basis of `L`, each
continuous for the mixed embedding. `contChars ⊆ TA`: `Re χ > 0` on some `N·R ∩ B_δ` makes `χ^N` archimedean-continuous
(no small subgroups), and an archimedean-continuous character of `R` is archimedean (`mem_archChars_of_continuousAt`: lattices
`5^{−k}c₀𝓞_L ⊆ R`, the density of `R`, `Rigidity.dense_mixedEmbedding_nsmul_unitRing`).

**Models.** Every statement is about every real number field; `F = ⊥` is the first, where `R = ℤ[i][1/p : p ≡ 1 (4)]`. `TA F`
is inhabited (`one_mem_TA`), and so is its complement: a character of `ℤ[i]`-type that is `p`-adic at one split prime is
neither torsion nor archimedean (not a declaration here).
-/

namespace HadwigerNelson.Rigidity

open SpectralChain SpectralInputs NumberField

noncomputable section

variable (F : Subfield ℝ)

/-- **The profinite topology on `R`**: every coset of `(N + 1)·R` is open (each quotient `R ⧸ (N + 1)·R` discrete). -/
@[reducible] def profTop : TopologicalSpace (unitRing F) :=
  ⨅ N : ℕ, TopologicalSpace.induced
    (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range) ⊥

/-- **The archimedean topology on `R`**: induced by the canonical embedding of `L = F(i)` into its mixed space. -/
@[reducible] def archTop [NumberField F] : TopologicalSpace (unitRing F) :=
  TopologicalSpace.induced
    (fun r : unitRing F =>
      NumberField.mixedEmbedding (fieldI F) ⟨(r : ℂ), UnitRing.unitRingOver_le_planeOverSubring F r.2⟩)
    inferInstance

/-- **`τ′_∅`**: the topology generated by the profinite and the archimedean ones (their infimum in Mathlib's order). -/
@[reducible] def tauPrime [NumberField F] : TopologicalSpace (unitRing F) := profTop F ⊓ archTop F

/-- `τ′_∅` is a group topology. -/
theorem isTopologicalAddGroup_tauPrime [NumberField F] : @IsTopologicalAddGroup (unitRing F) (tauPrime F) _ := by
  sorry

/-- The neighbourhoods of `0` for `τ′_∅` have a countable basis. -/
theorem isCountablyGenerated_nhds_tauPrime [NumberField F] :
    (@nhds (unitRing F) (tauPrime F) 0).IsCountablyGenerated := by
  sorry

/-- **`T + A ⊆` the `τ′_∅`-continuous characters.** -/
theorem TA_subset_contChars [NumberField F] : TA F ⊆ contChars (tauPrime F) := by
  sorry

/-- **An archimedean-continuous character of `R` is archimedean**: continuity at `0` for `archTop` gives an additive real
lift. -/
theorem mem_archChars_of_continuousAt [NumberField F] (χ : Dual F)
    (h : @ContinuousAt (unitRing F) Circle (archTop F) _ (fun r => χ r) 0) : χ ∈ archChars (unitRing F) := by
  sorry

/-- **No small subgroups**: a `τ′_∅`-continuous character has a non-zero power continuous at `0` for `archTop` (`Re χ > 0` on
some `N·R ∩ B_δ`; then `|arg χ^N(r)| < π/(2k)` on `R ∩ B_{δ/(Nk)}`). -/
theorem archContinuousAt_pow_of_mem_contChars [NumberField F] {χ : Dual F} (h : χ ∈ contChars (tauPrime F)) :
    ∃ N : ℕ, N ≠ 0 ∧ @ContinuousAt (unitRing F) Circle (archTop F) _ (fun r => (χ ^ N) r) 0 := by
  sorry

/-- **The `τ′_∅`-continuous characters `⊆ T + A`**: from `archContinuousAt_pow_of_mem_contChars`,
`mem_archChars_of_continuousAt` and "a character is in `T + A` exactly when a non-zero power is archimedean"
(`ChainAtTA.mem_torsion_mul_arch_iff`, private there — the implementer asks for it to be made public, or restates it). -/
theorem contChars_subset_TA [NumberField F] : contChars (tauPrime F) ⊆ TA F := by
  sorry

/-- **J45 N1 (a) at `S = ∅`**: the characters of `ℤ[U_F]` continuous for the profinite-plus-archimedean topology are exactly
`T + A`. -/
theorem contChars_tauPrime [NumberField F] : contChars (tauPrime F) = TA F :=
  (contChars_subset_TA F).antisymm (TA_subset_contChars F)

end

end HadwigerNelson.Rigidity
