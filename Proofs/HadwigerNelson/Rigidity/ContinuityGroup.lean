import Proofs.HadwigerNelson.Rigidity.RingScope

/-!
# The continuity group at `S = ∅`: the profinite-plus-archimedean topology on `ℤ[U_F]`, and its continuous characters are `T + A` (FS-131, job FS131-KR1; module M10; skeleton)

**Read aloud, against the informal claim.** J45's `τ′_∅` (`plans/FS84-SI-D-derivation.md` l. 105, at `S = ∅`) is the
topology on `R = ℤ[U_F]` induced by its diagonal map into `R̂_prof × (L ⊗ ℝ)`. Here it is `tauPrime F`, the topology
generated by two induced topologies, with **no profinite completion built**: `profTop F` makes every coset of `(N + 1)·R`
open (each quotient discrete), and `archTop F` is induced by the canonical embedding of `L = F(i)` into its mixed space
(Mathlib's `L ⊗ ℝ`). A basic neighbourhood of `0` is `N·R ∩ B_δ`. The guard `N + 1` is load-bearing: the subgroup `0·R = 0`
would make the topology discrete, and then every character would be continuous.

**The statement J45 N1 (a) at `S = ∅` makes, both inclusions** (EN1 § 3.3): `contChars_tauPrime : contChars (tauPrime F) =
TA F` — the `τ′_∅`-continuous characters are exactly the torsion characters times the archimedean ones. With
`isTopologicalAddGroup_tauPrime`, `isCountablyGenerated_nhds_tauPrime` and `BochnerOn (tauPrime F)` (module M2b,
`Rigidity/BochnerTau`), `SpectralInputs.spectral_carried_iff` reads at `TA F`: this is where M11 gets N2.

**Routes** (`plans/FS131-KR1-chain-map.md` § 2.3). `TA ⊆ contChars`: a torsion character kills `N·R`, so it is constant on
the open cosets; an additive lift `ψ : R → ℝ` is a real combination of `ℚ`-coordinates along a `ℚ`-basis of `L`, each
continuous for the mixed embedding. `contChars ⊆ TA`: `Re χ > 0` on some `N·R ∩ B_δ` makes `χ^N` archimedean-continuous
(no small subgroups), and an archimedean-continuous character of `R` is archimedean (`mem_archChars_of_continuousAt`: lattices
`5^{−k}c₀𝓞_L ⊆ R`, the density of `R`, `Rigidity.dense_mixedEmbedding_nsmul_unitRing`).

**Models.** Every statement is about every real number field; `F = ⊥` is the first, where `R = ℤ[i][1/p : p ≡ 1 (4)]`. `TA F`
is inhabited (`one_mem_TA`), and so is its complement: a character of `ℤ[i]`-type that is `p`-adic at one split prime is
neither torsion nor archimedean (not a declaration here).
-/

namespace HadwigerNelson.Rigidity

open SpectralChain SpectralInputs NumberField

noncomputable section

variable (F : Subfield ℝ)

/-- **The profinite topology on `R`**: every coset of `(N + 1)·R` is open (each quotient `R ⧸ (N + 1)·R` discrete). -/
@[reducible] def profTop : TopologicalSpace (unitRing F) :=
  ⨅ N : ℕ, TopologicalSpace.induced
    (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range) ⊥

/-- **The archimedean topology on `R`**: induced by the canonical embedding of `L = F(i)` into its mixed space. -/
-- `[NumberField F]` is not read by the value at the pin; it is kept, since dropping it moves the stored types of `archTop`, `tauPrime` and every statement over them (FS-131 inventory item 863, ruling 1)
@[reducible, nolint unusedArguments] def archTop [NumberField F] : TopologicalSpace (unitRing F) :=
  TopologicalSpace.induced
    (fun r : unitRing F =>
      NumberField.mixedEmbedding (fieldI F) ⟨(r : ℂ), UnitRing.unitRingOver_le_planeOverSubring F r.2⟩)
    inferInstance

/-- **`τ′_∅`**: the topology generated by the profinite and the archimedean ones (their infimum in Mathlib's order). -/
@[reducible] def tauPrime [NumberField F] : TopologicalSpace (unitRing F) := profTop F ⊓ archTop F

/-! ### Private helpers: the archimedean size, small arguments, the profinite neighbourhoods -/

/-- The map of `archTop`, as an additive map: `archTop F` is induced by it (`archTop_eq`). -/
def archHom [NumberField F] : unitRing F →+ NumberField.mixedEmbedding.mixedSpace (fieldI F) where
  toFun r := NumberField.mixedEmbedding (fieldI F) ⟨(r : ℂ), UnitRing.unitRingOver_le_planeOverSubring F r.2⟩
  map_zero' := by
    rw [← map_zero (NumberField.mixedEmbedding (fieldI F))]
    rfl
  map_add' r s := by
    rw [← map_add]
    rfl

theorem archTop_eq [NumberField F] : archTop F = TopologicalSpace.induced (archHom F) inferInstance := rfl

private theorem tendsto_archHom [NumberField F] (y : unitRing F) :
    Filter.Tendsto (archHom F) (@nhds _ (archTop F) y) (nhds (archHom F y)) := by
  rw [archTop_eq, nhds_induced]
  exact Filter.tendsto_comap

-- the norm of the mixed space needs the decidability of the real places (`Fintype` of a subtype): classical here
open scoped Classical in
theorem eventually_archTop [NumberField F] {p : unitRing F → Prop} :
    (∀ᶠ r in @nhds _ (archTop F) 0, p r) ↔ ∃ δ > 0, ∀ r, ‖archHom F r‖ < δ → p r := by
  rw [archTop_eq, nhds_induced, map_zero, (Metric.nhds_basis_ball.comap _).eventually_iff]
  simp only [Set.mem_preimage, Metric.mem_ball, dist_zero_right]

open scoped Classical in
theorem norm_archHom_nsmul [NumberField F] (n : ℕ) (x : unitRing F) :
    ‖archHom F (n • x)‖ = n * ‖archHom F x‖ := by
  rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℝ, norm_smul, Real.norm_natCast]

/-- Two small arguments add: `arg (z w) = arg z + arg w` when both lie in `(−π/2, π/2)`. -/
private theorem arg_mul_of_abs_lt {z w : Circle} (hz : |Complex.arg z| < Real.pi / 2)
    (hw : |Complex.arg w| < Real.pi / 2) : Complex.arg ((z * w : Circle) : ℂ) = Complex.arg z + Complex.arg w := by
  have h : z * w = Circle.exp (Complex.arg z + Complex.arg w) := by
    rw [Circle.exp_add, Circle.exp_arg, Circle.exp_arg]
  have hz' := abs_lt.mp hz
  have hw' := abs_lt.mp hw
  rw [h, Circle.arg_exp (by linarith) (by linarith)]

/-- **Small arguments are additive along multiples**: if `|arg χ| < π/2` wherever the size is below `δ`, then
`arg χ(n x) = n · arg χ(x)` whenever `n · size x < δ`. -/
private theorem arg_nsmul_of_small {G : Type*} [AddCommGroup G] (χ : AddChar G Circle) (ν : G → ℝ)
    (hν0 : ∀ x, 0 ≤ ν x) (hνn : ∀ (n : ℕ) (x : G), ν (n • x) = n * ν x) {δ : ℝ}
    (hδ : ∀ y, ν y < δ → |Complex.arg (χ y)| < Real.pi / 2) :
    ∀ (n : ℕ) (x : G), n * ν x < δ → Complex.arg (χ (n • x)) = n * Complex.arg (χ x) := by
  intro n
  induction n with
  | zero => intro x _; simp
  | succ n ih =>
    intro x hx
    have hx0 := hν0 x
    push_cast at hx
    have hn0 : (0 : ℝ) ≤ n * ν x := mul_nonneg (Nat.cast_nonneg n) hx0
    have h1 : (n : ℝ) * ν x < δ := by linarith
    have h2 : ν x < δ := by linarith
    rw [succ_nsmul, AddChar.map_add_eq_mul, arg_mul_of_abs_lt (hδ _ (by rw [hνn]; exact h1)) (hδ _ h2),
      ih x h1]
    push_cast
    ring

/-- The bound that `arg_nsmul_of_small` gives: `|arg χ(x)| < π/(2n)` whenever `n · size x < δ`. -/
private theorem abs_arg_lt_of_small {G : Type*} [AddCommGroup G] (χ : AddChar G Circle) (ν : G → ℝ)
    (hν0 : ∀ x, 0 ≤ ν x) (hνn : ∀ (n : ℕ) (x : G), ν (n • x) = n * ν x) {δ : ℝ}
    (hδ : ∀ y, ν y < δ → |Complex.arg (χ y)| < Real.pi / 2) {n : ℕ} (hn : 0 < n) {x : G}
    (hx : n * ν x < δ) : |Complex.arg (χ x)| < Real.pi / 2 / n := by
  have h := hδ (n • x) (by rw [hνn]; exact hx)
  rw [arg_nsmul_of_small χ ν hν0 hνn hδ n x hx, abs_mul, Nat.abs_cast] at h
  have hn' : (0 : ℝ) < n := Nat.cast_pos.mpr hn
  rw [lt_div_iff₀ hn']
  linarith

/-- `1/5 ∈ R`: `(3 + 4i)/5` and `(3 − 4i)/5` are unit vectors of `F²`, and their sum less `1` is `1/5`. -/
theorem inv_five_mem : ((5 : ℂ)⁻¹) ∈ unitRing F := by
  have h35 : (3 / 5 : ℝ) ∈ F := by
    have := SubfieldClass.ratCast_mem F (3 / 5 : ℚ)
    push_cast at this
    exact this
  have h45 : (4 / 5 : ℝ) ∈ F := by
    have := SubfieldClass.ratCast_mem F (4 / 5 : ℚ)
    push_cast at this
    exact this
  have hu : (⟨3 / 5, 4 / 5⟩ : ℂ) ∈ unitRing F := by
    refine UnitRing.unit_mem_unitRingOver ⟨h35, h45⟩ ?_
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    norm_num
  have hv : (⟨3 / 5, -(4 / 5)⟩ : ℂ) ∈ unitRing F := by
    refine UnitRing.unit_mem_unitRingOver ⟨h35, F.neg_mem h45⟩ ?_
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    norm_num
  have he : ((5 : ℂ)⁻¹) = ⟨3 / 5, 4 / 5⟩ + ⟨3 / 5, -(4 / 5)⟩ - 1 := by
    apply Complex.ext <;> norm_num
  rw [he]
  exact sub_mem (add_mem hu hv) (one_mem _)

/-- `r / 5^k`, an element of `R`. -/
def fivePow (k : ℕ) (r : unitRing F) : unitRing F :=
  ⟨(5 : ℂ)⁻¹ ^ k * r, mul_mem (pow_mem (inv_five_mem F) k) r.2⟩

theorem nsmul_fivePow (k : ℕ) (r : unitRing F) : (5 ^ k) • fivePow F k r = r := by
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_nsmul, nsmul_eq_mul]
  simp only [fivePow, Nat.cast_pow, Nat.cast_ofNat]
  rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ (by norm_num), one_pow, one_mul]

private theorem fivePow_succ (k : ℕ) (r : unitRing F) : fivePow F k r = 5 • fivePow F (k + 1) r := by
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_nsmul, nsmul_eq_mul]
  simp only [fivePow, Nat.cast_ofNat, pow_succ]
  ring

private theorem fivePow_add (k : ℕ) (r s : unitRing F) :
    fivePow F k (r + s) = fivePow F k r + fivePow F k s := by
  apply Subtype.ext
  simp only [fivePow, Subring.coe_add]
  ring

/-- **The profinite neighbourhoods of `0` hold a subgroup `M·R`.** -/
theorem exists_nsmul_mem_of_mem_nhds_profTop {A : Set (unitRing F)} (hA : A ∈ @nhds _ (profTop F) 0) :
    ∃ M : ℕ, M ≠ 0 ∧ ∀ y : unitRing F, M • y ∈ A := by
  have hA' : A ∈ ⨅ N : ℕ, @nhds _ (TopologicalSpace.induced
      (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range) ⊥) 0 := by
    have hn : @nhds _ (profTop F) 0 = ⨅ N : ℕ, @nhds _ (TopologicalSpace.induced
        (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range) ⊥) 0 := nhds_iInf
    rw [← hn]
    exact hA
  refine Filter.iInf_sets_induct hA' ⟨1, one_ne_zero, fun _ => Set.mem_univ _⟩ ?_
  rintro N s₁ s₂ hs₁ ⟨M, hM, hM₂⟩
  rw [@nhds_induced _ _ ⊥, @nhds_discrete _ ⊥ (discreteTopology_bot _)] at hs₁
  obtain ⟨t, ht, hts⟩ := Filter.mem_comap.1 hs₁
  refine ⟨(N + 1) * M, mul_ne_zero N.succ_ne_zero hM, fun y => ⟨hts ?_, ?_⟩⟩
  · show QuotientAddGroup.mk' _ (((N + 1) * M) • y) ∈ t
    have h0 : QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range (((N + 1) * M) • y) =
        QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range 0 := by
      rw [map_zero, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
      exact ⟨M • y, by rw [nsmulAddMonoidHom_apply, smul_smul]⟩
    rw [h0]
    exact Filter.mem_pure.1 ht
  · rw [mul_comm, ← smul_smul]
    exact hM₂ _

/-- A coset of `(N + 1)·R` is a profinite neighbourhood of its points. -/
private theorem mem_nhds_profTop (N : ℕ) (y : unitRing F) :
    {x | ∃ z : unitRing F, y = x + (N + 1) • z} ∈ @nhds _ (profTop F) y := by
  have : {x | QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range x =
      QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range y} ∈ @nhds _ (profTop F) y := by
    have hn : @nhds _ (profTop F) y = ⨅ N : ℕ, @nhds _ (TopologicalSpace.induced
        (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range) ⊥) y := nhds_iInf
    rw [hn]
    refine Filter.mem_iInf_of_mem N ?_
    rw [@nhds_induced _ _ ⊥, @nhds_discrete _ ⊥ (discreteTopology_bot _)]
    exact Filter.mem_comap.2 ⟨{QuotientAddGroup.mk' _ y}, Filter.mem_pure.2 rfl, fun x hx => hx⟩
  refine Filter.mem_of_superset this fun x hx => ?_
  have hx' : QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range x =
      QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range y := hx
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq] at hx'
  obtain ⟨z, hz⟩ := hx'
  refine ⟨z, ?_⟩
  rw [nsmulAddMonoidHom_apply] at hz
  rw [hz]
  abel

/-- The integers of `L` have a common multiple in `R`: `c·𝓞_L ⊆ R` (`𝓞_L ⊆ O′` and `c·O′ ⊆ R`). -/
private theorem exists_nat_mul_integers_mem [NumberField F] : ∃ c : ℕ, c ≠ 0 ∧ ∀ a : 𝓞 (fieldI F),
    (c : fieldI F) * (a : fieldI F) ∈ UnitRing.unitRing (conjOn (fieldI_conj F)) := by
  obtain ⟨c, hc, hcO⟩ := exists_mul_stableIntegers_le F
  refine ⟨c, hc, fun a => hcO _ ((mem_stableIntegers F).2 fun P => (UpperHalf.mem_localRing P).2
    ⟨a, 1, fun h => P.isMaximal.ne_top ((Ideal.eq_top_iff_one _).2 h), by simp⟩)⟩

/-- **Every additive map `R → ℝ` is continuous for `archTop`**: it is a real combination of the coordinates of the mixed
embedding in the lattice basis (an integral basis of `L`, which `c·𝓞_L ⊆ R` puts in `R` up to `c`). -/
private theorem tendsto_archTop_addMonoidHom [NumberField F] (ψ : unitRing F →+ ℝ) (y : unitRing F) :
    Filter.Tendsto ψ (@nhds _ (archTop F) y) (nhds (ψ y)) := by
  classical
  let b := RingOfIntegers.basis (fieldI F)
  let B := NumberField.mixedEmbedding.latticeBasis (fieldI F)
  obtain ⟨c, hc, hcR⟩ := exists_nat_mul_integers_mem F
  let e : Module.Free.ChooseBasisIndex ℤ (𝓞 (fieldI F)) → unitRing F := fun i =>
    ⟨(((c : fieldI F) * (b i : fieldI F) : fieldI F) : ℂ), (UnitRing.coe_mem_unitRingOver_iff _).2 (hcR (b i))⟩
  let tt : Module.Free.ChooseBasisIndex ℤ (𝓞 (fieldI F)) → ℝ := fun i => ψ (e i) / c
  let g : NumberField.mixedEmbedding.mixedSpace (fieldI F) → ℝ := fun v => ∑ i, B.repr v i * tt i
  have hg : Continuous g :=
    continuous_finsetSum _ fun i _ => (LinearMap.continuous_of_finiteDimensional (B.coord i)).mul continuous_const
  let Φ : unitRing F →+ ℝ :=
    { toFun := fun r => g (archHom F r)
      map_zero' := by simp [g]
      map_add' := fun r s => by simp [g, map_add, add_mul, Finset.sum_add_distrib] }
  -- `Φ` agrees with `ψ` on the `e i`
  have hΦe : ∀ i, Φ (e i) = ψ (e i) := by
    intro i
    have hae : archHom F (e i) = c • B i := by
      show NumberField.mixedEmbedding (fieldI F) ((c : fieldI F) * (b i : fieldI F)) = _
      rw [map_mul, map_natCast, NumberField.mixedEmbedding.latticeBasis_apply, integralBasis_apply, ← nsmul_eq_mul]
    show ∑ j, B.repr (archHom F (e i)) j * tt j = ψ (e i)
    rw [hae, map_nsmul, B.repr_self]
    simp only [Finsupp.smul_apply, Finsupp.single_apply, nsmul_eq_mul, mul_ite, mul_one, mul_zero, ite_mul,
      zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    simp only [tt]
    field_simp
  -- every `r` has a non-zero multiple in the subgroup the `e i` generate
  have hψΦ : ∀ r, ψ r = Φ r := by
    intro r
    obtain ⟨y, hy0, hyint⟩ := exists_integral_multiples ℤ ℚ
      ({(⟨(r : ℂ), UnitRing.unitRingOver_le_planeOverSubring F r.2⟩ : fieldI F)} : Finset (fieldI F))
    let X : 𝓞 (fieldI F) := ⟨_, hyint _ (Finset.mem_singleton_self _)⟩
    have hr : ((c : ℤ) * y) • r = ∑ i, b.repr X i • e i := by
      apply Subtype.ext
      have hX := congrArg (fun z : 𝓞 (fieldI F) => (((z : fieldI F)) : ℂ)) (b.sum_repr X)
      simp only [map_sum, map_zsmul] at hX
      simp only [AddSubgroupClass.coe_zsmul, AddSubmonoidClass.coe_finsetSum, e]
      have hXc : (((X : fieldI F)) : ℂ) = (y : ℂ) * (r : ℂ) := by
        show ((y • (⟨(r : ℂ), UnitRing.unitRingOver_le_planeOverSubring F r.2⟩ : fieldI F) : fieldI F) : ℂ) = _
        rw [zsmul_eq_mul]
        push_cast
        rfl
      rw [hXc] at hX
      have key : ∑ x, ((b.repr X x : ℤ) : ℂ) * (((b x : 𝓞 (fieldI F)) : fieldI F) : ℂ) = (y : ℂ) * (r : ℂ) := by
        rw [← hX]
        push_cast [zsmul_eq_mul]
        try rfl
      simp only [zsmul_eq_mul]
      push_cast
      rw [mul_assoc, ← key, Finset.mul_sum]
      exact Finset.sum_congr rfl fun x _ => by ring
    have h1 : ((c : ℤ) * y) • ψ r = ((c : ℤ) * y) • Φ r := by
      rw [← map_zsmul, ← map_zsmul, hr, map_sum, map_sum]
      simp only [map_zsmul, hΦe]
    have hcy : ((c : ℤ) * y : ℤ) ≠ 0 := mul_ne_zero (by exact_mod_cast hc) hy0
    rw [zsmul_eq_mul, zsmul_eq_mul] at h1
    exact mul_left_cancel₀ (Int.cast_ne_zero.2 hcy) h1
  have : (ψ : unitRing F → ℝ) = fun r => g (archHom F r) := funext hψΦ
  rw [this]
  exact (hg.tendsto _).comp (tendsto_archHom F y)

/-- `τ′_∅` is a group topology. -/
theorem isTopologicalAddGroup_tauPrime [NumberField F] : @IsTopologicalAddGroup (unitRing F) (tauPrime F) _ := by
  refine topologicalAddGroup_inf (G := unitRing F) (t₁ := profTop F) (t₂ := archTop F)
    (topologicalAddGroup_iInf (G := unitRing F) fun N => ?_) ?_
  · exact @topologicalAddGroup_induced (unitRing F ⧸ (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range)
      (unitRing F) ⊥ _
      (@topologicalAddGroup_of_discreteTopology _ ⊥ _ (discreteTopology_bot _)) _ _ _ _
      (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range)
  · rw [archTop_eq]
    exact topologicalAddGroup_induced (archHom F)

/-- The neighbourhoods of `0` for `τ′_∅` have a countable basis. -/
theorem isCountablyGenerated_nhds_tauPrime [NumberField F] :
    (@nhds (unitRing F) (tauPrime F) 0).IsCountablyGenerated := by
  have hn : @nhds (unitRing F) (tauPrime F) 0 = @nhds _ (profTop F) 0 ⊓ @nhds _ (archTop F) 0 :=
    nhds_inf (t₁ := profTop F) (t₂ := archTop F)
  rw [hn]
  have h1 : (@nhds (unitRing F) (profTop F) 0).IsCountablyGenerated := by
    have hn' : @nhds _ (profTop F) 0 = ⨅ N : ℕ, @nhds _ (TopologicalSpace.induced
        (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range) ⊥) 0 := nhds_iInf
    rw [hn']
    refine @Filter.iInf.isCountablyGenerated _ _ _ _ fun N => ?_
    rw [@nhds_induced _ _ ⊥, @nhds_discrete _ ⊥ (discreteTopology_bot _)]
    haveI := Filter.isCountablyGenerated_pure
      (QuotientAddGroup.mk' (nsmulAddMonoidHom (α := unitRing F) (N + 1)).range 0)
    infer_instance
  have h2 : (@nhds (unitRing F) (archTop F) 0).IsCountablyGenerated := by
    rw [archTop_eq, nhds_induced]
    infer_instance
  infer_instance

/-- **`T + A ⊆` the `τ′_∅`-continuous characters.** -/
theorem TA_subset_contChars [NumberField F] : TA F ⊆ contChars (tauPrime F) := by
  rintro χ hχ
  obtain ⟨t, ⟨N, hN, ht⟩, a, ⟨ψ, hψ⟩, rfl⟩ := Set.mem_mul.mp hχ
  refine (@continuous_iff_continuousAt _ _ (tauPrime F) _ _).2 fun y => ?_
  -- the torsion factor is constant on the cosets of `N·R`
  have hT : Filter.Tendsto (fun y => t y) (@nhds _ (tauPrime F) y) (nhds (t y)) := by
    obtain ⟨N', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hN
    have hev : ∀ᶠ x in @nhds _ (profTop F) y, t x = t y := by
      filter_upwards [mem_nhds_profTop F N' y] with x hx
      obtain ⟨z, hz⟩ := hx
      rw [hz, AddChar.map_add_eq_mul, AddChar.map_nsmul_eq_pow, ← AddChar.pow_apply, ht, AddChar.one_apply,
        mul_one]
    exact tendsto_nhds_of_eventually_eq
      (Filter.Eventually.filter_mono (nhds_mono (inf_le_left : tauPrime F ≤ profTop F)) hev)
  -- the archimedean factor is `exp ∘ ψ`, and `ψ` is `archTop`-continuous
  have hA : Filter.Tendsto (fun y => a y) (@nhds _ (tauPrime F) y) (nhds (a y)) := by
    have hfun : (fun y => a y) = fun y => Circle.exp (ψ y) := funext hψ
    rw [hfun, hψ]
    exact (((map_continuous Circle.exp).tendsto _).comp (tendsto_archTop_addMonoidHom F ψ y)).mono_left
      (nhds_mono (inf_le_right : tauPrime F ≤ archTop F))
  exact hT.mul hA

/-- **An archimedean-continuous character of `R` is archimedean**: continuity at `0` for `archTop` gives an additive real
lift. -/
theorem mem_archChars_of_continuousAt [NumberField F] (χ : Dual F)
    (h : @ContinuousAt (unitRing F) Circle (archTop F) _ (fun r => χ r) 0) : χ ∈ archChars (unitRing F) := by
  classical
  have hopen : IsOpen {z : Circle | 0 < (z : ℂ).re} :=
    isOpen_lt continuous_const (Complex.continuous_re.comp continuous_subtype_val)
  have h1 : (fun r => χ r) 0 ∈ {z : Circle | 0 < (z : ℂ).re} := by simp
  obtain ⟨δ, hδ0, hδ⟩ := (eventually_archTop F (p := fun r => 0 < ((χ r : Circle) : ℂ).re)).1
    (h (hopen.mem_nhds h1))
  set ν : unitRing F → ℝ := fun r => ‖archHom F r‖ with hνdef
  have hν0 : ∀ x, 0 ≤ ν x := fun _ => norm_nonneg _
  have hνn : ∀ (n : ℕ) (x : unitRing F), ν (n • x) = n * ν x := norm_archHom_nsmul F
  have harg : ∀ y, ν y < δ → |Complex.arg (χ y)| < Real.pi / 2 := fun y hy =>
    Complex.abs_arg_lt_pi_div_two_iff.2 (Or.inl (hδ y hy))
  -- the sizes at the scales `5^{−k}`
  have hD : ∀ k r, ν r = 5 ^ k * ν (fivePow F k r) := fun k r => by
    conv_lhs => rw [← nsmul_fivePow F k r]
    rw [hνn]
    push_cast
    ring
  have hstep : ∀ k r, ν (fivePow F k r) = 5 * ν (fivePow F (k + 1) r) := fun k r => by
    conv_lhs => rw [fivePow_succ F k r]
    rw [hνn]
    push_cast
    ring
  have hgood : ∀ r, ∃ k, 5 * ν (fivePow F k r) < δ := by
    intro r
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (5 * ν r / δ) (by norm_num : (1 : ℝ) < 5)
    refine ⟨k, ?_⟩
    have h5 : (0 : ℝ) < 5 ^ k := by positivity
    rw [div_lt_iff₀ hδ0, hD k r] at hk
    nlinarith [hν0 (fivePow F k r)]
  have hgood_succ : ∀ k r, 5 * ν (fivePow F k r) < δ → 5 * ν (fivePow F (k + 1) r) < δ := by
    intro k r hk
    have := hstep k r
    nlinarith [hν0 (fivePow F (k + 1) r)]
  -- the value at scale `k` and its stability
  let V : ℕ → unitRing F → ℝ := fun k r => 5 ^ k * Complex.arg (χ (fivePow F k r))
  have hVsucc : ∀ k r, 5 * ν (fivePow F k r) < δ → V (k + 1) r = V k r := by
    intro k r hk
    have h5 : ((5 : ℕ) : ℝ) * ν (fivePow F (k + 1) r) < δ := by
      have := hstep k r
      push_cast
      nlinarith [hν0 (fivePow F k r)]
    show 5 ^ (k + 1) * Complex.arg (χ (fivePow F (k + 1) r)) = 5 ^ k * Complex.arg (χ (fivePow F k r))
    rw [fivePow_succ F k r, arg_nsmul_of_small χ ν hν0 hνn harg 5 _ h5]
    push_cast
    ring
  have hVge : ∀ k r, 5 * ν (fivePow F k r) < δ → ∀ m, k ≤ m → V m r = V k r := by
    intro k r hk m hm
    induction m, hm using Nat.le_induction with
    | base => rfl
    | succ m hkm ih =>
      have hm' : 5 * ν (fivePow F m r) < δ := by
        clear ih
        induction m, hkm using Nat.le_induction with
        | base => exact hk
        | succ m _ ih' => exact hgood_succ m r ih'
      rw [hVsucc m r hm', ih]
  have hgood_ge : ∀ k r, 5 * ν (fivePow F k r) < δ → ∀ m, k ≤ m → 5 * ν (fivePow F m r) < δ := by
    intro k r hk m hm
    induction m, hm using Nat.le_induction with
    | base => exact hk
    | succ m _ ih => exact hgood_succ m r ih
  let K : unitRing F → ℕ := fun r => Classical.choose (hgood r)
  have hK : ∀ r, 5 * ν (fivePow F (K r) r) < δ := fun r => Classical.choose_spec (hgood r)
  let ψ : unitRing F → ℝ := fun r => V (K r) r
  have hψ : ∀ r m, K r ≤ m → V m r = ψ r := fun r m hm => hVge _ r (hK r) m hm
  have hsmall : ∀ r m, K r ≤ m → |Complex.arg (χ (fivePow F m r))| < Real.pi / 2 := by
    intro r m hm
    have := hgood_ge _ r (hK r) m hm
    exact harg _ (by nlinarith [hν0 (fivePow F m r)])
  have hadd : ∀ r s, ψ (r + s) = ψ r + ψ s := by
    intro r s
    set m := max (K r) (max (K s) (K (r + s)))
    have hr : K r ≤ m := le_max_left _ _
    have hs : K s ≤ m := (le_max_left _ _).trans (le_max_right _ _)
    have hrs : K (r + s) ≤ m := (le_max_right _ _).trans (le_max_right _ _)
    rw [← hψ r m hr, ← hψ s m hs, ← hψ (r + s) m hrs]
    show 5 ^ m * Complex.arg (χ (fivePow F m (r + s))) =
      5 ^ m * Complex.arg (χ (fivePow F m r)) + 5 ^ m * Complex.arg (χ (fivePow F m s))
    rw [fivePow_add, AddChar.map_add_eq_mul, arg_mul_of_abs_lt (hsmall r m hr) (hsmall s m hs)]
    ring
  refine ⟨AddMonoidHom.mk' ψ hadd, fun r => ?_⟩
  show χ r = Circle.exp (V (K r) r)
  conv_lhs => rw [← nsmul_fivePow F (K r) r]
  rw [AddChar.map_nsmul_eq_pow]
  conv_lhs => rw [← Circle.exp_arg (χ (fivePow F (K r) r))]
  rw [← Circle.exp_natCast_mul]
  push_cast
  rfl

/-- **No small subgroups**: a `τ′_∅`-continuous character has a non-zero power continuous at `0` for `archTop` (`Re χ > 0` on
some `N·R ∩ B_δ`; then `|arg χ^N(r)| < π/(2k)` on `R ∩ B_{δ/(Nk)}`). -/
theorem archContinuousAt_pow_of_mem_contChars [NumberField F] {χ : Dual F} (h : χ ∈ contChars (tauPrime F)) :
    ∃ N : ℕ, N ≠ 0 ∧ @ContinuousAt (unitRing F) Circle (archTop F) _ (fun r => (χ ^ N) r) 0 := by
  classical
  have hc : @Continuous _ _ (tauPrime F) _ (fun y : unitRing F => χ y) := h
  have hopen : IsOpen {z : Circle | 0 < (z : ℂ).re} :=
    isOpen_lt continuous_const (Complex.continuous_re.comp continuous_subtype_val)
  have h1 : (fun y : unitRing F => χ y) 0 ∈ {z : Circle | 0 < (z : ℂ).re} := by simp
  have hmem : (fun y : unitRing F => χ y) ⁻¹' {z : Circle | 0 < (z : ℂ).re} ∈ @nhds _ (tauPrime F) 0 :=
    (@Continuous.continuousAt _ _ (tauPrime F) _ _ _ hc) (hopen.mem_nhds h1)
  have hn : @nhds (unitRing F) (tauPrime F) 0 = @nhds _ (profTop F) 0 ⊓ @nhds _ (archTop F) 0 :=
    nhds_inf (t₁ := profTop F) (t₂ := archTop F)
  rw [hn] at hmem
  obtain ⟨A, hA, B, hB, hAB⟩ := Filter.mem_inf_iff.1 hmem
  obtain ⟨M, hM, hMA⟩ := exists_nsmul_mem_of_mem_nhds_profTop F hA
  obtain ⟨δ, hδ0, hδ⟩ := (eventually_archTop F (p := fun r => r ∈ B)).1 hB
  refine ⟨M, hM, ?_⟩
  set ν : unitRing F → ℝ := fun r => ‖archHom F r‖ with hνdef
  have hν0 : ∀ x, 0 ≤ ν x := fun _ => norm_nonneg _
  have hνn : ∀ (n : ℕ) (x : unitRing F), ν (n • x) = n * ν x := norm_archHom_nsmul F
  have hM0 : (0 : ℝ) < M := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hM)
  have harg : ∀ y, ν y < δ / M → |Complex.arg ((χ ^ M) y)| < Real.pi / 2 := by
    intro y hy
    have hyB : M • y ∈ B := hδ _ (by
      show ν (M • y) < δ
      rw [hνn]
      rw [lt_div_iff₀ hM0] at hy
      linarith)
    have hy' : M • y ∈ (fun y : unitRing F => χ y) ⁻¹' {z : Circle | 0 < (z : ℂ).re} := hAB ▸ ⟨hMA y, hyB⟩
    rw [AddChar.pow_apply, ← AddChar.map_nsmul_eq_pow]
    exact Complex.abs_arg_lt_pi_div_two_iff.2 (Or.inl hy')
  have hlim : Filter.Tendsto (fun r => Complex.arg (((χ ^ M) r : Circle) : ℂ)) (@nhds _ (archTop F) 0)
      (nhds 0) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨n, hn⟩ := exists_nat_gt (Real.pi / 2 / ε)
    have hpi : 0 < Real.pi / 2 / ε := by positivity
    have hn0 : 0 < n := by exact_mod_cast hpi.trans hn
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn0
    refine (eventually_archTop F).2 ⟨δ / M / n, by positivity, fun r hr => ?_⟩
    rw [Real.dist_eq, sub_zero]
    have hr' : (n : ℝ) * ν r < δ / M := by
      rw [lt_div_iff₀ hn'] at hr
      linarith
    calc |Complex.arg (((χ ^ M) r : Circle) : ℂ)| < Real.pi / 2 / n :=
          abs_arg_lt_of_small (χ ^ M) ν hν0 hνn harg hn0 hr'
      _ < ε := by
          rw [div_lt_iff₀ hn']
          rw [div_lt_iff₀ hε] at hn
          linarith
  have hfun : (fun r => (χ ^ M) r) = fun r => Circle.exp (Complex.arg (((χ ^ M) r : Circle) : ℂ)) :=
    funext fun r => (Circle.exp_arg _).symm
  show Filter.Tendsto (fun r => (χ ^ M) r) (@nhds _ (archTop F) 0) (nhds ((χ ^ M) 0))
  rw [AddChar.map_zero_eq_one, hfun]
  have h2 := ((map_continuous Circle.exp).tendsto 0).comp hlim
  rw [Circle.exp_zero] at h2
  exact h2

/-- **The `τ′_∅`-continuous characters `⊆ T + A`**: from `archContinuousAt_pow_of_mem_contChars`,
`mem_archChars_of_continuousAt` and "a character is in `T + A` exactly when a non-zero power is archimedean"
(`ChainAtTA.mem_torsion_mul_arch_iff`, private there — the implementer asks for it to be made public, or restates it). -/
theorem contChars_subset_TA [NumberField F] : contChars (tauPrime F) ⊆ TA F := by
  intro χ hχ
  obtain ⟨N, hN, hcont⟩ := archContinuousAt_pow_of_mem_contChars F hχ
  exact (mem_torsion_mul_arch_iff χ).2 ⟨N, hN, mem_archChars_of_continuousAt F (χ ^ N) hcont⟩

/-- **J45 N1 (a) at `S = ∅`**: the characters of `ℤ[U_F]` continuous for the profinite-plus-archimedean topology are exactly
`T + A`. -/
theorem contChars_tauPrime [NumberField F] : contChars (tauPrime F) = TA F :=
  (contChars_subset_TA F).antisymm (TA_subset_contChars F)

end

